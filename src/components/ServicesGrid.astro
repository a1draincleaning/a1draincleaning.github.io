---
import { services } from '../data/services';

const featured = services.filter(({ slug }) => [
  'main-drain-cleaning',
  'sewer-line-cleaning',
  'tree-roots-in-sewer-line',
  'basement-floor-drains',
  'kitchen-bathroom-drains',
  'toilet-clogs',
  'laundry-drains',
  'sewer-backup-emergency',
  'hydro-jetting'
].includes(slug));
---

<section id="services" class="bg-slate-100 py-16 sm:py-20">
  <div class="container">
    <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Drain & sewer work</p>
    <h2 class="mt-2 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What A-1 clears</h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">
      Most drain problems start with a simple restriction. The equipment used depends on where the blockage is and what is causing it.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((service, index) => (
        <article class="group relative flex h-full flex-col border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <span class="text-xs font-black uppercase tracking-[0.18em] text-slate-400">0{index + 1}</span>
          <h3 class="mt-3 text-2xl font-black tracking-tight text-slate-950">
            <a href={`/services/${service.slug}/`} class="after:absolute after:inset-0">{service.title}</a>
          </h3>
          <p class="mt-3 flex-1 leading-7 text-slate-600">{service.description}</p>
          <span class="relative mt-5 font-black text-[#b4232b]">Read service details →</span>
        </article>
      ))}
    </div>

    <a href="/services/" class="mt-8 inline-flex rounded-md bg-slate-950 px-6 py-3 font-black text-white hover:bg-slate-800">See all drain & sewer services</a>
  </div>
</section>
