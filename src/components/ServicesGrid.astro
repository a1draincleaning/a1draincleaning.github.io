---
import { services } from '../data/services';
import { featuredServiceSlugs } from '../data/serviceGroups';

const featuredServices = featuredServiceSlugs
  .map((slug) => services.find((service) => service.slug === slug))
  .filter((service): service is (typeof services)[number] => Boolean(service));
---

<section aria-labelledby="services-heading" class="bg-white py-12 sm:py-16">
  <div class="container">
    <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">A-1 Drain Cleaning • Mason City, Iowa</p>
    <h2 id="services-heading" class="mt-2 text-3xl font-black tracking-tight text-[#1A1A68] sm:text-4xl">12 Drain &amp; Sewer Services</h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">From a backed-up basement floor drain to a blocked sewer line, choose the service that matches the problem. Each page explains the symptoms and the work involved.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredServices.map((service, index) => (
        <article class="flex h-full flex-col border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-xs font-black tracking-[0.18em] text-[#b4232b]">{String(index + 1).padStart(2, '0')} / A-1 SERVICE</p>
          <h3 class="mt-3 flex-1 text-xl font-black leading-snug text-[#1A1A68]">{service.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{service.description}</p>
          <a href={`/services/${service.slug}/`} class="mt-5 inline-flex min-h-11 items-center font-black text-[#b4232b] underline decoration-2 underline-offset-4 hover:text-[#8f1b22]">View service details →</a>
        </article>
      ))}
    </div>
  </div>
</section>
