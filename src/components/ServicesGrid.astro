---
import { services } from '../data/services';

const servicePhotos: Record<string, { src: string; alt: string }> = {
  'tree-roots-in-sewer-line': { src: '/images/cartoon-tree-roots-sewer.svg', alt: 'Cartoon cutaway showing tree roots growing into an underground sewer pipe' },
  'basement-floor-drains': { src: '/images/cartoon-floor-drain-backup.svg', alt: 'Cartoon basement floor drain with wastewater backing up' },
  'main-drain-cleaning': { src: '/images/cartoon-main-drain-cleaning.svg', alt: 'Cartoon house drain connected to an underground main drain pipe being cleared' },
  'sewer-line-cleaning': { src: '/images/cartoon-sewer-line-cleaning.svg', alt: 'Cartoon cutaway showing an underground sewer line being cleaned' },
  'kitchen-bathroom-drains': { src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Drain%20Cleaning.jpg', alt: 'Photograph of professional drain cleaning work' },
  'toilet-clogs': { src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Flush%20toilet.jpg', alt: 'Real toilet fixture for toilet clog service' },
  'laundry-drains': { src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Handyman%20heavy%20duty%20drain%20cleaning%20machine.jpg', alt: 'Professional cable drain-cleaning machine used to clear blockages' },
  'washing-machine-basement-flooding': { src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Drain%20box%20and%20grate.jpg', alt: 'Real drain box and grate where backed-up water may collect' },
  'hydro-jetting': { src: '/images/sewer-drain-mason-city-iowa.jpg', alt: 'A-1 Drain Cleaning equipment at a drain and sewer job' },
  'sewer-backup-emergency': { src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Drainage%20into%20grate%2C%20not%20ditch%20%2843601050491%29%20%28cropped%29.jpg', alt: 'Real drainage grate handling surface water' },
  'sewer-backup-into-tub-shower': { src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Pump-action%20drain%20cleaner.jpg', alt: 'Real manual drain-cleaning tool used for small drain blockages' },
  'default': { src: '/images/a1-main-sewer-drain-cleaning-mason-city.webp', alt: 'Drain and sewer cleaning work by A-1 Drain Cleaning' }
};

const featured = services.filter(({ slug }) => [
  'main-drain-cleaning',
  'sewer-line-cleaning',
  'tree-roots-in-sewer-line',
  'basement-floor-drains',
  'kitchen-bathroom-drains',
  'toilet-clogs',
  'laundry-drains',
  'sewer-backup-emergency',
  'sewer-backup-into-tub-shower',
  'hydro-jetting'
].includes(slug));
---

<section id="services" class="bg-slate-100 py-16 sm:py-20">
  <div class="container">
    <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Drain & sewer work</p>
    <h2 class="mt-2 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What A-1 Drain Cleaning clears</h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">
      Most drain problems start with a simple restriction. The equipment used depends on where the blockage is and what is causing it.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((service, index) => (
        <article class="group relative flex h-full flex-col border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <div class="mb-4 h-40 overflow-hidden rounded-sm bg-slate-100">
            <img
              src={(servicePhotos[service.slug] || servicePhotos.default).src}
              alt={(servicePhotos[service.slug] || servicePhotos.default).alt}
              width="640"
              height="420"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
            />
          </div>
          <span class="text-xs font-black uppercase tracking-[0.18em] text-slate-400">0{index + 1}</span>
          <h3 class="mt-3 text-2xl font-black tracking-tight text-slate-950">
            <a href={`/services/${service.slug}/`} class="after:absolute after:inset-0">{service.title}</a>
          </h3>
          <p class="mt-3 flex-1 leading-7 text-slate-600">{service.description}</p>
          <span class="relative mt-5 font-black text-[#b4232b]">Read service details →</span>
        </article>
      ))}
    </div>

    <a href="https://a1draincleaning.github.io/services/" style="display:inline-flex;align-items:center;border-radius:0.375rem;background-color:#1A1A68;color:#ffffff;padding:0.75rem 1.5rem;font-weight:900;text-decoration:none" class="mt-8 hover:bg-slate-800">See all drain &amp; sewer services</a>
  </div>
</section>
