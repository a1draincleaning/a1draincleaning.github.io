---
const imageBySlug: Record<string, string> = {
  'main-drain-cleaning': '/images/a1-main-sewer-drain-cleaning-mason-city.webp',
  'sewer-line-cleaning': '/images/sewer-drain-mason-city-iowa.jpg',
  'tree-roots-in-sewer-line': '/images/tree-root-removal-mason-city-iowa.jpg',
  'sewer-backup-emergency': '/images/iowa-drain-cleaning-a1-drain-cleaning.png',
};

const imageAltBySlug: Record<string, string> = {
  'main-drain-cleaning': 'A-1 Drain Cleaning main sewer drain cleaning in Mason City, Iowa',
  'sewer-line-cleaning': 'A-1 Drain Cleaning sewer line cleaning in Mason City, Iowa',
  'tree-roots-in-sewer-line': 'A-1 Drain Cleaning tree root removal from a sewer line in Mason City, Iowa',
  'sewer-backup-emergency': 'A-1 Drain Cleaning sewer backup emergency service in Iowa',
};

const services = [
  { slug: 'main-drain-cleaning', name: 'Main Drain Cleaning' },
  { slug: 'sewer-line-cleaning', name: 'Sewer Line Cleaning' },
  { slug: 'tree-roots-in-sewer-line', name: 'Tree Roots in Sewer Line' },
  { slug: 'basement-floor-drains', name: 'Basement Floor Drains' },
  { slug: 'kitchen-drains', name: 'Kitchen Drains' },
  { slug: 'bathroom-shower-drains', name: 'Bathroom & Shower Drains' },
  { slug: 'toilet-clogs', name: 'Toilet Clogs' },
  { slug: 'laundry-drains', name: 'Laundry Drains' },
  { slug: 'sewer-backup-emergency', name: 'Sewer Backup Emergency' },
];
---

<section aria-labelledby="services-heading" class="bg-white py-12 sm:py-16">
  <div class="container">
    <h2 id="services-heading" class="text-3xl font-black tracking-tight text-[#1A1A68] sm:text-4xl">Drain &amp; Sewer Services</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a href={`/services/${service.slug}/`} class="block overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          {imageBySlug[service.slug] ? (
            <img
              src={imageBySlug[service.slug]}
              alt={imageAltBySlug[service.slug]}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="block aspect-[4/3] w-full object-cover"
            />
          ) : null}
          <div class="p-5">
            <h3 class="text-xl font-black text-[#1A1A68]">{service.name}</h3>
            <span class="mt-3 inline-block font-black text-[#1A1A68]">View service →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
