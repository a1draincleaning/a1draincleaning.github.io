---
import { services } from '../data/services';

const illustrations: Record<string, string> = {
  'tree-roots-in-sewer-line': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of tree roots entering an underground sewer pipe" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M0 59H160" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4 4"/><path d="M77 34V57" stroke="#8b5e3c" stroke-width="7"/><path d="M77 50L61 63 56 76M77 52L91 63 99 76M69 57L67 70M84 58L83 72" stroke="#8b5e3c" stroke-width="3"/><circle cx="77" cy="22" r="17" fill="#dcebd7" stroke="#46734b" stroke-width="2"/><circle cx="62" cy="28" r="10" fill="#dcebd7" stroke="#46734b" stroke-width="2"/><circle cx="91" cy="28" r="10" fill="#dcebd7" stroke="#46734b" stroke-width="2"/><path d="M8 72H152V84H8z" fill="#dbeafe" stroke="#1A1A68" stroke-width="2"/><path d="M8 72H152" stroke="#1A1A68" stroke-width="5"/><path d="M56 72L62 77 67 72 73 78 80 72 86 78 92 72 99 78" stroke="#8b5e3c" stroke-width="3"/></svg>`,
  'main-drain-cleaning': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of a drain pipe being cleared" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 19V54Q18 69 34 69H142" stroke="#1A1A68" stroke-width="13"/><path d="M18 19V54Q18 69 34 69H142" stroke="#dbeafe" stroke-width="7"/><path d="M28 22L45 39 61 29 77 45 93 35 110 51" stroke="#b4232b" stroke-width="3"/><path d="M105 43l8 8-11 1" stroke="#b4232b" stroke-width="3"/></svg>`,
  'sewer-line-cleaning': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of an underground sewer line" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M10 20H150V70H10z" fill="#f1f5f9" stroke="#94a3b8" stroke-width="2"/><path d="M10 48H150V69H10z" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M30 58h24m12 0h24m12 0h24" stroke="#1A1A68" stroke-width="3"/><path d="M118 38l10 10-10 10" stroke="#b4232b" stroke-width="4"/></svg>`,
  'basement-floor-drains': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of a basement floor drain grate" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="80" cy="49" rx="45" ry="28" fill="#e2e8f0" stroke="#1A1A68" stroke-width="3"/><ellipse cx="80" cy="49" rx="33" ry="19" stroke="#64748b" stroke-width="2"/><path d="M51 42l58 15M51 54l58-15M80 30v38M41 49h78" stroke="#1A1A68" stroke-width="3"/><path d="M22 15c-6 8 6 10 0 18M137 13c-6 8 6 10 0 18" stroke="#b4232b" stroke-width="3"/></svg>`,
  'kitchen-bathroom-drains': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of a sink and drain pipe" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M24 20H136L126 44H34z" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M80 44V57Q80 68 93 68H111" stroke="#1A1A68" stroke-width="5"/><circle cx="80" cy="32" r="5" fill="#b4232b"/><path d="M48 50v18M128 50v18" stroke="#94a3b8" stroke-width="4"/></svg>`,
  'toilet-clogs': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of a toilet connected to a drain" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M48 13H92V39Q92 56 76 56H65Q48 56 48 39z" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M48 23H92" stroke="#1A1A68" stroke-width="3"/><path d="M65 56v13H94" stroke="#1A1A68" stroke-width="5"/><path d="M28 74H135" stroke="#94a3b8" stroke-width="3"/><path d="M109 62l8 8-8 8" stroke="#b4232b" stroke-width="3"/></svg>`,
  'laundry-drains': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of a washing machine draining water" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="37" y="9" width="55" height="70" rx="4" fill="#f1f5f9" stroke="#1A1A68" stroke-width="3"/><circle cx="64" cy="48" r="19" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M92 61h15v-9h14" stroke="#1A1A68" stroke-width="4"/><path d="M121 52v17h25" stroke="#b4232b" stroke-width="3"/><path d="M133 61l7 8-7 8" stroke="#b4232b" stroke-width="3"/></svg>`,
  'washing-machine-basement-flooding': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of laundry water backing up through a floor drain" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M10 66H150" stroke="#64748b" stroke-width="3"/><ellipse cx="80" cy="66" rx="23" ry="10" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M80 58V34m-8 8 8-8 8 8" stroke="#b4232b" stroke-width="4"/><path d="M30 16h26v33H30z" fill="#f1f5f9" stroke="#1A1A68" stroke-width="3"/><circle cx="43" cy="33" r="8" stroke="#1A1A68" stroke-width="2"/></svg>`,
  'hydro-jetting': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of a pressurized water jet cleaning a pipe" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M10 28H150V69H10z" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M18 48H143" stroke="#38bdf8" stroke-width="8"/><path d="M50 48l10-8m-10 8 10 8M82 48l10-8m-10 8 10 8M114 48l10-8m-10 8 10 8" stroke="#1A1A68" stroke-width="3"/></svg>`,
  'sewer-backup-emergency': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of wastewater rising from a drain" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M15 69H145" stroke="#64748b" stroke-width="3"/><ellipse cx="80" cy="69" rx="27" ry="10" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M80 59V22m-11 12 11-12 11 12" stroke="#b4232b" stroke-width="5"/><path d="M45 33c-7 7 7 9 0 16M115 33c-7 7 7 9 0 16" stroke="#38bdf8" stroke-width="3"/></svg>`,
  'sewer-backup-into-tub-shower': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of a bathtub with a drain backup" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M20 36H140L130 66Q128 73 117 73H43Q32 73 30 65z" fill="#dbeafe" stroke="#1A1A68" stroke-width="3"/><path d="M25 36V25Q25 17 34 17H43" stroke="#1A1A68" stroke-width="4"/><circle cx="80" cy="58" r="5" fill="#b4232b"/><path d="M80 50V40m-6 6 6-6 6 6" stroke="#b4232b" stroke-width="3"/></svg>`,
  'default': `<svg viewBox="0 0 160 90" role="img" aria-label="Illustration of drain pipework" class="h-24 w-full" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 17V47Q22 61 37 61H138" stroke="#1A1A68" stroke-width="14"/><path d="M22 17V47Q22 61 37 61H138" stroke="#dbeafe" stroke-width="8"/><path d="M83 46l9 8-9 8" stroke="#b4232b" stroke-width="3"/></svg>`
};

const featured = services.filter(({ slug }) => [
  'main-drain-cleaning',
  'sewer-line-cleaning',
  'tree-roots-in-sewer-line',
  'basement-floor-drains',
  'kitchen-bathroom-drains',
  'toilet-clogs',
  'laundry-drains',
  'sewer-backup-emergency',
  'sewer-backup-into-tub-shower',
  'hydro-jetting'
].includes(slug));
---

<section id="services" class="bg-slate-100 py-16 sm:py-20">
  <div class="container">
    <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Drain & sewer work</p>
    <h2 class="mt-2 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What A-1 Drain Cleaning clears</h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">
      Most drain problems start with a simple restriction. The equipment used depends on where the blockage is and what is causing it.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((service, index) => (
        <article class="group relative flex h-full flex-col border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <div class="mb-2 flex min-h-24 items-center justify-center rounded-sm bg-slate-50 px-3 py-2" set:html={illustrations[service.slug] || illustrations.default}></div>
          <span class="text-xs font-black uppercase tracking-[0.18em] text-slate-400">0{index + 1}</span>
          <h3 class="mt-3 text-2xl font-black tracking-tight text-slate-950">
            <a href={`/services/${service.slug}/`} class="after:absolute after:inset-0">{service.title}</a>
          </h3>
          <p class="mt-3 flex-1 leading-7 text-slate-600">{service.description}</p>
          <span class="relative mt-5 font-black text-[#b4232b]">Read service details →</span>
        </article>
      ))}
    </div>

    <a href="https://a1draincleaning.github.io/services/" style="display:inline-flex;align-items:center;border-radius:0.375rem;background-color:#1A1A68;color:#ffffff;padding:0.75rem 1.5rem;font-weight:900;text-decoration:none" class="mt-8 hover:bg-slate-800">See all drain &amp; sewer services</a>
  </div>
</section>
