---
const services = [
  { slug: 'main-drain-cleaning', name: 'Main Drain Cleaning' },
  { slug: 'sewer-line-cleaning', name: 'Sewer Line Cleaning' },
  { slug: 'sewer-camera-inspection', name: 'Drain & Sewer Camera Inspections' },
  { slug: 'tree-roots-in-sewer-line', name: 'Tree Root Removal and Cutting' },
  { slug: 'hydro-jetting', name: 'Hydro Jetting' },
  { slug: 'basement-floor-drains', name: 'Floor Drain Cleaning' },
  { slug: 'basement-drain-cleaning', name: 'Basement Drain Cleaning' },
  { slug: 'garage-drain-cleaning', name: 'Garage Drain Cleaning' },
  { slug: 'utility-sink-drain-cleaning', name: 'Utility Sink Drain Cleaning' },
  { slug: 'kitchen-drains', name: 'Kitchen Drain Cleaning' },
  { slug: 'bathroom-drain-cleaning', name: 'Bathroom Drain Cleaning' },
  { slug: 'shower-drain-cleaning', name: 'Shower Drain Cleaning' },
  { slug: 'bathtub-drain-cleaning', name: 'Bathtub Drain Cleaning' },
  { slug: 'roof-drains', name: 'Roof Drain Cleaning' },
  { slug: 'storm-drain-cleaning', name: 'Storm Drain Cleaning' },
  { slug: 'yard-drain-cleaning', name: 'Yard Drain Cleaning' },
  { slug: 'laundry-drains', name: 'Laundry/Washing Machine Drain Cleaning' },
  { slug: 'toilet-clogs', name: 'Toilet Unclogging' },
  { slug: 'sewer-backup-emergency', name: 'Sewer Backup Emergency Service' },
];
---

<section aria-labelledby="services-heading" class="bg-white py-12 sm:py-16">
  <div class="container">
    <h2 id="services-heading" class="text-3xl font-black tracking-tight text-[#1A1A68] sm:text-4xl">Drain &amp; Sewer Services</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a href={`/services/${service.slug}/`} class="block overflow-hidden rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <h3 class="text-xl font-black text-[#1A1A68]">{service.name}</h3>
          <span class="mt-3 inline-block font-black text-[#1A1A68]">View service →</span>
        </a>
      ))}
    </div>
  </div>
</section>
