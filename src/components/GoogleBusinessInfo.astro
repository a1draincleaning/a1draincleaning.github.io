---
// GoogleBusinessInfo.astro
// Business information supplied for A-1 Drain Cleaning

const businessData = {
  name: "A-1 Drain Cleaning",
  owner: "Josh Theilen",
  phone: "6415302728",
  phoneFormatted: "(641) 530-2728",
  address: {
    street: "206 29th St SW",
    city: "Mason City",
    state: "IA",
    zip: "50401",
  },
  rating: 4.9,
  reviewCount: 72,
  googleMapsUrl: "https://maps.google.com/maps?cid=7826151039410291134",
  googleMapsEmbedUrl: "https://maps.google.com/maps?q=A-1+Drain+Cleaning,+206+29th+St+SW,+Mason+City,+IA+50401&output=embed",
  googleReviewUrl: "https://search.google.com/local/writereview?placeid=ChIJ1-N4s2sH8YcRvsGa1ucSnGw",
  websiteUri: "https://a1draincleaning.github.io",
  serviceAreas: ["Mason City", "Clear Lake", "Forest City", "Charles City", "North Iowa"],
};

const schemaData = {
  "@context": "https://schema.org",
  "@type": "PlumbingService",
  "@id": `${businessData.websiteUri}#organization`,
  "name": businessData.name,
  "url": businessData.websiteUri,
  "telephone": businessData.phoneFormatted,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": businessData.address.street,
    "addressLocality": businessData.address.city,
    "addressRegion": businessData.address.state,
    "postalCode": businessData.address.zip,
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 43.1247397,
    "longitude": -93.2057169
  },
  "areaServed": businessData.serviceAreas.map(area => ({
    "@type": "City",
    "name": area
  })),
  "founder": {
    "@type": "Person",
    "name": businessData.owner
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": businessData.rating,
    "reviewCount": businessData.reviewCount
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59"
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<section class="w-full bg-slate-50 py-12 text-slate-800" id="google-business">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-5">
        <div>
          <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-serif text-2xl font-bold text-[#1A1A68]">{businessData.name}</h2>
            <a href={businessData.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-md border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-900 hover:bg-amber-100 transition">
              <span class="text-amber-500">★</span>
              <span>{businessData.rating} ({businessData.reviewCount} reviews)</span>
            </a>
          </div>

          <p class="mb-6 text-sm text-slate-600">
            Locally owned and operated by {businessData.owner}. Professional drain cleaning and sewer services across {businessData.serviceAreas.join(", ")}.
          </p>

          <div class="mb-6 space-y-3 text-sm">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-[#D9383A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <strong class="block text-slate-900">Address / Base</strong>
                <span>{businessData.address.street}, {businessData.address.city}, {businessData.address.state} {businessData.address.zip}</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-[#D9383A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h32.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 01-5.516 5.516l-1.13 2.257a1 1 0 01-1.21.502l-4.493-1.498a2 2 0 01-.684-.949V5z"/>
              </svg>
              <div>
                <strong class="block text-slate-900">Phone</strong>
                <a href={`tel:${businessData.phone}`} class="font-semibold text-[#1A1A68] hover:underline">{businessData.phoneFormatted}</a>
              </div>
            </div>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">Core Services</h3>
            <div class="flex flex-wrap gap-1.5 text-xs">
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Main Sewer Line Cleaning</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Hydro Jetting</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Tree Root Removal</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Camera Inspection</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Floor & Basement Drains</span>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${businessData.phone}`} class="flex flex-1 items-center justify-center rounded-lg bg-[#D9383A] px-4 py-3 font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-[#D9383A] focus:ring-offset-2">
            Call {businessData.phoneFormatted}
          </a>
          <a href={businessData.googleReviewUrl} target="_blank" rel="noopener noreferrer" class="flex flex-1 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-3 font-semibold text-[#1A1A68] transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-[#1A1A68] focus:ring-offset-2">
            Leave a Google Review
          </a>
        </div>
      </div>

      <div class="min-h-[360px] overflow-hidden rounded-xl border border-slate-200 shadow-sm lg:col-span-7">
        <iframe
          title="A-1 Drain Cleaning Google Map Location"
          src={businessData.googleMapsEmbedUrl}
          width="100%"
          height="100%"
          style="border:0; min-height: 380px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
