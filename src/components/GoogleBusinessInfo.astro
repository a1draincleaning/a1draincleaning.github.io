---
import { business } from '../data/business';
---

<section class="w-full bg-slate-50 py-12 text-slate-800" id="google-business">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-5">
        <div>
          <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-serif text-2xl font-bold text-[#1A1A68]">{business.name}</h2>
            <a href={business.reviews.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-md border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-900 transition hover:bg-amber-100">
              <span class="text-amber-500" aria-hidden="true">★</span>
              <span>{business.reviews.rating} ({business.reviews.count} reviews)</span>
            </a>
          </div>

          <p class="mb-6 text-sm text-slate-600">
            Locally owned and operated by {business.owner}. Professional drain cleaning and sewer services across {business.serviceAreas.join(', ')}.
          </p>

          <div class="mb-6 space-y-3 text-sm">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-[#D9383A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <strong class="block text-slate-900">Address / Base</strong>
                <span>{business.address.street}, {business.address.city}, {business.address.state} {business.address.postalCode}</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-[#D9383A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21c1.2.4 2.5.62 3.82.62a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4.99a1 1 0 011-1H8.41a1 1 0 011 1c0 1.32.22 2.62.62 3.82a1 1 0 01-.21 1.11l-2.2 2.2z"/>
              </svg>
              <div>
                <strong class="block text-slate-900">Phone</strong>
                <a href={`tel:${business.phone.tel}`} class="font-semibold text-[#1A1A68] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1A1A68]">{business.phone.formatted}</a>
              </div>
            </div>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">Core Services</h3>
            <div class="flex flex-wrap gap-1.5 text-xs">
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Main Sewer Line Cleaning</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Hydro Jetting</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Tree Root Removal</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Camera Inspection</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">Floor & Basement Drains</span>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={`tel:${business.phone.tel}`} class="flex flex-1 items-center justify-center rounded-lg bg-[#D9383A] px-4 py-3 font-semibold text-white transition hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#D9383A]">
            Call {business.phone.formatted}
          </a>
          <a href={business.reviews.googleReviewUrl} target="_blank" rel="noopener noreferrer" class="flex flex-1 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-3 font-semibold text-[#1A1A68] transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1A1A68]">
            Leave a Google Review
          </a>
        </div>
      </div>

      <address class="not-italic rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-7">
        <div class="mb-6 flex justify-center">
          <img
            src="/images/trusted-local-service-iowa.png"
            alt="Trusted local service in Iowa"
            width="742"
            height="720"
            loading="lazy"
            decoding="async"
            class="h-auto w-48 max-w-full"
          />
        </div>
        <p class="text-sm font-black uppercase tracking-[0.18em] text-[#b4232b]">Mason City location</p>
        <h3 class="mt-2 text-2xl font-black text-slate-950">{business.name}</h3>
        <p class="mt-3 text-lg leading-7 text-slate-700">
          {business.address.street}<br />
          {business.address.city}, {business.address.state} {business.address.postalCode}
        </p>
        <p class="mt-5 max-w-xl leading-7 text-slate-600">
          Our shop is in Mason City. We serve Mason City and surrounding North Iowa communities for drain cleaning and sewer service.
        </p>
        <a href={business.reviews.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-lg bg-[#1A1A68] px-5 py-3 font-black text-white transition hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1A1A68]">
          Open location in Google Maps
        </a>
      </address>
    </div>
  </div>
</section>
