---
interface Props {
  phone?: string;
  phoneRaw?: string;
  location?: string;
  businessName?: string;
}

const {
  phone = "641-530-2728",
  phoneRaw = "6415302728",
  location = "Mason City, Iowa",
  businessName = "A-1 Drain Cleaning",
} = Astro.props;
---

<header class="border-b border-gray-200 bg-white">

  <!-- Top service bar -->
  <div class="bg-[#D9383A] text-white">
    <div class="mx-auto flex max-w-7xl items-center justify-center px-4 py-2 text-center text-sm font-bold sm:text-base">
      Drain &amp; Sewer Cleaning • Mason City &amp; North Iowa
    </div>
  </div>

  <!-- Main header -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex min-h-[88px] items-center justify-between gap-4">

      <!-- Logo / Business -->
      <a href="/" class="group flex min-w-0 items-center">
        <div>
          <div
            class="text-4xl font-black leading-none tracking-[-0.06em] text-[#1A1A68] sm:text-5xl"
          >
            A-1
          </div>

          <div class="mt-1 text-xs font-black uppercase tracking-[0.16em] text-[#1A1A68] sm:text-sm">
            Drain Cleaning
          </div>
        </div>
      </a>

      <!-- Location -->
      <div class="hidden text-center lg:block">
        <p class="text-sm font-black uppercase tracking-[0.14em] text-gray-500">
          Local Drain &amp; Sewer Service
        </p>

        <p class="mt-1 text-base font-bold text-[#1A1A68]">
          {location}
        </p>
      </div>

      <!--