---

<section id="services" class="bg-white py-16 md:py-20">
  <div class="container">
    <div class="grid gap-8 md:grid-cols-5">
      <!-- Main Drain Cleaning -->
      <div class="text-center">
        <div class="mx-auto mb-4 h-16 w-16 rounded-full bg-[#0D3B66] p-3">
          <svg class="h-full w-full text-white" fill="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8"/>
            <circle cx="12" cy="12" r="5" fill="white"/>
          </svg>
        </div>
        <h3 class="font-bold uppercase tracking-[0.14em] text-[#0D3B66]">Main Drain Cleaning</h3>
      </div>

      <!-- Sewer Line Cleaning -->
      <div class="text-center">
        <div class="mx-auto mb-4 h-16 w-16 rounded-full bg-[#0D3B66] p-3">
          <svg class="h-full w-full text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 4c0 1.5 1 2.5 3 2.5h6c2 0 3-1 3-2.5M4 12c0-2 1-3 2-3h12c1 0 2 1 2 3v4H4v-4zm0 8h16v2H4v-2z"/>
          </svg>
        </div>
        <h3 class="font-bold uppercase tracking-[0.14em] text-[#0D3B66]">Sewer Line Cleaning</h3>
      </div>

      <!-- Toilet & Drain Service -->
      <div class="text-center">
        <div class="mx-auto mb-4 h-16 w-16 rounded-full bg-[#0D3B66] p-3">
          <svg class="h-full w-full text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 4h12v3H6V4zm1 5h10v10H7V9zm2 2v6h6v-6H9z"/>
          </svg>
        </div>
        <h3 class="font-bold uppercase tracking-[0.14em] text-[#0D3B66]">Toilet & Drain Service</h3>
      </div>

      <!-- Hydro Jetting -->
      <div class="text-center">
        <div class="mx-auto mb-4 h-16 w-16 rounded-full bg-[#0D3B66] p-3">
          <svg class="h-full w-full text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l3 5h-6l3-5zm0 8c2.2 0 4 1.8 4 4s-1.8 4-4 4-4-1.8-4-4 1.8-4 4-4zm7-6h4v4h-4V4zm-14 0h4v4H5V4z"/>
          </svg>
        </div>
        <h3 class="font-bold uppercase tracking-[0.14em] text-[#0D3B66]">Hydro Jetting</h3>
      </div>

      <!-- Residential & Commercial -->
      <div class="text-center">
        <div class="mx-auto mb-4 h-16 w-16 rounded-full bg-[#0D3B66] p-3">
          <svg class="h-full w-full text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
          </svg>
        </div>
        <h3 class="font-bold uppercase tracking-[0.14em] text-[#0D3B66]">Residential & Commercial</h3>
      </div>
    </div>
  </div>
</section>
