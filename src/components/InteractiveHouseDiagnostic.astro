---
// InteractiveHouseDiagnostic.astro
// A-1 Drain Cleaning — Mason City, Iowa
// Static Astro component. No external JavaScript dependencies.
---

<section id="a1-house-diagnostic" aria-labelledby="house-diagnostic-title" class="mx-auto w-full max-w-5xl overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 text-white shadow-2xl">
  <header class="border-b border-slate-800 px-4 py-6 text-center sm:px-6">
    <p class="mb-2 text-xs font-black uppercase tracking-[0.2em] text-amber-400">A-1 Drain Cleaning · Mason City, Iowa</p>
    <h2 id="house-diagnostic-title" class="text-2xl font-black uppercase tracking-tight text-white sm:text-3xl">Where Is Your Drain Backing Up?</h2>
    <p class="mx-auto mt-2 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">Pick the symptom that matches what you are seeing. The diagram shows where the problem may be occurring in your home's drain system.</p>
  </header>

  <section aria-label="Interactive house plumbing diagram" class="bg-slate-900 p-2 sm:p-4">
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#071018]">
      <svg id="house-svg" viewBox="0 0 900 650" role="img" aria-labelledby="house-svg-title house-svg-desc" class="block h-auto w-full">
        <title id="house-svg-title">Cutaway house drain system</title>
        <desc id="house-svg-desc">A two-story house with a basement showing a toilet, kitchen sink, laundry, basement floor drain, vertical drain stack, and main sewer line.</desc>
        <defs>
          <linearGradient id="wallGradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#17212b"/><stop offset="100%" stop-color="#101820"/></linearGradient>
          <linearGradient id="soilGradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#33291f"/><stop offset="100%" stop-color="#1c1713"/></linearGradient>
          <filter id="glowAmber"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          <filter id="glowRed"><feGaussianBlur stdDeviation="6" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          <pattern id="soilPattern" width="45" height="30" patternUnits="userSpaceOnUse"><path d="M4 12c7-4 12 5 20 0s13 2 18-3M12 26c5-3 9 2 16-1" fill="none" stroke="#554536" stroke-width="2" opacity=".45"/></pattern>
        </defs>

        <rect width="900" height="650" fill="#071018"/>
        <rect x="0" y="455" width="900" height="195" fill="url(#soilGradient)"/>
        <rect x="0" y="455" width="900" height="195" fill="url(#soilPattern)"/>
        <line x1="40" y1="455" x2="860" y2="455" stroke="#d08a22" stroke-width="5"/>
        <text x="60" y="485" fill="#9ca3af" font-size="15" font-weight="700" letter-spacing="2">GROUND / SOIL</text>

        <g id="house">
          <path d="M105 170 L450 45 L795 170 Z" fill="#101820" stroke="#64748b" stroke-width="5"/>
          <rect x="145" y="165" width="610" height="290" fill="url(#wallGradient)" stroke="#64748b" stroke-width="5"/>
          <rect x="145" y="455" width="610" height="115" fill="#111820" stroke="#64748b" stroke-width="5"/>
          <line x1="145" y1="305" x2="755" y2="305" stroke="#475569" stroke-width="4"/>
          <line x1="145" y1="455" x2="755" y2="455" stroke="#64748b" stroke-width="5"/>
          <g fill="#94a3b8" font-size="15" font-weight="800" letter-spacing="1.5">
            <text x="170" y="198">2ND FLOOR</text><text x="170" y="222" fill="#cbd5e1">BATHROOM</text>
            <text x="170" y="338">1ST FLOOR</text><text x="170" y="362" fill="#cbd5e1">KITCHEN / LAUNDRY</text>
            <text x="170" y="492">BASEMENT</text><text x="170" y="516" fill="#cbd5e1">FLOOR DRAIN / MAIN LINE</text>
          </g>
          <g><rect x="585" y="205" width="100" height="65" rx="4" fill="#0b1720" stroke="#64748b" stroke-width="4"/><line x1="635" y1="205" x2="635" y2="270" stroke="#64748b" stroke-width="3"/><line x1="585" y1="237" x2="685" y2="237" stroke="#64748b" stroke-width="3"/></g>
          <rect x="210" y="370" width="190" height="18" rx="3" fill="#475569"/>
          <g><rect x="420" y="368" width="62" height="65" rx="5" fill="#d1d5db" stroke="#64748b" stroke-width="3"/><circle cx="451" cy="404" r="18" fill="#1e293b" stroke="#94a3b8" stroke-width="3"/></g>
        </g>

        <g id="pipe-network" fill="none" stroke="#64748b" stroke-width="13" stroke-linecap="round" stroke-linejoin="round">
          <path d="M535 225 L535 520"/><path d="M290 390 L535 390"/><path d="M450 435 L535 435"/><path d="M280 520 L535 520"/><path d="M535 520 C625 520 680 535 850 535"/>
        </g>
        <g fill="none" stroke="#1e293b" stroke-width="5" stroke-linecap="round"><path d="M535 225 L535 520"/><path d="M290 390 L535 390"/><path d="M280 520 L535 520"/><path d="M535 520 C625 520 680 535 850 535"/></g>

        <g id="toilet-fixture"><rect x="500" y="230" width="48" height="42" rx="6" fill="#e5e7eb" stroke="#94a3b8" stroke-width="3"/><ellipse cx="524" cy="272" rx="32" ry="19" fill="#f1f5f9" stroke="#94a3b8" stroke-width="3"/><ellipse cx="524" cy="272" rx="19" ry="8" fill="#bae6fd"/></g>
        <g id="sink-fixture"><rect x="260" y="365" width="62" height="24" rx="3" fill="#e5e7eb" stroke="#94a3b8" stroke-width="3"/><path d="M289 365v-25c0-12 25-12 25 0v7" fill="none" stroke="#cbd5e1" stroke-width="5" stroke-linecap="round"/></g>
        <g id="basement-drain-fixture"><circle cx="280" cy="520" r="27" fill="#1e293b" stroke="#94a3b8" stroke-width="4"/><circle cx="280" cy="520" r="17" fill="none" stroke="#64748b" stroke-width="3"/><path d="M263 512h34M263 520h34M263 528h34" stroke="#64748b" stroke-width="2"/></g>

        <g id="root-system" fill="none" stroke="#78532f" stroke-width="7" stroke-linecap="round"><path d="M650 610 C665 575 660 555 685 535"/><path d="M690 630 C695 585 710 565 720 535"/><path d="M745 610 C740 575 755 560 765 538"/><path d="M805 625 C790 585 795 565 805 538"/></g>

        <g id="anim-toilet" class="diag-overlay" opacity="0" pointer-events="none">
          <path d="M535 275 L535 390" fill="none" stroke="#f59e0b" stroke-width="10" stroke-linecap="round" filter="url(#glowAmber)"/>
          <circle cx="524" cy="272" r="17" fill="#f59e0b" opacity=".8" class="animate-ping"/>
          <path d="M510 255 C520 245 530 245 540 255" fill="none" stroke="#fbbf24" stroke-width="5"/>
          <text x="570" y="260" fill="#fbbf24" font-size="18" font-weight="900">BACKUP HERE</text>
        </g>
        <g id="anim-sink" class="diag-overlay" opacity="0" pointer-events="none">
          <path d="M322 390 L535 390" fill="none" stroke="#f59e0b" stroke-width="10" stroke-linecap="round" filter="url(#glowAmber)"/>
          <circle cx="320" cy="390" r="17" fill="#f59e0b" opacity=".85" class="animate-ping"/>
          <text x="215" y="425" fill="#fbbf24" font-size="17" font-weight="900">SINK LINE BACKUP</text>
        </g>
        <g id="anim-basement" class="diag-overlay" opacity="0" pointer-events="none">
          <path d="M280 520 L535 520" fill="none" stroke="#f59e0b" stroke-width="10" stroke-linecap="round" filter="url(#glowAmber)"/>
          <ellipse cx="280" cy="520" rx="35" ry="13" fill="#f59e0b" opacity=".65" class="animate-pulse"/>
          <circle cx="280" cy="510" r="8" fill="#fbbf24" class="animate-ping"/><circle cx="295" cy="500" r="5" fill="#fbbf24" class="animate-ping"/>
          <text x="190" y="565" fill="#fbbf24" font-size="17" font-weight="900">WATER COMING UP</text>
        </g>
        <g id="anim-main" class="diag-overlay" opacity="0" pointer-events="none">
          <path d="M535 520 C625 520 680 535 850 535" fill="none" stroke="#ef4444" stroke-width="15" stroke-linecap="round" filter="url(#glowRed)"/>
          <circle cx="690" cy="530" r="22" fill="#ef4444" opacity=".85" class="animate-ping"/>
          <path d="M650 610 C665 575 660 555 685 535 M690 630 C695 585 710 565 720 535 M745 610 C740 575 755 560 765 538" fill="none" stroke="#ef4444" stroke-width="8" stroke-linecap="round" filter="url(#glowRed)"/>
          <text x="555" y="495" fill="#f87171" font-size="19" font-weight="900">MAIN LINE TROUBLE</text>
        </g>

        <g fill="#94a3b8"><text x="730" y="565" font-size="14" font-weight="800" letter-spacing="1">TO STREET SEWER</text><path d="M815 520l25 15-25 15" fill="none" stroke="#94a3b8" stroke-width="4"/></g>
      </svg>
    </div>
  </section>

  <section aria-label="Drain backup symptoms" class="border-t border-slate-800 bg-slate-950 p-4 sm:p-6">
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <button type="button" data-target="anim-toilet" class="diag-btn min-h-[64px] rounded-xl border border-slate-700 bg-slate-800 px-3 py-3 text-sm font-bold text-slate-100 transition hover:border-amber-500 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-400 active:scale-[.98]"><span class="block text-xl" aria-hidden="true">🚽</span>Toilet Backup</button>
      <button type="button" data-target="anim-sink" class="diag-btn min-h-[64px] rounded-xl border border-slate-700 bg-slate-800 px-3 py-3 text-sm font-bold text-slate-100 transition hover:border-amber-500 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-400 active:scale-[.98]"><span class="block text-xl" aria-hidden="true">🍽️</span>Kitchen Sink</button>
      <button type="button" data-target="anim-basement" class="diag-btn min-h-[64px] rounded-xl border border-slate-700 bg-slate-800 px-3 py-3 text-sm font-bold text-slate-100 transition hover:border-amber-500 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-400 active:scale-[.98]"><span class="block text-xl" aria-hidden="true">💧</span>Basement Drain</button>
      <button type="button" data-target="anim-main" class="diag-btn min-h-[64px] rounded-xl border border-red-800 bg-red-950/50 px-3 py-3 text-sm font-black text-red-100 transition hover:bg-red-950 focus:outline-none focus:ring-2 focus:ring-red-400 active:scale-[.98]"><span class="block text-xl" aria-hidden="true">⚠️</span>Whole House</button>
    </div>

    <section id="diag-result" aria-live="polite" class="mt-4 rounded-xl border border-slate-800 bg-slate-900 p-5 text-center">
      <p id="diag-text" class="text-sm font-medium leading-6 text-slate-300 sm:text-base">Choose the symptom that matches what is happening in your home.</p>
      <a href="tel:+16415302728" class="mt-4 inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-amber-500 px-6 py-3 text-base font-black uppercase tracking-wide text-slate-950 shadow-lg transition hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-300 focus:ring-offset-2 focus:ring-offset-slate-900 sm:w-auto" aria-label="Call A-1 Drain Cleaning at 641-530-2728">Call A-1: 641-530-2728</a>
      <p class="mt-3 text-xs text-slate-500">A-1 Drain Cleaning · Mason City, Iowa · 24/7 drain service</p>
    </section>
  </section>
</section>

<script>
  const diagnosticRoot = document.querySelector('#a1-house-diagnostic');

  if (diagnosticRoot) {
    const buttons = diagnosticRoot.querySelectorAll<HTMLButtonElement>('.diag-btn');
    const overlays = diagnosticRoot.querySelectorAll<SVGGElement>('.diag-overlay');
    const diagText = diagnosticRoot.querySelector<HTMLElement>('#diag-text');

    const messages: Record<string, string> = {
      'anim-toilet': 'A single toilet that backs up may have a blockage in that fixture or its nearby drain line. If the problem keeps returning, the drain line should be checked.',
      'anim-sink': 'A kitchen sink that drains slowly or backs up can have buildup or a blockage in the kitchen branch drain.',
      'anim-basement': 'Water coming up through a basement floor drain is a warning that wastewater may be having trouble moving through the lower drain system.',
      'anim-main': 'If several fixtures are backing up or wastewater is coming up at multiple drains, the problem may be farther down the main sewer line. That needs attention quickly.'
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        if (!targetId) return;
        overlays.forEach((overlay) => overlay.setAttribute('opacity', '0'));
        const activeOverlay = diagnosticRoot.querySelector<SVGGElement>(`#${targetId}`);
        activeOverlay?.setAttribute('opacity', '1');
        if (diagText && messages[targetId]) diagText.textContent = messages[targetId];
        buttons.forEach((item) => item.classList.remove('border-amber-500', 'bg-amber-950/40', 'border-red-500', 'bg-red-950'));
        if (targetId === 'anim-main') button.classList.add('border-red-500', 'bg-red-950');
        else button.classList.add('border-amber-500', 'bg-amber-950/40');
      });
    });
  }
</script>
