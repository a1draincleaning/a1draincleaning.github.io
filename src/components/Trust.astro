---
---

<section class="bg-gradient-to-r from-[#0D3B66] to-[#1A5490] py-16 md:py-20 text-white">
  <div class="container">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <!-- Left side content -->
      <div>
        <div class="mb-4 flex items-center gap-2">
          <div class="h-1 w-12 bg-[#D9383A]"></div>
          <p class="font-bold uppercase tracking-[0.18em] text-red-300">Over 25 years of experience</p>
        </div>

        <h2 class="text-4xl font-black leading-tight md:text-5xl">
          Trusted Drain Cleaning in Mason City and North Iowa
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-gray-100">
          We're a local, family-owned business, proudly serving Mason City and surrounding communities. From simple clogs to major sewer line issues, we have the tools, experience and know-how to get the job done right.
        </p>

        <a
          href="tel:+16415302728"
          class="phone-pulse mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-[#D9383A] px-6 py-3.5 text-lg font-bold text-white hover:bg-red-700 transition"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773c.236.75.645 1.43 1.196 1.982.55.55 1.231.96 1.98 1.195l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2.57c-6.206 0-11.43-5.224-11.43-11.43V3z" />
          </svg>
          Call 641-530-2728
        </a>
      </div>

      <!-- Right side trust badges -->
      <div class="space-y-6">
        <!-- Reliable & Professional -->
        <div class="flex gap-4">
          <div class="shrink-0">
            <svg class="h-8 w-8 text-[#D9383A]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
            </svg>
          </div>
          <div>
            <p class="font-bold">Reliable & Professional</p>
            <p class="mt-1 text-gray-200">Fast, honest service you can count on.</p>
          </div>
        </div>

        <!-- Local Service -->
        <div class="flex gap-4">
          <div class="shrink-0">
            <svg class="h-8 w-8 text-[#D9383A]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/>
            </svg>
          </div>
          <div>
            <p class="font-bold">Local Service in Mason City & North Iowa</p>
            <p class="mt-1 text-gray-200">We know the area and the problems.</p>
          </div>
        </div>

        <!-- Advanced Equipment -->
        <div class="flex gap-4">
          <div class="shrink-0">
            <svg class="h-8 w-8 text-[#D9383A]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.14 12.94c.4-1.16.74-2.36.74-3.64 0-2.49-1.51-4.67-3.68-5.59.29-1.43-.71-2.71-2.04-2.71h-2.05c-1.33 0-2.33 1.28-2.04 2.71-2.17.92-3.68 3.1-3.68 5.59 0 1.28.34 2.48.74 3.64-3.01.95-5.21 3.76-5.21 7.06 0 4.14 3.36 7.5 7.5 7.5h8.5c4.14 0 7.5-3.36 7.5-7.5 0-3.3-2.2-6.11-5.21-7.06z"/>
            </svg>
          </div>
          <div>
            <p class="font-bold">Advanced Equipment & Proven Methods</p>
            <p class="mt-1 text-gray-200">Modern tools for the job.</p>
          </div>
        </div>

        <!-- Honest Communication -->
        <div class="flex gap-4">
          <div class="shrink-0">
            <svg class="h-8 w-8 text-[#D9383A]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
          </div>
          <div>
            <p class="font-bold">Honest, Upfront Communication</p>
            <p class="mt-1 text-gray-200">We tell you what we find and what it costs.</p>
          </div>
        </div>

        <!-- Tagline -->
        <div class="pt-6 text-xl font-bold italic text-[#D9383A]">
          Your Drains.<br />Our Priority.
        </div>
      </div>
    </div>
  </div>
</section>
