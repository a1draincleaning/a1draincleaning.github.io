---
const symptoms = [
  {
    id: 'slow', number: '01', label: 'Slow draining sink, bath or shower',
    summary: 'A sink, bathtub, or shower is taking too long to empty.',
    cause: 'When one fixture is slow and the others work normally, the restriction is often in that fixture’s branch drain. If several fixtures slow down together, the blockage may be farther down the main drain.',
    action: 'A-1 Drain Cleaning clears household sink, tub, and shower drains. We use the symptoms across the house to help locate whether the problem is local or shared.',
    urgency: 'A single slow fixture can usually be scheduled. If other drains start backing up or wastewater appears, stop using water and call promptly.',
    urgencyLabel: 'Schedule service', href: '/services/kitchen-bathroom-drains/', link: 'Kitchen and bathroom drain service'
  },
  {
    id: 'gurgle', number: '02', label: 'Gurgling from the toilet or drain',
    summary: 'You hear bubbling or gurgling from a toilet, sink, tub, or shower when water runs elsewhere.',
    cause: 'Gurgling can mean air is being pushed or pulled through the drain system because of a partial blockage. When more than one fixture reacts, the restriction may be in a shared drain or main sewer line.',
    action: 'A-1 Drain Cleaning clears main drains and sewer lines. We use which fixtures gurgle and when it happens to narrow down the likely location.',
    urgency: 'Do not ignore gurgling paired with slow drains. If a fixture starts filling with wastewater, stop using water and call now.',
    urgencyLabel: 'Check it promptly', href: '/services/main-drain-cleaning/', link: 'Main drain cleaning'
  },
  {
    id: 'overflow', number: '03', label: 'Overflowing yard drain, floor drain or sewer cleanout',
    summary: 'Water or sewage is spilling from a floor drain, outside drain, or sewer cleanout.',
    cause: 'An overflow at a low opening often means water cannot get through a downstream section of the drain or sewer line. A basement floor drain may be the first place a main-line blockage shows up.',
    action: 'A-1 Drain Cleaning clears floor drains, main drains, and sewer lines. The location of the overflow and which fixtures were running help determine where to start.',
    urgency: 'If sewage is coming into the home, stop using toilets, sinks, showers, and the washer. Keep people and pets away from wastewater and call now.',
    urgencyLabel: 'Call now', href: '/services/basement-floor-drains/', link: 'Basement floor drain service'
  },
  {
    id: 'odor', number: '04', label: 'Bad smell inside or outside',
    summary: 'You notice a sewer or drain odor in the basement, bathroom, near a floor drain, or out in the yard.',
    cause: 'A drain odor can come from a dry trap, a venting issue, or a damaged or obstructed drain or sewer line. The location and timing of the smell matter.',
    action: 'A-1 Drain Cleaning can investigate drain and sewer-line problems, including camera inspection and smoke testing where appropriate, to help locate the source.',
    urgency: 'If the odor is strong or you suspect natural gas, leave the area and contact the appropriate emergency service. For a persistent sewer smell, arrange an inspection.',
    urgencyLabel: 'Arrange an inspection', href: '/services/sewer-camera-inspection/', link: 'Sewer camera inspection'
  },
  {
    id: 'repeat', number: '05', label: 'Blockages that keep coming back',
    summary: 'The same drain or sewer line plugs up again after it has been cleared.',
    cause: 'Recurring blockages can point to tree roots, grease or scale buildup, a damaged pipe, or a section that holds debris. Clearing the blockage may restore flow without correcting the reason it returns.',
    action: 'A-1 Drain Cleaning clears the line and can use a sewer camera and line locating to help identify roots, damage, or other trouble spots.',
    urgency: 'Arrange service before the next full backup. If sewage is backing up into the house now, stop using water and call immediately.',
    urgencyLabel: 'Find the cause', href: '/services/tree-roots-in-sewer-line/', link: 'Tree roots in sewer lines'
  },
  {
    id: 'rats', number: '06', label: 'Rats, or scratching under the floor',
    summary: 'You hear scratching under the floor or suspect rodents are using a damaged drain or sewer line.',
    cause: 'A broken pipe or open connection can provide a route for rodents, but scratching noises alone do not confirm a sewer-line problem.',
    action: 'A-1 Drain Cleaning does not provide pest-control or rodent-exclusion service. If a drain or sewer defect is suspected, we can discuss whether a camera inspection or smoke test is appropriate.',
    urgency: 'Contact a licensed pest-control professional for the rodent issue. If you also have sewer odors, a backup, or a suspected broken drain, arrange a drain inspection.',
    urgencyLabel: 'Pest control may be needed', href: '/services/sewer-camera-inspection/', link: 'Sewer camera inspection'
  },
  {
    id: 'ground', number: '07', label: 'A wet patch or sinking ground outside',
    summary: 'A patch of ground stays wet, smells like sewage, or appears to be sinking near the sewer route.',
    cause: 'A leaking, separated, or damaged underground drain can release water into the soil. Irrigation, surface water, and other plumbing leaks can cause similar signs, so the source needs to be checked.',
    action: 'A-1 Drain Cleaning can inspect accessible sewer lines with a camera, locate the line, and help identify whether a drain defect is present.',
    urgency: 'Keep people and vehicles away from ground that is sinking. Arrange an inspection, and call promptly if the wet area smells like sewage or a backup is also occurring.',
    urgencyLabel: 'Arrange an inspection', href: '/services/sewer-camera-inspection/', link: 'Sewer camera inspection'
  },
  {
    id: 'septic', number: '08', label: 'Septic tank full, or grease trap due',
    summary: 'You think a septic tank needs pumping or a commercial grease trap is due for service.',
    cause: 'A full septic tank and a full grease trap are separate maintenance problems. They are not the same as a blocked household drain or sewer lateral.',
    action: 'A-1 Drain Cleaning does not offer septic-tank pumping or grease-trap servicing. If the issue is a blocked building drain or sewer line, we can help with that portion of the problem.',
    urgency: 'Contact a septic hauler or grease-trap service provider for tank or trap pumping. If wastewater is backing up inside the building, stop using water and call a drain professional.',
    urgencyLabel: 'Different service needed', href: '/services/drain-cleaning/', link: 'A-1 drain cleaning services'
  }
];
const first = symptoms[0];
---
<section class="bg-slate-100 py-14 sm:py-20" aria-labelledby="drain-symptom-heading">
  <div class="container">
    <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Start here</p>
    <h2 id="drain-symptom-heading" class="mt-2 max-w-4xl text-4xl font-black leading-tight tracking-tight text-slate-950 sm:text-5xl">What's your drain doing?</h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">Pick the one closest to what you are seeing. We'll explain the likely cause, what A-1 Drain Cleaning can do, and how quickly you should call.</p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="group" aria-label="Choose the drain symptom">
      {symptoms.map((symptom, index) => (
        <button type="button" class:list={['drain-symptom-choice flex min-h-24 items-start gap-3 border-2 p-4 text-left transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1A1A68]', index === 0 ? 'is-active border-[#1A1A68] bg-[#1A1A68] text-white' : 'border-slate-200 bg-white text-slate-950 hover:border-[#1A1A68]']} data-symptom={symptom.id} data-label={symptom.label} data-summary={symptom.summary} data-cause={symptom.cause} data-action={symptom.action} data-urgency={symptom.urgency} data-urgency-label={symptom.urgencyLabel} data-href={symptom.href} data-link={symptom.link} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="drain-symptom-result">
          <span class="shrink-0 text-xs font-black tracking-[0.15em] opacity-75">{symptom.number}</span>
          <span class="text-base font-black leading-snug">{symptom.label}</span>
        </button>
      ))}
    </div>
    <article id="drain-symptom-result" class="mt-5 border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-live="polite" aria-atomic="true">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p id="drain-symptom-urgency" class="inline-flex min-h-8 items-center bg-[#fff1f2] px-3 py-1 text-sm font-black text-[#9f2028]">{first.urgencyLabel}</p>
        <p class="text-xs font-bold uppercase tracking-[0.15em] text-slate-500">A-1 Drain Cleaning · Mason City, Iowa</p>
      </div>
      <h3 id="drain-symptom-title" class="mt-3 text-2xl font-black leading-tight text-slate-950 sm:text-3xl">{first.label}</h3>
      <p id="drain-symptom-summary" class="mt-2 text-base leading-7 text-slate-700">{first.summary}</p>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <section><h4 class="text-sm font-black uppercase tracking-wide text-slate-950">What may be happening</h4><p id="drain-symptom-cause" class="mt-2 text-sm leading-6 text-slate-700">{first.cause}</p></section>
        <section><h4 class="text-sm font-black uppercase tracking-wide text-slate-950">What A-1 can do</h4><p id="drain-symptom-action" class="mt-2 text-sm leading-6 text-slate-700">{first.action}</p></section>
        <section><h4 class="text-sm font-black uppercase tracking-wide text-slate-950">How urgent is it?</h4><p id="drain-symptom-urgency-detail" class="mt-2 text-sm leading-6 text-slate-700">{first.urgency}</p></section>
      </div>
      <div class="mt-6 flex flex-col gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:items-center sm:justify-between">
        <a id="drain-symptom-service" href={first.href} class="inline-flex min-h-11 items-center font-black text-[#b4232b] underline decoration-2 underline-offset-4">{first.link} →</a>
        <a href="tel:+16415302728" class="inline-flex min-h-12 items-center justify-center rounded-md bg-[#b4232b] px-6 py-3 text-base font-black text-white hover:bg-[#951d24]">CALL 641-530-2728</a>
      </div>
    </article>
    <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-600">These symptoms help narrow down where a problem may be. They do not replace an inspection of the actual drain or sewer line.</p>
  </div>
  <script>
    const symptomButtons = document.querySelectorAll<HTMLButtonElement>('.drain-symptom-choice');
    const urgency = document.getElementById('drain-symptom-urgency') as HTMLElement;
    const title = document.getElementById('drain-symptom-title') as HTMLElement;
    const summary = document.getElementById('drain-symptom-summary') as HTMLElement;
    const cause = document.getElementById('drain-symptom-cause') as HTMLElement;
    const action = document.getElementById('drain-symptom-action') as HTMLElement;
    const urgencyDetail = document.getElementById('drain-symptom-urgency-detail') as HTMLElement;
    const service = document.getElementById('drain-symptom-service') as HTMLAnchorElement;
    symptomButtons.forEach((button) => {
      button.addEventListener('click', () => {
        symptomButtons.forEach((item) => {
          const active = item === button;
          item.setAttribute('aria-pressed', String(active));
          item.classList.toggle('border-[#1A1A68]', active);
          item.classList.toggle('bg-[#1A1A68]', active);
          item.classList.toggle('text-white', active);
          item.classList.toggle('border-slate-200', !active);
          item.classList.toggle('bg-white', !active);
          item.classList.toggle('text-slate-950', !active);
        });
        urgency.textContent = button.dataset.urgencyLabel || '';
        title.textContent = button.dataset.label || '';
        summary.textContent = button.dataset.summary || '';
        cause.textContent = button.dataset.cause || '';
        action.textContent = button.dataset.action || '';
        urgencyDetail.textContent = button.dataset.urgency || '';
        service.href = button.dataset.href || '/services/';
        service.textContent = (button.dataset.link || 'View service') + ' →';
      });
    });
  </script>
</section>
