---
import { problems } from '../data/services';
---

<section id="problems" class="bg-white py-16 sm:py-20">
  <div class="container">
    <div class="max-w-3xl">
      <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Common calls</p>
      <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What is the drain doing?</h2>
      <p class="mt-4 text-lg leading-8 text-slate-600">Tell us what you see. The location of the water and which fixtures are affected can tell a lot about where the restriction is.</p>
    </div>

    <div class="mt-10 grid gap-px overflow-hidden border border-slate-200 bg-slate-200 sm:grid-cols-2 lg:grid-cols-4">
      {problems.map(([name, description]) => (
        <article class="bg-white p-6">
          <h3 class="text-lg font-black text-slate-950">{name}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
