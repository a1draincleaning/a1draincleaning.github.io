---
---

<section id="problems" class="bg-white py-16 sm:py-20">
  <div class="container">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:items-start">
      <div class="max-w-2xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Contact A-1 Drain Cleaning</p>
        <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Tell us what is backing up.</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">Tell us what drain is giving you trouble, where you are located, and what the water is doing. We can use that information to understand the problem before we talk.</p>

        <div class="mt-8 border-l-4 border-[#b4232b] bg-slate-50 p-5">
          <p class="font-black text-slate-950">Need help right now?</p>
          <a href="tel:+16415302728" class="call-button mt-4 inline-block rounded-md bg-[#c52b34] px-6 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL</a>
        </div>
      </div>

      <form class="border border-slate-200 bg-white p-6 shadow-sm sm:p-8" action="/contact/" method="get" toolname="start_a1_drain_cleaning_request" tooldescription="Start a customer request for A-1 Drain Cleaning by collecting the customer name, phone, email, address, drain problem, and description.">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-black text-slate-950">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required toolparamdescription="Customer full name." class="mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none focus:border-[#b4232b] focus:ring-2 focus:ring-[#b4232b]/20" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-black text-slate-950">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required toolparamdescription="Customer phone number." class="mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none focus:border-[#b4232b] focus:ring-2 focus:ring-[#b4232b]/20" />
          </div>
          <div>
            <label for="email" class="block text-sm font-black text-slate-950">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" toolparamdescription="Customer email address, if they want a reply by email." class="mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none focus:border-[#b4232b] focus:ring-2 focus:ring-[#b4232b]/20" />
          </div>
          <div>
            <label for="address" class="block text-sm font-black text-slate-950">Address</label>
            <input id="address" name="address" type="text" autocomplete="street-address" required toolparamdescription="Customer service address." class="mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none focus:border-[#b4232b] focus:ring-2 focus:ring-[#b4232b]/20" />
          </div>
          <div class="sm:col-span-2">
            <label for="drain-problem" class="block text-sm font-black text-slate-950">Drain Problem</label>
            <select id="drain-problem" name="drain-problem" required toolparamdescription="The type of drain or sewer problem the customer is reporting." class="mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none focus:border-[#b4232b] focus:ring-2 focus:ring-[#b4232b]/20">
              <option value="">Select a drain problem</option>
              <option>Clogged Toilet</option><option>Kitchen Sink Drain</option><option>Bathroom Sink Drain</option><option>Bathtub / Shower Drain</option><option>Floor Drain</option><option>Laundry Drain</option><option>Main Sewer Line</option><option>Sewer Backup</option><option>Tree Roots in Sewer Line</option><option>Storm Sewer</option><option>Garbage Disposal Drain</option><option>Other</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="message" class="block text-sm font-black text-slate-950">What’s going on?</label>
            <textarea id="message" name="message" rows="5" toolparamdescription="Description of what is backing up, not draining, or where water is appearing." placeholder="Tell us what is backing up, what is not draining, or where you see water." class="mt-2 block w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none focus:border-[#b4232b] focus:ring-2 focus:ring-[#b4232b]/20"></textarea>
          </div>
        </div>
        <button type="submit" class="mt-6 min-h-12 w-full rounded-md bg-[#c52b34] px-6 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">Submit Request</button>
        <p class="mt-3 text-center text-sm text-slate-500">For urgent drain backups, calling 641-530-2728 is the fastest way to reach A-1.</p>
      </form>
    </div>
  </div>
</section>
