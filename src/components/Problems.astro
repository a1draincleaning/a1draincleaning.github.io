---
import {problems} from '../data/services';
---
<section id="problems" class="bg-white py-14"><div class="container"><p class="font-bold uppercase tracking-wide text-[#D9383A]">Tell us what the drain is doing</p><h2 class="brand mt-1 text-4xl text-[#1A1A68]">Common drain and sewer problems</h2><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{problems.map(([name,desc])=><article class="rounded-lg border-l-4 border-[#D9383A] bg-[#f5f5f5] p-5"><h3 class="font-bold text-lg">{name}</h3><p class="mt-2 text-gray-700">{desc}</p></article>)}</div></div></section>
