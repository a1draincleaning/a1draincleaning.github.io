---
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schemaType?: string;
  service?: {
    title: string;
    description: string;
  };
}

const { title, description, path = '/', service } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://a1draincleaning.github.io').href;

const business = {
  '@type': 'Plumber',
  '@id': 'https://a1draincleaning.github.io/#business',
  name: 'A-1 Drain Cleaning',
  url: 'https://a1draincleaning.github.io/',
  telephone: '+1-641-530-2728',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '206 29th St SW',
    addressLocality: 'Mason City',
    addressRegion: 'IA',
    postalCode: '50401',
    addressCountry: 'US'
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'North Iowa'
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59'
  }]
};

const graph = [
  {
    '@context': 'https://schema.org',
    ...business
  },
  {
    '@type': 'WebSite',
    '@id': 'https://a1draincleaning.github.io/#website',
    name: 'A-1 Drain Cleaning',
    url: 'https://a1draincleaning.github.io/',
    publisher: { '@id': 'https://a1draincleaning.github.io/#business' }
  },
  ...(service ? [{
    '@type': 'Service',
    '@id': canonical + '#service',
    name: service.title,
    serviceType: service.title,
    description: service.description,
    provider: { '@id': 'https://a1draincleaning.github.io/#business' },
    areaServed: { '@type': 'AdministrativeArea', name: 'North Iowa' },
    url: canonical,
    availableChannel: {
      '@type': 'ServiceChannel',
      servicePhone: {
        '@type': 'ContactPoint',
        telephone: '+1-641-530-2728',
        contactType: 'customer service'
      }
    }
  }] : []),
  ...(path !== '/' ? [{
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://a1draincleaning.github.io/'
      },
      ...(path.startsWith('/services/') ? [
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://a1draincleaning.github.io/services/'
        },
        ...(service ? [{
          '@type': 'ListItem',
          position: 3,
          name: service.title,
          item: canonical
        }] : [])
      ] : [{
        '@type': 'ListItem',
        position: 2,
        name: title.replace(' | A-1 Drain Cleaning', ''),
        item: canonical
      }])
    ]
  }] : [])
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': graph
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0f172a">
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    openGraph={{
      basic: {
        title,
        type: 'website',
        url: canonical,
        image: new URL('/favicon.svg', canonical).href
      },
      optional: {
        description,
        siteName: 'A-1 Drain Cleaning',
        locale: 'en_US'
      }
    }}
    twitter={{
      cardType: 'summary',
      title,
      description
    }}
  />
  <Schema item={schema} />
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-W9D7WZ6J');</script>
  <!-- End Google Tag Manager -->
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9D7WZ6J"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager -->
  <a class="skip" href="#main">Skip to content</a>
  <slot />
  <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-300 bg-white p-3 md:hidden">
    <a class="call-button block rounded-md bg-[#b4232b] px-4 py-3 text-center font-black text-white" href="tel:+16415302728">
      CALL 641-530-2728
    </a>
  </div>
</body>
</html>
