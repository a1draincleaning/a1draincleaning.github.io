---
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import { schemaServices } from '../data/schemaServices';
import { uniqueServiceAreaCities } from '../data/serviceAreaCities';
import { business } from '../data/business';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schemaType?: string;
  service?: { title: string; description: string };
  faqs?: { question: string; answer: string }[];
  city?: { name: string; counties: string[] };
  breadcrumbLabel?: string;
}

const { title, description, path = '/', service, city, breadcrumbLabel, faqs } = Astro.props;
const canonical = new URL(path, Astro.site ?? business.website).href;
const socialImage = new URL('/images/a1-main-sewer-drain-cleaning-mason-city.webp', canonical).href;
const businessId = `${business.website}#business`;
const websiteId = `${business.website}#website`;
const pageService = service ? schemaServices.find((item) => item.title === service.title) : undefined;

const serviceAreaAreas = [
  ...uniqueServiceAreaCities.map((item) => ({
      '@type': 'Place',
      name: `${item.name}, Iowa`
    })),
  {
    '@type': 'Place',
    name: 'Albert Lea, Minnesota',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'Minnesota' }
  }
];

const businessSchema = {
  // One canonical business entity: Organization identity plus the specific local-business type.
  '@type': ['Organization', 'Plumber'],
  '@id': businessId,
  name: business.name,
  description: 'A-1 Drain Cleaning provides drain cleaning and sewer service in Mason City, Iowa and nearby communities.',
  url: business.website,
  logo: business.logo,
  image: business.image,
  telephone: business.phone.tel,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: business.phone.tel,
    contactType: 'customer service',
    availableLanguage: 'English'
  },
  sameAs: business.sameAs,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country
  },
  areaServed: serviceAreaAreas,
  ...(path === '/about/' ? { founder: { '@type': 'Person', name: business.owner } } : {}),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Drain Cleaning and Sewer Services',
    itemListElement: schemaServices.map((item) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        '@id': `${business.website}services/${item.slug}/#service`
      }
    }))
  }
};

const graph = [
  businessSchema,
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: business.name,
    url: business.website,
    description: 'Official website of A-1 Drain Cleaning, providing drain cleaning and sewer services from Mason City, Iowa.',
    publisher: { '@id': businessId }
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    name: title,
    description,
    url: canonical,
    isPartOf: { '@id': websiteId },
    about: [
      { '@id': businessId },
      ...(city ? [{ '@id': `${canonical}#place` }] : []),
      ...(pageService ? [{ '@id': `${business.website}services/${pageService.slug}/#service` }] : [])
    ],
    publisher: { '@id': businessId }
  },
  ...(city ? [{
    '@type': 'Place',
    '@id': `${canonical}#place`,
    name: `${city.name}, Iowa`,
    containedInPlace: [
      ...city.counties.map((county) => ({ '@type': 'AdministrativeArea', name: `${county} County, Iowa` })),
      { '@type': 'AdministrativeArea', name: 'Iowa' }
    ]
  }] : []),
  ...(faqs?.length ? [{
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer
      }
    }))
  }] : []),
  ...schemaServices.map((item) => ({
    '@type': 'Service',
    '@id': `${business.website}services/${item.slug}/#service`,
    name: item.title,
    serviceType: item.title,
    description: item.description,
    provider: { '@id': businessId },
    areaServed: serviceAreaAreas,
    url: `${business.website}services/${item.slug}/`,
    availableChannel: {
      '@type': 'ServiceChannel',
      servicePhone: { '@type': 'ContactPoint', telephone: business.phone.tel, contactType: 'customer service' }
    }
  })),
  ...(path !== '/' ? [{
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
      ...(path.startsWith('/services/') ? [
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.website}services/` },
        ...(service ? [{ '@type': 'ListItem', position: 3, name: service.title, item: canonical }] : path === '/services/' ? [] : [{ '@type': 'ListItem', position: 3, name: breadcrumbLabel ?? title.replace(' | A-1 Drain Cleaning', ''), item: canonical }])
      ] : (path.startsWith('/service-area/') && path !== '/service-area/') || path === '/mason-city-drain-cleaning/' ? [
        { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: `${business.website}service-area/` },
        { '@type': 'ListItem', position: 3, name: breadcrumbLabel ?? title.replace(' | A-1 Drain Cleaning', ''), item: canonical }
      ] : [{
        '@type': 'ListItem', position: 2,
        name: path === '/service-area/' ? 'Areas We Serve' : breadcrumbLabel ?? title.replace(' | A-1 Drain Cleaning', ''),
        item: canonical
      }])
    ]
  }] : [])
];

const schema = { '@context': 'https://schema.org' as const, '@graph': graph };
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0f172a">
  <meta name="msvalidate.01" content="963F3EADCED4173B9A7FC77E3B84FADB">
  <meta name="google-site-verification" content="42JgcD63nJz97wrQoV4JkaEuwJuAfDHTswGmHnKFruc">
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    openGraph={{ basic: { title, type: 'website', url: canonical, image: socialImage }, optional: { description, siteName: business.name, locale: 'en_US' } }}
    twitter={{ card: 'summary_large_image', title, description, image: socialImage }}
  />
  <Schema item={schema as any} />
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="describedby" type="text/markdown" href="/agent-index.md" title="A-1 Drain Cleaning agent index">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-W9D7WZ6J');</script>
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9D7WZ6J" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <a class="skip" href="#main">Skip to content</a>
  <slot />
  <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-300 bg-white p-3 md:hidden">
    <a class="bottom-call-cta call-button block min-h-12 rounded-md bg-[#b4232b] px-4 py-3 text-center font-black text-white" href={`tel:${business.phone.tel}`}>CALL {business.phone.formatted}</a>
  </div>
  <style>
    .bottom-call-cta,
    .bottom-call-cta:hover,
    .bottom-call-cta:focus-visible {
      color: #fff !important;
      background-color: #b4232b !important;
    }

    .bottom-call-cta {
      border-top: 1px solid #ffffff;
      border-bottom: 1px solid #ffffff;
      box-shadow: 0 -2px 0 #1A1A68, 0 2px 0 #1A1A68, 0 1px 4px rgba(0, 0, 0, 0.08);
    }
  </style>
</body>
</html>