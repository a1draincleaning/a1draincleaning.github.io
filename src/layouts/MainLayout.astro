---
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schemaType?: string;
  service?: {
    title: string;
    description: string;
  };
}

const { title, description, path = '/', service } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://a1draincleaning.github.io').href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': 'https://a1draincleaning.github.io/#business',
  name: 'A-1 Drain Cleaning',
  url: 'https://a1draincleaning.github.io/',
  telephone: '+1-641-530-2728',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '206 29th St SW',
    addressLocality: 'Mason City',
    addressRegion: 'IA',
    postalCode: '50401',
    addressCountry: 'US'
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'North Iowa'
  }
};

const schema = service
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: service.title,
      description: service.description,
      provider: { '@id': 'https://a1draincleaning.github.io/#business' },
      areaServed: { '@type': 'AdministrativeArea', name: 'North Iowa' },
      url: canonical
    }
  : business;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    openGraph={{
      basic: {
        title,
        type: 'website',
        image: 'https://a1draincleaning.github.io/og-image.jpg',
        url: canonical
      },
      optional: {
        description,
        siteName: 'A-1 Drain Cleaning',
        locale: 'en_US'
      }
    }}
    twitter={{
      cardType: 'summary_large_image',
      title,
      description,
      image: 'https://a1draincleaning.github.io/og-image.jpg',
      imageAlt: 'A-1 Drain Cleaning in Mason City, Iowa'
    }}
  />
  <Schema item={schema} />
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-2JDT8SX13T"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-2JDT8SX13T');
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <slot />
  <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-300 bg-white p-3 md:hidden">
    <a class="block rounded-md bg-[#b4232b] px-4 py-3 text-center font-black text-white" href="tel:+16415302728">
      Call A-1 Drain Cleaning: 641-530-2728
    </a>
  </div>
</body>
</html>
