---
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import { services } from '../data/services';
import { uniqueServiceAreaCities } from '../data/serviceAreaCities';
import { business } from '../data/business';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schemaType?: string;
  service?: { title: string; description: string };
  city?: { name: string; counties: string[] };
}

const { title, description, path = '/', service, city } = Astro.props;
const canonical = new URL(path, Astro.site ?? business.website).href;
const businessId = `${business.website}#business`;
const websiteId = `${business.website}#website`;

const serviceAreaAreas = [
  { '@type': 'AdministrativeArea', name: 'North Iowa' },
  ...Array.from(new Set(uniqueServiceAreaCities.flatMap((item) => item.counties))).map((county) => ({
    '@type': 'AdministrativeArea',
    name: `${county} County, Iowa`
  })),
  ...uniqueServiceAreaCities.map((item) => ({
    '@type': 'Place',
    name: `${item.name}, Iowa`,
    containedInPlace: item.counties.map((county) => ({
      '@type': 'AdministrativeArea',
      name: `${county} County, Iowa`
    }))
  }))
];

const businessSchema = {
  '@type': 'Plumber',
  '@id': businessId,
  name: business.name,
  url: business.website,
  sameAs: business.sameAs,
  logo: business.logo,
  image: business.image,
  telephone: business.phone.tel,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country
  },
  areaServed: serviceAreaAreas,
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59'
  }],
  founder: { '@type': 'Person', name: business.owner },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Drain Cleaning and Sewer Services',
    itemListElement: services.filter(({ slug }) => [
      'main-drain-cleaning', 'sewer-line-cleaning', 'tree-roots-in-sewer-line', 'hydro-jetting',
      'basement-floor-drains', 'kitchen-bathroom-drains', 'toilet-clogs', 'laundry-drains',
      'sewer-backup-emergency', 'sewer-backup-into-tub-shower'
    ].includes(slug)).map((item) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: item.title,
        description: item.description,
        url: `${business.website}services/${item.slug}/`
      }
    }))
  }
};

const graph = [
  businessSchema,
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: business.name,
    url: business.website,
    publisher: { '@id': businessId }
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    name: title,
    description,
    url: canonical,
    isPartOf: { '@id': websiteId },
    about: [
      { '@id': businessId },
      ...(city ? [{ '@id': `${canonical}#place` }] : [])
    ],
    publisher: { '@id': businessId }
  },
  ...(city ? [{
    '@type': 'Place',
    '@id': `${canonical}#place`,
    name: `${city.name}, Iowa`,
    containedInPlace: [
      ...city.counties.map((county) => ({ '@type': 'AdministrativeArea', name: `${county} County, Iowa` })),
      { '@type': 'AdministrativeArea', name: 'Iowa' }
    ]
  }] : []),
  ...(service ? [{
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: service.title,
    serviceType: service.title,
    description: service.description,
    provider: { '@id': businessId },
    areaServed: serviceAreaAreas,
    url: canonical,
    availableChannel: {
      '@type': 'ServiceChannel',
      servicePhone: { '@type': 'ContactPoint', telephone: business.phone.tel, contactType: 'customer service' }
    }
  }] : []),
  ...(path !== '/' ? [{
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
      ...(path.startsWith('/services/') ? [
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.website}services/` },
        ...(service ? [{ '@type': 'ListItem', position: 3, name: service.title, item: canonical }] : path === '/services/' ? [] : [{ '@type': 'ListItem', position: 3, name: title.replace(' | A-1 Drain Cleaning', ''), item: canonical }])
      ] : path.startsWith('/service-area/') && path !== '/service-area/' ? [
        { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: `${business.website}service-area/` },
        { '@type': 'ListItem', position: 3, name: title.replace(' | A-1 Drain Cleaning', ''), item: canonical }
      ] : [{
        '@type': 'ListItem', position: 2,
        name: path === '/service-area/' ? 'Areas We Serve' : title.replace(' | A-1 Drain Cleaning', ''),
        item: canonical
      }])
    ]
  }] : [])
];

const schema = { '@context': 'https://schema.org' as const, '@graph': graph };
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0f172a">
  <meta name="msvalidate.01" content="963F3EADCED4173B9A7FC77E3B84FADB">
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    openGraph={{ basic: { title, type: 'website', url: canonical, image: new URL('/images/a1-main-sewer-drain-cleaning-mason-city.webp', canonical).href }, optional: { description, siteName: business.name, locale: 'en_US' } }}
    twitter={{ card: 'summary', title, description }}
  />
  <Schema item={schema as any} />
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-W9D7WZ6J');</script>
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9D7WZ6J" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <a class="skip" href="#main">Skip to content</a>
  <slot />
  <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-300 bg-white p-3 md:hidden">
    <a class="call-button block min-h-12 rounded-md bg-[#b4232b] px-4 py-3 text-center font-black text-white" href={`tel:${business.phone.tel}`}>CALL {business.phone.formatted}</a>
  </div>
</body>
</html>
