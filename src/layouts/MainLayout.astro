---
import '../styles/global.css';
const {title,description,path='/',schemaType='LocalBusiness',service} = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://a1draincleaning.github.io').href;
const business = {
  '@context':'https://schema.org','@type':'Plumber','@id':'https://a1draincleaning.github.io/#business',
  name:'A-1 Drain Cleaning',url:'https://a1draincleaning.github.io/',telephone:'+1-641-530-2728',email:'a1draincleaning@gmail.com',
  founder:{'@type':'Person',name:'Josh Theilen'},
  address:{'@type':'PostalAddress',streetAddress:'206 29th St SW',addressLocality:'Mason City',addressRegion:'IA',postalCode:'50401',addressCountry:'US'},
  areaServed:'North Iowa and nearby communities',
  openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'00:00',closes:'23:59'}]
};
const schema = service ? {'@context':'https://schema.org','@type':'Service',name:service.title,description:service.description,provider:{'@id':'https://a1draincleaning.github.io/#business'},areaServed:{'@type':'Place',name:'North Iowa and nearby communities'},url:canonical} : business;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical}>
<meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script async src="https://www.googletagmanager.com/gtag/js?id=G-2JDT8SX13T"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-2JDT8SX13T');</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<slot />
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-300 p-3 md:hidden"><a class="phone-pulse block rounded-md bg-[#D9383A] px-4 py-3 text-center font-bold text-white" href="tel:+16415302728">Call A-1 Drain Cleaning: 641-530-2728</a></div>
</body></html>
