---
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schemaType?: string;
  service?: {
    title: string;
    description: string;
  };
}

const { title, description, path = '/', service } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://a1draincleaning.github.io').href;

const business = {
  '@type': 'Plumber',
  '@id': 'https://a1draincleaning.github.io/#business',
  name: 'A-1 Drain Cleaning',
  url: 'https://a1draincleaning.github.io/',
  telephone: '+1-641-530-2728',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '206 29th St SW',
    addressLocality: 'Mason City',
    addressRegion: 'IA',
    postalCode: '50401',
    addressCountry: 'US'
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'North Iowa'
  }
};

const graph = [
  {
    '@context': 'https://schema.org',
    ...business
  },
  {
    '@type': 'WebSite',
    '@id': 'https://a1draincleaning.github.io/#website',
    name: 'A-1 Drain Cleaning',
    url: 'https://a1draincleaning.github.io/',
    publisher: { '@id': 'https://a1draincleaning.github.io/#business' }
  },
  ...(service ? [{
    '@type': 'Service',
    '@id': canonical + '#service',
    name: service.title,
    description: service.description,
    provider: { '@id': 'https://a1draincleaning.github.io/#business' },
    areaServed: { '@type': 'AdministrativeArea', name: 'North Iowa' },
    url: canonical
  }] : []),
  ...(path !== '/' ? [{
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://a1draincleaning.github.io/'
      },
      ...(path.startsWith('/services/') ? [
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://a1draincleaning.github.io/services/'
        },
        ...(service ? [{
          '@type': 'ListItem',
          position: 3,
          name: service.title,
          item: canonical
        }] : [])
      ] : [{
        '@type': 'ListItem',
        position: 2,
        name: title.replace(' | A-1 Drain Cleaning', ''),
        item: canonical
      }])
    ]
  }] : [])
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': graph
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0f172a">
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    openGraph={{
      basic: {
        title,
        type: 'website',
        url: canonical
      },
      optional: {
        description,
        siteName: 'A-1 Drain Cleaning',
        locale: 'en_US'
      }
    }}
    twitter={{
      cardType: 'summary',
      title,
      description
    }}
  />
  <Schema item={schema} />
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@700;800;900&display=swap" rel="stylesheet">
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-2JDT8SX13T"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-2JDT8SX13T');
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <slot />
  <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-300 bg-white p-3 md:hidden">
    <a class="call-button block rounded-md bg-[#b4232b] px-4 py-3 text-center font-black text-white" href="tel:+16415302728">
      Call A-1 Drain Cleaning: 641-530-2728
    </a>
  </div>
</body>
</html>
