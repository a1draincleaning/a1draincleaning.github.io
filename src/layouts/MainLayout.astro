---
import SEO from 'astro-seo';
import Schema from 'astro-seo-schema';
import { services, featuredServiceSlugs } from '../data/services';
import { uniqueServiceAreaCities } from '../data/serviceAreaCities';
import { business } from '../data/business';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  city?: { name: string; slug: string };
  service?: { name: string; slug: string; description?: string };
}

const { title, description, path = '/', city, service } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const serviceAreaAreas = [
  { '@type': 'Place', name: 'North Iowa' },
  ...uniqueServiceAreaCities.map((entry) => ({ '@type': 'City', name: entry.name, containedInPlace: { '@type': 'State', name: 'Iowa' } })),
];

const businessSchema = {
  '@type': 'Plumber',
  '@id': `${business.website}#business`,
  name: business.name,
  url: business.website,
  telephone: business.phone.tel,
  image: business.image,
  logo: business.logo,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  founder: { '@type': 'Person', name: business.owner },
  areaServed: serviceAreaAreas,
  sameAs: business.sameAs,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Drain Cleaning Services',
    itemListElement: featuredServiceSlugs.map((slug) => {
      const item = services.find((entry) => entry.slug === slug);
      return item ? { '@type': 'Offer', itemOffered: { '@type': 'Service', name: item.name } } : null;
    }).filter(Boolean),
  },
};

const pageSchema = {
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${business.website}#website` },
  about: { '@id': `${business.website}#business` },
};

const graph = [businessSchema, pageSchema];
---

<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: business.image,
          url: canonical,
        },
      }}
    />
    <Schema schema={{ '@context': 'https://schema.org', '@graph': graph }} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-W9D7WZ6J');</script>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9D7WZ6J" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script is:inline src="https://learntok-backend-2026-24c204fe508e.herokuapp.com/leadpulse/embed.js" data-key="lp_83827ecbd5692cf9f4176805" async></script>
  </body>
</html>
