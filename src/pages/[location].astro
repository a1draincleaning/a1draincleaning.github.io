---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { citiesData, type CityData } from '../data/cities';
import { getFaqsForCity } from '../data/faqs';
import { generateGraphSchema } from '../utils/schema';

export function getStaticPaths() {
  return citiesData.map((city) => ({
    params: { location: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as { city: CityData };
const canonicalUrl = new URL(`/${city.slug}/`, Astro.site ?? 'https://a1draincleaning.github.io').href;
const faqData = getFaqsForCity(city);

const businessInfo = {
  name: 'A-1 Drain Cleaning',
  owner: 'Josh Theilen',
  phoneTel: '+1-641-530-2728',
  url: 'https://a1draincleaning.github.io',
  addressLocality: 'Mason City',
  addressRegion: 'IA',
  postalCode: '50401',
  addressCountry: 'US',
};

const schemaGraph = generateGraphSchema(city, businessInfo, faqData, canonicalUrl);
const title = `Sewer & Drain Cleaning in ${city.cityName}, Iowa | A-1 Drain Cleaning`;
const description = `Drain cleaning, sewer line cleaning, basement floor drain clearing, root cutting, and hydro jetting in ${city.cityName}, Iowa. Call A-1 Drain Cleaning at 641-530-2728.`;
---
<MainLayout title={title} description={description} path={`/${city.slug}/`} schemaGraph={schemaGraph}>
  <Header location={`${city.cityName}, Iowa`} />
  <main id="main">
    <section class="bg-white py-12 md:py-16">
      <div class="container">
        <p class="font-bold uppercase tracking-wide text-[#D9383A]">A-1 Drain Cleaning • North Iowa</p>
        <h1 class="brand mt-2 max-w-4xl text-5xl text-[#1A1A68]">Sewer &amp; Drain Cleaning in {city.cityName}, Iowa</h1>
        <p class="mt-5 max-w-3xl text-xl">Drain and sewer service for homes and businesses in {city.cityName}. If water is backing up, several drains are affected, or a sewer line keeps clogging, call A-1 and explain what the line is doing.</p>
        <a href="tel:+16415302728" class="phone-pulse mt-7 inline-block rounded-md bg-[#D9383A] px-6 py-4 text-lg font-bold text-white">Call 641-530-2728</a>
      </div>
    </section>

    <section class="py-14">
      <div class="container">
        <h2 class="brand text-3xl text-[#1A1A68]">Drain &amp; Sewer Problems We Handle</h2>
        <div class="mt-7 grid gap-5 md:grid-cols-2">
          {city.commonIssues.map((issue) => (
            <article class="rounded-lg border border-gray-200 bg-white p-6">
              <h3 class="text-xl font-bold text-[#1A1A68]">{issue}</h3>
              <p class="mt-2 text-gray-700">If this is what the drain is doing, call A-1 and describe the symptoms. The exact location of the blockage determines how the line should be cleared.</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#f5f5f5] py-14">
      <div class="container">
        <h2 class="brand text-3xl text-[#1A1A68]">Basement Floor Drain Backing Up?</h2>
        <p class="mt-4 max-w-4xl text-lg leading-8 text-gray-700">A basement floor drain is often one of the first places a main drain blockage becomes visible because it is low in the house. If the floor drain fills when a toilet is flushed, the washer drains, or another fixture runs, stop adding water if possible and call A-1.</p>

        <h2 class="brand mt-10 text-3xl text-[#1A1A68]">Main Sewer Line Cleaning</h2>
        <p class="mt-4 max-w-4xl text-lg leading-8 text-gray-700">When several fixtures are slow or backing up together, the restriction may be farther down the main drain or sewer line. A-1 clears main-line blockages and can discuss a camera inspection when the symptoms suggest a recurring or damaged-line problem.</p>

        <h2 class="brand mt-10 text-3xl text-[#1A1A68]">Tree Roots &amp; Heavy Buildup</h2>
        <p class="mt-4 max-w-4xl text-lg leading-8 text-gray-700">Roots can restrict older underground sewer lines. Heavy buildup can also reduce the usable opening. A-1 uses the cleaning method that fits the actual line and blockage, including hydro jetting when appropriate.</p>
      </div>
    </section>

    <section class="py-14">
      <div class="container">
        <h2 class="brand text-3xl text-[#1A1A68]">Local Service Context</h2>
        <p class="mt-4 max-w-4xl text-gray-700">{city.localContext} {city.regionalAccess}</p>
        <p class="mt-4 max-w-4xl text-gray-700">A-1 is based in Mason City and travels throughout North Iowa. Nearby communities include {city.adjacentTowns.join(', ')}.</p>
      </div>
    </section>

    <section class="bg-white py-14">
      <div class="container max-w-4xl">
        <h2 class="brand text-3xl text-[#1A1A68]">Frequently Asked Questions</h2>
        <div class="mt-7 space-y-6">
          {faqData.map((faq) => (
            <article>
              <h3 class="text-xl font-bold text-[#1A1A68]">{faq.question}</h3>
              <p class="mt-2 leading-7 text-gray-700">{faq.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#1A1A68] py-12 text-white">
      <div class="container">
        <h2 class="brand text-3xl">Need the line cleared?</h2>
        <p class="mt-3 max-w-2xl text-lg">Call A-1 Drain Cleaning at 641-530-2728 and tell us what is backing up, which fixture is affected, and whether other drains are involved.</p>
        <a href="tel:+16415302728" class="mt-6 inline-block rounded-md bg-[#D9383A] px-6 py-4 font-bold text-white">641-530-2728</a>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
