---
import MainLayout from '../layouts/MainLayout.astro';
const title = "What's Causing Your Drain Problem? | A-1 Drain Cleaning, Mason City";
const description = "Answer a few questions about a basement floor drain backing up, a sewer backup in the basement, or a slow drain. A-1 Drain Cleaning in Mason City, Iowa helps you see what those symptoms usually point toward.";
---
<MainLayout title={title} description={description} path="/drain-problem-quiz/">
  <header class="sticky top-0 z-20 border-b border-navy-deep bg-navy text-inverse"><div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3"><div><p class="font-display text-3xl leading-none tracking-wide">A-1</p><p class="font-display text-sm leading-none tracking-[0.16em] text-inverse/80">DRAIN CLEANING</p><p class="mt-1 text-xs text-inverse/75">Mason City, Iowa</p></div><a href="tel:+16415302728" class="inline-flex min-h-12 items-center bg-accent px-3 text-base font-semibold text-inverse no-underline sm:px-4">641-530-2728</a></div></header>
  <main><div class="mx-auto grid max-w-5xl gap-8 px-4 py-8 sm:py-12 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] lg:items-start lg:gap-12"><div class="lg:sticky lg:top-28"><p class="text-sm font-semibold tracking-wide text-navy uppercase">Drain & sewer symptoms · North Iowa</p><h1 class="mt-2 font-display text-5xl leading-none tracking-wide text-navy uppercase sm:text-6xl">What’s Causing Your Drain Problem?</h1><p class="mt-4 text-lg leading-relaxed text-ink">Answer a few questions about what you’re seeing. We’ll narrow down the most likely cause and tell you what to check next.</p><p class="mt-3 text-base leading-relaxed text-muted">Nine questions. No typing. You can go back and change an answer. This will not price the job or promise a repair.</p><p class="mt-5 border-l-4 border-accent py-1 pl-4 text-base leading-relaxed text-ink">If sewage is already coming up through a basement floor drain, stop using water and call <a class="font-semibold text-navy underline" href="tel:+16415302728">641-530-2728</a>.</p></div><section id="quiz" class="scroll-mt-24 rounded-card bg-card shadow-card" aria-labelledby="qtitle"><div class="border-b border-line px-4 py-4 sm:px-6"><p id="progress" class="text-sm font-semibold tracking-wide text-navy uppercase">Question 1 of 9</p><div class="mt-3 h-1.5 bg-line"><div id="bar" class="h-full bg-navy" style="width:11.11%"></div></div></div><div id="quiz-content" class="px-4 py-5 sm:px-6 sm:py-6"></div></section></div></main>
</MainLayout>
<script>
const Q=[
['location','Where is the water or sewage showing up?','If it is coming out in more than one place, choose that.',[['basement','Basement floor drain'],['toilet','Toilet'],['fixture','Shower, bathtub, or sink'],['cleanout','Outside sewer cleanout'],['multiple','More than one location']]],
['water','Is the water dirty, gray, or sewage-like?','Color and smell are enough. You do not need to identify anything in it.',[['sewage','Yes — dirty, gray, or sewage-like'],['clear','No — it looks mostly clear'],['unsure','Not sure']]],
['cross','Does another fixture cause the backup when it drains?','For example, running the washing machine, a shower, or a toilet pushes water out of the basement floor drain or another fixture.',[['yes','Yes — using one fixture makes water come out somewhere else'],['no','No — it only happens at that one fixture'],['unsure','Not sure']]],
['multiple','Are multiple drains or fixtures backing up at the same time?','', [['yes','Yes — more than one drain is affected'],['no','No — just one drain or fixture'],['unsure','Not sure']]],
['flow','Is the drain completely blocked, or is it just slow?','If a basement floor drain is involved, answer for that drain.',[['blocked','Completely blocked — water sits or comes back up'],['slow','It still drains, but slowly'],['none','The basement floor drain seems fine, or there isn’t one'],['unsure','Not sure']]],
['timing','Does the problem show up after heavy water use?','Laundry, showers, the dishwasher, or several fixtures running close together.',[['heavy','Yes — mostly after heavy water use'],['light','No — it happens even with light use'],['unsure','Not sure']]],
['history','Is this a one-time problem, or does it keep coming back?','', [['first','This is the first time'],['repeats','It keeps coming back'],['returned','The line was cleaned, and the problem returned'],['unsure','Not sure']]],
['roots','Have tree roots been a problem in the sewer line?','Answer yes only if roots were actually found, or a technician told you they were in the line.',[['yes','Yes — roots have been found in the line'],['no','No'],['unsure','Not sure']]],
['active','Is sewage backing up into the basement right now?','Answer yes if dirty water or sewage is coming up through a floor drain or another basement opening at this moment.',[['now','Yes — sewage or dirty water is coming up now'],['earlier','It was earlier, but it has stopped'],['no','No']]]
];
const A={};let step=0;const el=document.getElementById('quiz-content'),bar=document.getElementById('bar'),progress=document.getElementById('progress'),section=document.getElementById('quiz');
const single=a=>['fixture','toilet'].includes(a.location)&&a.location!=='multiple'&&a.multiple!=='yes'&&a.cross!=='yes';
function result(a){const m=a.location==='multiple'||a.multiple==='yes',c=a.cross==='yes',s=a.water==='sewage',b=a.flow==='blocked',slow=a.flow==='slow',base=a.location==='basement',clean=a.location==='cleanout',one=single(a),root=a.roots==='yes',returned=a.history==='returned',repeat=a.history==='repeats',active=a.active==='now',earlier=a.active==='earlier',down=m||clean||c;if(one&&!root&&!returned&&!repeat&&!s&&a.active==='no')return'inspection';if(root&&!one&&(returned||repeat||slow||down||base||s||b||active||earlier))return'roots';if(returned&&!one)return'recurring';if(repeat&&!root&&!one&&!b&&!s&&!active&&(slow||a.timing==='heavy'||base||down))return'recurring';if(down&&(s||b||m||clean||active||slow)){if(slow&&!b&&!s&&!active&&!clean)return'restriction';if(base&&!m&&!clean)return'basement';return'main'}if(base&&(s||b||active||earlier))return'basement';if(base&&slow)return'restriction';if((slow||a.timing==='heavy')&&(s||base||down)&&!one)return'restriction';if(active)return m||clean||(c&&!base)?'main':'basement';if(earlier&&(s||base||down))return m||clean||(c&&!base)?'main':'basement';return'inspection'}
const titles={main:'Likely Main Sewer Line Blockage',basement:'Likely Basement Floor Drain / Main Drain Backup',roots:'Possible Tree Root Intrusion',restriction:'Possible Sewer Line Restriction',recurring:'Possible Recurring Sewer Line Problem',inspection:'Drain Problem Needs Further Inspection'};
const copy={main:['Your answers point most strongly toward a main sewer line blockage.','When several fixtures back up together, or when water used in one part of the house comes out somewhere else, the restriction is often farther downstream in the main drain or sewer line. These answers cannot show whether the pipe is also cracked, sagging, or full of roots.'],basement:['Your answers point most strongly toward a basement floor drain or main drain backup.','The floor drain is usually the lowest opening in the house. Dirty water there — especially when the washer, a shower, or a toilet drains — means the line it ties into is not keeping up. The stoppage may be at the floor drain itself or farther down the main.'],roots:['Your answers point most strongly toward possible tree root intrusion.','Roots that have already been in a sewer line often grow back at a joint. They catch paper and grease, the flow slows, and then a floor drain or several fixtures back up. A camera is what shows whether roots are actually in the line.'],restriction:['The symptoms are consistent with a sewer line restriction, not necessarily a total blockage.','The line still moves some water, but it falls behind — often after laundry, showers, or other heavy use. Grease, scale, a partial clog, or the start of a root mass can all do that.'],recurring:['Based on what you described, this looks like a recurring sewer line problem.','A line that backs up again after it has been cleaned is not acting like a one-time clog. Roots, a sag, or damage in the pipe can all let a blockage rebuild. A camera is how those causes get sorted out.'],inspection:['Your answers do not settle on one cause.','A few of the details that separate a single clogged fixture from a main sewer problem are missing or marked not sure. The next step is to have the drain checked.']};
function service(r,a){const out=[];const add=(n,t)=>{if(!out.some(x=>x[0]===n))out.push([n,t])};if(a.active==='now')add('Emergency Sewer Backup Service','Sewage or dirty water is coming up in the basement now. Stop using water in the house and call before more of it is added to the line.');if(r==='roots')add('Root Cutting','Roots have to be cut out of the pipe. A camera can show whether they are entering at a joint or through a crack.');if(r==='basement')add('Main Drain Cleaning','The backup is showing at the basement floor drain or the main drain it ties into. That is the line to open.');if(['main','roots','recurring'].includes(r))add('Sewer Line Cleaning','The symptoms sit downstream of a single fixture. Cleaning the sewer line is what lets the house drain again.');if(r==='restriction'||r==='recurring')add('Hydro Jetting','Slow flow after heavy water use can be grease, scale, or soft buildup. Hydro jetting washes that material out.');if(['roots','recurring'].includes(r)||a.history==='returned')add('Camera Inspection','A camera shows whether roots, a damaged section, or another line problem is why the backup returned.');if(r==='inspection')add('Clear the affected drain','Start with the fixture that is acting up. Nothing else you described ties it to the main sewer yet.');return out}
function next(r,a){if(a.active==='now')return'Have sewage coming up through the basement floor drain? Stop using water and call A-1 Drain Cleaning at 641-530-2728.';if(a.active==='earlier')return'The backup has stopped for now. Do not wait on the next load of laundry to see if it returns. Call A-1 Drain Cleaning at 641-530-2728.';if(r==='roots')return'If roots are in the line, they need to be cut, not just poked through. Call A-1 Drain Cleaning at 641-530-2728.';if(r==='restriction')return'A slow line is easier to open before it becomes a backup. Call A-1 Drain Cleaning at 641-530-2728.';if(r==='recurring')return'Have the line cleaned and checked with a camera so you can see why it keeps coming back. Call A-1 Drain Cleaning at 641-530-2728.';return'Call A-1 Drain Cleaning at 641-530-2728 and say which fixture is affected.'}
function render(){const q=Q[Math.min(step,8)],done=step===9;progress.textContent=done?'Your result':`Question ${step+1} of 9`;bar.style.width=`${(Math.min(step+1,9)/9)*100}%`;if(!done){const selected=A[q[0]];el.innerHTML=`<h2 id="qtitle" tabindex="-1" class="text-2xl font-semibold text-navy outline-none sm:text-3xl">${q[1]}</h2>${q[2]?`<p class="mt-2 text-base leading-relaxed text-muted">${q[2]}</p>`:''}<div class="mt-5 grid gap-3" role="radiogroup" aria-labelledby="qtitle">${q[3].map((o,i)=>`<button type="button" role="radio" aria-checked="${selected===o[0]}" data-v="${o[0]}" class="flex min-h-14 w-full items-center gap-3 rounded-lg border-2 px-4 py-3 text-left text-lg leading-snug ${selected===o[0]?'border-navy bg-navy text-inverse':'border-line bg-card text-ink hover:border-navy hover:bg-paper'}"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full border-2">${selected===o[0]?'✓':''}</span><span>${o[1]}</span></button>`).join('')}</div><div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between"><button id="back" type="button" ${step===0?'disabled':''} class="min-h-12 px-2 text-base font-semibold text-navy disabled:opacity-40">‹ Back</button><button id="next" type="button" ${selected==null?'disabled':''} class="min-h-12 bg-accent px-6 text-lg font-semibold text-inverse disabled:opacity-40">${step===8?'See what this points to':'Next'}</button></div>`;el.querySelectorAll('[data-v]').forEach(b=>b.addEventListener('click',()=>{A[q[0]]=b.dataset.v;render();focus()}));el.querySelector('#back').addEventListener('click',()=>{step--;render();focus()});el.querySelector('#next').addEventListener('click',()=>{if(A[q[0]]){step++;render();focus()}})}else{const r=result(A),p=copy[r],s=service(r,A),alert=A.active==='now';el.innerHTML=`${alert?'<div class="border-b bg-alert-bg px-4 py-5" role="alert"><p class="font-display text-3xl tracking-wide text-alert uppercase">Active sewage backup</p><p class="mt-2 text-lg font-semibold">Stop using water in the house until the blockage is addressed.</p><a class="mt-3 inline-block text-xl font-semibold text-navy underline" href="tel:+16415302728">641-530-2728</a></div>':''}<div class="px-4 py-5 sm:px-6 sm:py-6"><p class="text-sm font-semibold tracking-wide text-muted uppercase">Based on what you described</p><h2 id="result-title" tabindex="-1" class="mt-2 font-display text-4xl leading-none tracking-wide text-navy uppercase">${titles[r]}</h2><div class="mt-4 grid gap-3 text-base leading-relaxed text-ink">${p.map(x=>`<p>${x}</p>`).join('')}</div>${Object.values(A).filter(x=>x==='unsure').length>=3?'<p class="mt-4 border-l-4 border-navy py-1 pl-4">Several answers were “not sure.” Treat this as a starting point, not a firm read.</p>':''}<h3 class="mt-8 text-lg font-semibold text-navy">What fits these symptoms</h3><ul class="mt-2 divide-y divide-line border-y border-line">${s.map(x=>`<li class="py-4"><p class="text-lg font-semibold text-navy">${x[0]}</p><p class="mt-1 leading-relaxed">${x[1]}</p></li>`).join('')}</ul><p class="mt-4 text-sm leading-relaxed text-muted">This is not a diagnosis and it is not a substitute for looking at the drain or sewer line. A-1 confirms the cause on site.</p><div class="mt-6 bg-navy px-4 py-5 text-inverse"><p class="text-lg leading-relaxed">${next(r,A)}</p><a href="tel:+16415302728" class="mt-4 inline-flex min-h-12 items-center bg-accent px-5 text-lg font-semibold text-inverse no-underline">Call A-1 Drain Cleaning</a></div><details class="mt-6 border-t border-line"><summary class="flex min-h-12 items-center font-semibold text-navy">Review your answers</summary><dl class="grid gap-3 pb-2">${Q.map(q=>`<div><dt class="text-sm text-muted">${q[1]}</dt><dd class="font-semibold">${q[3].find(o=>o[0]===A[q[0]])?.[1]||A[q[0]]}</dd></div>`).join('')}</dl></details><div class="mt-4 flex justify-between"><button id="change" type="button" class="min-h-12 px-2 font-semibold text-navy">‹ Change an answer</button><button id="restart" type="button" class="min-h-12 px-2 font-semibold text-navy underline">Start over</button></div></div>`;el.querySelector('#change').addEventListener('click',()=>{step=8;render();focus()});el.querySelector('#restart').addEventListener('click',()=>{Object.keys(A).forEach(k=>delete A[k]);step=0;render();focus()})}}
function focus(){requestAnimationFrame(()=>{const h=el.querySelector('h2');if(h instanceof HTMLElement){h.focus();const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const top=section.getBoundingClientRect().top;if(top<72||top>160)section.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'})}})}render();
</script>
