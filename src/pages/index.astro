---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import GoogleBusinessInfo from '../components/GoogleBusinessInfo.astro';
---

<MainLayout
  title="Drain & Sewer Cleaning in Mason City, Iowa | A-1 Drain Cleaning"
  description="Need a plumber in Mason City, Iowa for a clogged drain or sewer backup? A-1 Drain Cleaning handles drain and sewer cleaning across North Iowa."
  path="/"
>
  <Header />
  <main id="main">
    <Hero />

    <section aria-label="A-1 Drain Cleaning services" class="border-b border-slate-200 bg-white">
      <div class="container overflow-x-auto">
        <div class="grid min-w-[900px] grid-cols-5 divide-x divide-slate-200">
          <a href="/services/main-drain-cleaning/" class="group flex min-h-[150px] flex-col items-center justify-center px-4 py-7 text-center transition hover:bg-slate-50">
            <svg aria-hidden="true" viewBox="0 0 64 64" class="h-12 w-12 text-[#1A1A68]" fill="none" stroke="currentColor" stroke-width="4">
              <circle cx="32" cy="32" r="24" />
              <circle cx="32" cy="32" r="17" />
              <path d="M23 24h2M31 20h2M40 24h2M20 32h2M30 29h2M40 32h2M24 40h2M33 40h2M39 40h2" stroke-linecap="round" />
            </svg>
            <span class="mt-4 text-sm font-black uppercase leading-5 tracking-wide text-[#1A1A68]">Main Drain<br />Cleaning</span>
          </a>

          <a href="/services/sewer-line-cleaning/" class="group flex min-h-[150px] flex-col items-center justify-center px-4 py-7 text-center transition hover:bg-slate-50">
            <svg aria-hidden="true" viewBox="0 0 64 64" class="h-12 w-12 text-[#1A1A68]" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 12v25c0 8 6 14 14 14s14-6 14-14V29" />
              <path d="M18 12h11M46 29h10" />
              <path d="M12 10h12v8H12zM46 25h12v8H46z" fill="currentColor" stroke="none" />
            </svg>
            <span class="mt-4 text-sm font-black uppercase leading-5 tracking-wide text-[#1A1A68]">Sewer Line<br />Cleaning</span>
          </a>

          <a href="/services/basement-floor-drains/" class="group flex min-h-[150px] flex-col items-center justify-center px-4 py-7 text-center transition hover:bg-slate-50">
            <svg aria-hidden="true" viewBox="0 0 64 64" class="h-12 w-12 text-[#1A1A68]" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="32" cy="33" rx="23" ry="17" />
              <path d="M18 27l28 12M18 38l28-12M32 16v34M11 33h42" />
            </svg>
            <span class="mt-4 text-sm font-black uppercase leading-5 tracking-wide text-[#1A1A68]">Floor Drain<br />Backups</span>
          </a>

          <a href="/services/toilet-clogs/" class="group flex min-h-[150px] flex-col items-center justify-center px-4 py-7 text-center transition hover:bg-slate-50">
            <svg aria-hidden="true" viewBox="0 0 64 64" class="h-12 w-12 text-[#1A1A68]" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12h22v17c0 8-5 14-13 14s-13-6-13-14V12z" />
              <path d="M21 12h22M27 43v8M37 43v8M23 52h18" />
            </svg>
            <span class="mt-4 text-sm font-black uppercase leading-5 tracking-wide text-[#1A1A68]">Toilet &amp; Drain<br />Clogs</span>
          </a>

          <a href="tel:+16415302728" class="group flex min-h-[150px] flex-col items-center justify-center px-4 py-7 text-center transition hover:bg-slate-50">
            <svg aria-hidden="true" viewBox="0 0 64 64" class="h-12 w-12 text-[#b4232b]" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12l8 8-6 7c4 8 8 12 14 14l7-6 8 8-5 8c-2 3-7 4-11 2C22 46 14 38 9 24c-2-5 0-9 4-11l8-1z" />
            </svg>
            <span class="mt-4 text-sm font-black uppercase leading-5 tracking-wide text-[#b4232b]">Call<br />641-530-2728</span>
          </a>
        </div>
      </div>
    </section>

    <ServicesGrid />

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Equipment & methods</p>
          <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">The right tool depends on the line.</h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <article class="border border-slate-200 bg-white p-5"><h3 class="font-black">Drain machines</h3><p class="mt-2 text-sm leading-6 text-slate-600">Different cable sizes and root-cutting equipment help clear drain and sewer blockages when suited to the line and the problem.</p></article>
          <article class="border border-slate-200 bg-white p-5"><h3 class="font-black">Sewer cameras</h3><p class="mt-2 text-sm leading-6 text-slate-600">A camera can show what is inside a sewer line when a recurring problem needs more investigation.</p></article>
          <article class="border border-slate-200 bg-white p-5"><h3 class="font-black">Line locating</h3><p class="mt-2 text-sm leading-6 text-slate-600">Locating equipment can help identify where an underground sewer or drain line runs.</p></article>
          <article class="border border-slate-200 bg-white p-5"><h3 class="font-black">Hydro-jetting</h3><p class="mt-2 text-sm leading-6 text-slate-600">Pressurized water can clean buildup when jetting is appropriate for the pipe and blockage.</p></article>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">North Iowa</p>
        <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Mason City and North Iowa</h2>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">A-1 Drain Cleaning is based in Mason City, Iowa and serves Mason City and surrounding North Iowa communities for drain cleaning and sewer work.</p>
        <a href="/service-area/" class="mt-7 inline-block font-black text-[#b4232b]">See the full service area →</a>
      </div>
    </section>

    <ContactCTA showForm />
    <GoogleBusinessInfo />
  </main>
  <Footer />
</MainLayout>
