---
import MainLayout from '../layouts/MainLayout.astro'; import Header from '../components/Header.astro'; import Hero from '../components/Hero.astro'; import ServicesGrid from '../components/ServicesGrid.astro'; import Problems from '../components/Problems.astro'; import ContactCTA from '../components/ContactCTA.astro'; import Footer from '../components/Footer.astro'; import {serviceAreas} from '../data/serviceAreas';
---
<MainLayout title="Drain Cleaning Mason City Iowa | A-1 Drain Cleaning" description="A-1 Drain Cleaning provides drain cleaning and sewer service in Mason City, Iowa for clogged drains, sewer backups, slow drains, basement floor drains, laundry drains and main sewer lines." path="/" schemaType="Plumber"><Header/><main id="main"><Hero/><section class="bg-[#1A1A68] py-5 text-center text-white"><div class="container font-bold">Homeowners & businesses • Local owner-operator • 641-530-2728</div></section><ServicesGrid/><Problems/><section class="py-14"><div class="container"><p class="font-bold uppercase tracking-wide text-[#D9383A]">Where we work</p><h2 class="brand mt-1 text-4xl text-[#1A1A68]">Mason City and surrounding communities</h2><p class="mt-4 max-w-3xl">A-1 is based in Mason City and travels for drain cleaning and sewer work in North Iowa and nearby communities.</p><div class="mt-6 flex flex-wrap gap-2">{serviceAreas.map(city=><span class="rounded-full border border-gray-300 bg-white px-3 py-1.5 text-sm">{city}</span>)}</div><a class="mt-6 inline-block font-bold text-[#D9383A]" href="/service-area/">See the service area →</a></div></section><ContactCTA/></main><Footer/></MainLayout>
