---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="A-1 Drain Cleaning | Temporarily Down for Maintenance"
  description="A-1 Drain Cleaning is temporarily updating the website. For drain and sewer service, call 641-530-2728."
  path="/"
>
  <main id="main" class="min-h-screen bg-[#1A1A68] text-white">
    <section class="mx-auto flex min-h-screen w-full max-w-4xl items-center justify-center px-6 py-16 text-center">
      <div class="w-full max-w-2xl">
        <p class="text-2xl font-black tracking-tight sm:text-3xl">A-1 Drain Cleaning</p>
        <p class="mt-3 text-sm font-black uppercase tracking-[0.2em] text-red-300">Mason City, Iowa</p>

        <div class="mx-auto mt-10 max-w-xl border border-white/15 bg-white/10 px-6 py-10 shadow-xl sm:px-10 sm:py-12">
          <h1 class="text-4xl font-black leading-tight sm:text-5xl">Website temporarily down for maintenance</h1>
          <p class="mt-5 text-lg leading-8 text-slate-200">
            We are making updates to the website. A-1 Drain Cleaning is still available for drain and sewer service.
          </p>

          <a
            href="tel:+16415302728"
            class="mt-8 inline-flex min-h-14 items-center justify-center rounded-md bg-[#c52b34] px-8 py-4 text-lg font-black text-white shadow-lg hover:bg-[#a82129]"
          >
            CALL 641-530-2728
          </a>

          <p class="mt-6 text-sm leading-6 text-slate-300">
            Drain cleaning • Sewer lines • Floor drains • Main drains
          </p>
          <p class="mt-2 text-sm font-semibold text-slate-300">Mason City and surrounding North Iowa communities</p>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
