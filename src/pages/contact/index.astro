---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<MainLayout
  title="Contact A-1 Drain Cleaning | Mason City Iowa"
  description="Contact A-1 Drain Cleaning in Mason City, Iowa for clogged drains, sewer backups, main drain cleaning, root cutting, cameras and related drain work."
  path="/contact/"
>
  <Header />
  <main id="main">
    <section class="bg-slate-950 py-16 text-white sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Contact A-1</p>
        <h1 class="mt-3 text-5xl font-black tracking-tight sm:text-6xl">Need a drain cleared?</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-200">Call and describe what the water is doing, which fixture is affected, and whether other drains are backing up.</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-xl font-black text-white">CALL 641-530-2728</a>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="container grid gap-10 md:grid-cols-2">
        <address class="not-italic">
          <h2 class="text-3xl font-black tracking-tight text-slate-950">A-1 Drain Cleaning</h2>
          <p class="mt-4 text-lg leading-8 text-slate-700">206 29th St SW<br>Mason City, Iowa 50401</p>
          <p class="mt-5"><a href="tel:+16415302728" class="text-2xl font-black text-[#b4232b] underline underline-offset-4">641-530-2728</a></p>
        </address>

        <article>
          <h2 class="text-3xl font-black tracking-tight text-slate-950">What to tell us</h2>
          <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-slate-700">
            <li>Which drain or fixture is affected.</li>
            <li>Whether the water is slow, stopped, or backing up.</li>
            <li>Whether another drain backs up when water is used.</li>
            <li>Whether wastewater is coming up through a basement floor drain.</li>
          </ul>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
