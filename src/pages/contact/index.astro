---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
---

<MainLayout
  title="Contact A-1 Drain Cleaning | Mason City Iowa"
  description="Contact A-1 Drain Cleaning in Mason City, Iowa for clogged drains, sewer backups, main drain cleaning, root cutting, cameras and related drain work."
  path="/contact/"
>
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] py-14 text-white sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Contact A-1 • Mason City, Iowa</p>
        <h1 class="mt-4 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">Need a drain cleared?</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">Call and describe what the water is doing, which fixture is affected, and whether other drains are backing up.</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL 641-530-2728</a>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="container grid gap-8 lg:grid-cols-2">
        <article class="border border-slate-200 bg-white p-7 shadow-sm sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">A-1 Drain Cleaning</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Mason City, Iowa</h2>
          <address class="mt-5 not-italic text-lg leading-8 text-slate-700">206 29th St SW<br>Mason City, Iowa 50401</address>
          <a href="tel:+16415302728" class="call-button mt-6 inline-block rounded-md bg-[#c52b34] px-6 py-4 text-center font-black text-white">CALL 641-530-2728</a>
        </article>

        <article class="border border-slate-200 bg-slate-50 p-7 sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Before you call</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">What to tell us</h2>
          <ul class="mt-5 grid gap-3">
            <li class="border-l-4 border-[#b4232b] bg-white p-4 font-semibold leading-7 text-slate-700">Which drain or fixture is affected.</li>
            <li class="border-l-4 border-[#b4232b] bg-white p-4 font-semibold leading-7 text-slate-700">Whether the water is slow, stopped, or backing up.</li>
            <li class="border-l-4 border-[#b4232b] bg-white p-4 font-semibold leading-7 text-slate-700">Whether another drain backs up when water is used.</li>
            <li class="border-l-4 border-[#b4232b] bg-white p-4 font-semibold leading-7 text-slate-700">Whether wastewater is coming up through a basement floor drain.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container grid gap-8 md:grid-cols-2">
        <article>
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">What A-1 handles</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Drain and sewer problems</h2>
          <p class="mt-4 leading-8 text-slate-700">Kitchen and bathroom drains, toilets, laundry drains, basement floor drains, main drains, sewer lines, tree roots, sewer backups, cameras, locating and hydro-jetting when appropriate.</p>
        </article>
        <article>
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Service area</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Mason City and North Iowa</h2>
          <p class="mt-4 leading-8 text-slate-700">A-1 is based in Mason City and serves surrounding North Iowa communities. Availability depends on the job and schedule.</p>
          <a href="/service-area/" class="mt-5 inline-block font-black text-[#b4232b]">View service area →</a>
        </article>
      </div>
    </section>

    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
