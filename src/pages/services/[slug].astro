---
import MainLayout from '../../layouts/MainLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import {services} from '../../data/services';
export function getStaticPaths(){ return services.map(service=>({params:{slug:service.slug},props:{service}})); }
const {service}=Astro.props;
const title=`${service.title} | A-1 Drain Cleaning`;
const description=`${service.description} A-1 Drain Cleaning serves Mason City and North Iowa. Call 641-530-2728.`;
---
<MainLayout title={title} description={description} path={`/services/${service.slug}/`} service={service}><Header/><main id="main"><section class="bg-white py-12 md:py-16"><div class="container"><p class="font-bold uppercase tracking-wide text-[#D9383A]">A-1 Drain Cleaning • Mason City, Iowa</p><h1 class="brand mt-2 max-w-4xl text-5xl text-[#1A1A68]">{service.title}</h1><p class="mt-5 max-w-3xl text-xl">{service.description}</p><a href="tel:+16415302728" class="phone-pulse mt-7 inline-block rounded-md bg-[#D9383A] px-6 py-4 text-lg font-bold text-white">Call 641-530-2728</a></div></section><section class="py-14"><div class="container grid gap-10 lg:grid-cols-[1.5fr_.8fr]"><div><h2 class="brand text-3xl text-[#1A1A68]">What can cause this problem?</h2><div class="mt-5 space-y-5">{service.details.map(p=><p class="text-lg leading-8 text-gray-700">{p}</p>)}</div><h2 class="brand mt-10 text-3xl text-[#1A1A68]">Signs the drain may be involved</h2><ul class="mt-5 list-disc space-y-3 pl-6 text-lg text-gray-700">{service.signs.map(s=><li>{s}</li>)}</ul><h2 class="brand mt-10 text-3xl text-[#1A1A68]">Related problems</h2><div class="mt-5 flex flex-wrap gap-2">{service.problems.map(p=><span class="rounded-full bg-gray-100 px-3 py-2 text-sm text-gray-700">{p}</span>)}</div></div><aside class="h-fit rounded-lg bg-[#1A1A68] p-7 text-white"><h2 class="brand text-3xl">Need it cleared?</h2><p class="mt-3">Call A-1 Drain Cleaning and explain what the drain is doing. If more than one fixture is affected, mention that when you call.</p><a href="tel:+16415302728" class="mt-6 inline-block rounded-md bg-[#D9383A] px-5 py-3 font-bold text-white">641-530-2728</a><a href="/services/" class="mt-4 block font-bold underline">See all services</a><a href="/service-area/" class="mt-2 block font-bold underline">Where A-1 works</a></aside></div></section></main><Footer/></MainLayout>
