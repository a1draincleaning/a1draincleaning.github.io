---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const title = `${service.title} | A-1 Drain Cleaning`;
const description = `${service.description} A-1 Drain Cleaning serves Mason City and North Iowa. Call 641-530-2728.`;
const relatedServices = services.filter((item) => item.slug !== service.slug).filter((item) => service.problems.some((problem) => item.problems.some((itemProblem) => itemProblem.toLowerCase().includes(problem.toLowerCase().split(' ')[0])))).slice(0, 3);
---

<MainLayout title={title} description={description} path={`/services/${service.slug}/`} service={service}>
  <Header />
  <main id="main">
    <section class="relative overflow-hidden bg-[#1A1A68] text-white">
      <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(180,35,43,.2),transparent_42%,rgba(255,255,255,.04))]"></div>
      <div class="container relative py-14 sm:py-18 lg:py-24">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Mason City • North Iowa</p>
        <nav aria-label="Breadcrumb" class="mt-4 text-sm font-bold text-slate-300"><a href="/" class="hover:text-white">Home</a><span class="mx-2" aria-hidden="true">/</span><a href="/services/" class="hover:text-white">Services</a><span class="mx-2" aria-hidden="true">/</span><span class="text-white">{service.title}</span></nav>
        <h1 class="mt-5 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">{service.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">{service.description}</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL</a>
      </div>
    </section>

    {service.slug === 'main-drain-cleaning' && (
      <figure class="bg-white py-8 sm:py-10">
        <div class="container">
          <img src="/images/a1-main-sewer-drain-cleaning-mason-city.webp" alt="A-1 Drain Cleaning owner working with a sewer drain cleaning machine in Mason City, Iowa" width="800" height="1200" loading="eager" decoding="async" class="mx-auto w-full max-w-2xl rounded-lg object-cover shadow-lg" />
          <figcaption class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-slate-600">A-1 Drain Cleaning owner working on a main sewer drain in Mason City, Iowa.</figcaption>
        </div>
      </figure>
    )}

    <section class="bg-white py-16 sm:py-20"><div class="container grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start"><article><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">About this drain problem</p><h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What can cause this problem?</h2><div class="mt-6 space-y-5">{service.details.map((paragraph) => (<p class="text-lg leading-8 text-slate-700">{paragraph}</p>))}</div><h2 class="mt-12 text-3xl font-black tracking-tight text-slate-950">Signs the drain may be involved</h2><ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul></article><aside class="border border-slate-200 bg-[#1A1A68] p-7 text-white shadow-xl sm:p-8"><p class="text-sm font-black uppercase tracking-[0.18em] text-red-300">What A-1 looks for</p><h2 class="mt-2 text-3xl font-black">Tell us what the water is doing.</h2><p class="mt-4 leading-7 text-slate-300">Tell A-1 which fixture is affected, whether it is slow or stopped, and whether other drains back up when water is used.</p><a href="tel:+16415302728" class="call-button mt-6 block rounded-md bg-[#c52b34] px-5 py-4 text-center font-black text-white">CALL</a><a href="/services/" class="mt-5 block font-black text-white underline underline-offset-4">See all drain services</a><a href="/service-area/" class="mt-3 block font-black text-white underline underline-offset-4">See the North Iowa service area</a></aside></div></section>
    <section class="bg-slate-100 py-16 sm:py-20"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Related problems</p><h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What else can be connected?</h2><div class="mt-8 flex flex-wrap gap-2">{service.problems.map((problem) => (<span class="border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700">{problem}</span>))}</div>{relatedServices.length > 0 && (<div class="mt-12 grid gap-4 sm:grid-cols-3">{relatedServices.map((related) => (<a href={`/services/${related.slug}/`} class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">{related.title} →</a>))}</div>)}</div></section>
    <section class="bg-white py-16 sm:py-20"><div class="container grid gap-8 lg:grid-cols-2"><article><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Equipment & methods</p><h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">The equipment depends on the line.</h2><p class="mt-4 leading-8 text-slate-700">A-1 uses drain-cleaning cables, root-cutting equipment, sewer cameras, line locating equipment, and hydro-jetting when the pipe and problem call for it.</p></article><article><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">North Iowa</p><h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Mason City and surrounding communities</h2><p class="mt-4 leading-8 text-slate-700">A-1 is based in Mason City and serves North Iowa for drain cleaning and sewer work. Availability depends on the job and schedule.</p><a href="/service-area/" class="mt-5 inline-block font-black text-[#b4232b]">View service area →</a></article></div></section>
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
