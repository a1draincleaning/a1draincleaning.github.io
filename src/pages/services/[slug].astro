---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services } from '../../data/services';
import { uniqueServiceAreaCities } from '../../data/serviceAreaCities';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const title = service.slug === 'washing-machine-basement-flooding'
  ? 'Washing Machine Drain Backup | A-1 Drain Cleaning'
  : service.slug === 'laundry-drains'
    ? 'Laundry Drain Cleaning | A-1 Drain Cleaning'
    : `${service.title} | A-1 Drain Cleaning`;
const description = service.slug === 'washing-machine-basement-flooding'
  ? 'Washing machine draining and flooding the basement? A-1 Drain Cleaning clears backed-up drain lines in Mason City and North Iowa. Call 641-530-2728.'
  : service.slug === 'laundry-drains'
    ? 'Washing machine drain overflowing or laundry standpipe backing up? A-1 Drain Cleaning clears laundry drains in Mason City and North Iowa. Call 641-530-2728.'
    : `${service.description} A-1 Drain Cleaning serves Mason City and North Iowa. Call 641-530-2728.`;
const relatedServiceMap: Record<string, string[]> = {
  'main-drain-cleaning': ['sewer-line-cleaning', 'basement-floor-drains', 'sewer-backup-emergency'],
  'sewer-line-cleaning': ['main-drain-cleaning', 'tree-roots-in-sewer-line', 'basement-floor-drains'],
  'tree-roots-in-sewer-line': ['sewer-line-cleaning', 'main-drain-cleaning', 'drain-repair'],
  'hydro-jetting': ['main-drain-cleaning', 'sewer-line-cleaning', 'drain-repair'],
  'basement-floor-drains': ['main-drain-cleaning', 'sewer-line-cleaning', 'washing-machine-basement-flooding', 'laundry-drains', 'sewer-backup-emergency'],
  'washing-machine-basement-flooding': ['basement-floor-drains', 'laundry-drains', 'main-drain-cleaning'],
  'laundry-drains': ['washing-machine-basement-flooding', 'basement-floor-drains', 'main-drain-cleaning'],
  'sewer-backup-emergency': ['main-drain-cleaning', 'sewer-line-cleaning', 'basement-floor-drains'],
  'sewer-backup-into-tub-shower': ['main-drain-cleaning', 'sewer-line-cleaning', 'basement-floor-drains', 'laundry-drains', 'sewer-backup-emergency'],
  'toilet-clogs': ['main-drain-cleaning', 'sewer-line-cleaning', 'basement-floor-drains'],
  'kitchen-bathroom-drains': ['main-drain-cleaning', 'toilet-clogs', 'laundry-drains'],
  'drain-repair': ['sewer-line-cleaning', 'tree-roots-in-sewer-line', 'hydro-jetting'],
  'septic-lines': ['main-drain-cleaning', 'sewer-line-cleaning', 'sewer-backup-emergency'],
  'roof-vent-drains': ['kitchen-bathroom-drains', 'toilet-clogs', 'main-drain-cleaning'],
  'garbage-disposal': ['kitchen-bathroom-drains', 'drain-repair', 'main-drain-cleaning'],
  'dishwasher-drain': ['kitchen-bathroom-drains', 'garbage-disposal', 'main-drain-cleaning'],
  'sump-pumps': ['sewer-backup-emergency', 'basement-floor-drains']
};
const relatedServices = (relatedServiceMap[service.slug] || [])
  .map((slug) => services.find((item) => item.slug === slug))
  .filter((item): item is typeof services[number] => Boolean(item));
const floorDrainClusterSlugs = ['main-drain-cleaning', 'sewer-line-cleaning', 'washing-machine-basement-flooding', 'laundry-drains', 'sewer-backup-emergency', 'sewer-backup-into-tub-shower'];
const featuredServiceCitySlugs = ['mason-city', 'clear-lake', 'charles-city', 'forest-city', 'garner', 'northwood', 'nora-springs', 'rockwell', 'hampton', 'greene'];
const featuredServiceCities = uniqueServiceAreaCities.filter((city) => featuredServiceCitySlugs.includes(city.slug));

const servicePageImages: Record<string, { src: string; alt: string; caption: string }> = {
  'main-drain-cleaning': {
    src: '/images/a1-main-sewer-drain-cleaning-mason-city.webp',
    alt: 'A-1 Drain Cleaning main sewer drain cleaning in Mason City, Iowa',
    caption: 'A-1 Drain Cleaning main sewer drain cleaning in Mason City, Iowa.'
  },
  'sewer-line-cleaning': {
    src: '/images/sewer-drain-mason-city-iowa.jpg',
    alt: 'Sewer drain cleaning in Mason City, Iowa',
    caption: 'Sewer drain cleaning in Mason City, Iowa.'
  },
  'tree-roots-in-sewer-line': {
    src: '/images/tree-root-removal-mason-city-iowa.jpg',
    alt: 'Tree roots removed from a sewer line in Mason City, Iowa',
    caption: 'Tree roots removed from a sewer line in Mason City, Iowa.'
  },
  'basement-floor-drains': {
    src: '/images/floor-drain-backing-up-iowa.jpg',
    alt: 'Basement floor drain backing up in Iowa',
    caption: 'Basement floor drain backup in Iowa.'
  },
  'sewer-backup-emergency': {
    src: '/images/iowa-drain-cleaning-a1-drain-cleaning.png',
    alt: 'A-1 Drain Cleaning sewer backup emergency service in Iowa',
    caption: 'A-1 Drain Cleaning sewer backup emergency service in Iowa.'
  }
};
const servicePageImage = servicePageImages[service.slug];
---

<MainLayout title={title} description={description} path={`/services/${service.slug}/`} service={service}>
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] text-white">
      <div class="container py-14 sm:py-18 lg:py-24">
        <nav aria-label="Breadcrumb" class="text-sm font-bold text-slate-300"><a href="/" class="hover:text-white">Home</a><span class="mx-2" aria-hidden="true">/</span><a href="/services/" class="hover:text-white">Services</a><span class="mx-2" aria-hidden="true">/</span><span class="text-white">{service.title}</span></nav>
        <p class="mt-5 text-sm font-black uppercase tracking-[0.2em] text-red-300">Mason City • North Iowa</p>
        <h1 class="mt-3 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">{service.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">{service.description}</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL 641-530-2728</a>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="container grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start">
        <article>
          {servicePageImage && (
            <figure class="mb-10 overflow-hidden rounded-lg border border-slate-200 bg-slate-50 shadow-md">
              <img src={servicePageImage.src} alt={servicePageImage.alt} loading="eager" decoding="async" class="block h-auto w-full" />
              <figcaption class="px-5 py-4 text-sm leading-6 text-slate-600">{servicePageImage.caption}</figcaption>
            </figure>
          )}
          {service.slug === 'main-drain-cleaning' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Main drain problems</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">When the main drain is blocked, the whole house can be affected</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">The main drain carries wastewater from the house toward the city sewer or a septic system. When that line is restricted, water from toilets, sinks, tubs, showers, and the washing machine may not have a clear path out. Instead of showing up at one clogged fixture, the problem can appear at several drains or at the lowest drain in the house.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Older sewer pipes: Orangeburg and clay tile</h2>
              <p class="mt-4 leading-8 text-slate-700">Residential main drains are commonly 3 or 4 inches in diameter. Older properties may have 6-inch clay tile sewer lines or 4-inch Orangeburg pipe. Orangeburg is a bitumen-impregnated fiber pipe, not clay tile, and age or soil pressure can cause it to deform or collapse. The actual pipe size and material depend on the property, and size alone does not identify the cause of a blockage.</p>
              <p class="mt-5 text-lg leading-8 text-slate-700">A-1 Drain Cleaning clears blocked main drains in Mason City and North Iowa. The first clues are what is backing up, which fixtures are affected, and what was happening when the problem started.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Signs your main drain may be blocked</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul>
              <p class="mt-5 leading-8 text-slate-700">One slow sink is often a local fixture or branch-drain problem. When several fixtures act up together, or wastewater comes up through a floor drain or tub, the restriction may be farther down the shared drain system. A toilet does not have to bubble or gurgle for a main-line blockage to be present.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">What causes a main drain blockage?</h2>
              <p class="mt-5 leading-8 text-slate-700">Grease and waste can collect inside a pipe and catch paper or other material. Tree roots can enter through pipe joints or damaged sections, then catch debris and reduce the opening. A damaged, shifted, or collapsed pipe can also restrict flow. The symptoms can look similar, but the right fix depends on what is actually blocking the line and the condition of the pipe.</p>
              <p class="mt-4 leading-8 text-slate-700">If the same line keeps plugging up after it has been cleared, that is useful information. The blockage may be returning, roots may be growing back into the pipe, or the line may have a condition that cleaning alone will not repair.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">How A-1 Drain Cleaning clears the main drain</h2>
              <p class="mt-5 leading-8 text-slate-700">We use drain-cleaning equipment to reach the restriction and open a path for wastewater to flow. The equipment and approach depend on the blockage, the pipe, and access to the line. Grease and accumulated waste, tree roots, and a damaged pipe are different problems; opening the line does not automatically repair damage in the pipe itself.</p>
              <p class="mt-4 leading-8 text-slate-700">If a blockage keeps returning or the condition of the underground line needs to be checked, a sewer camera inspection may help identify what is happening inside the pipe. It is not automatically needed for every drain cleaning.</p>
              <p class="mt-4 leading-8 text-slate-700">When you call, tell us which drains are affected, whether water is coming up anywhere, and whether the problem starts when a toilet is flushed or the washing machine drains. Those details help narrow down where the restriction may be.</p>
            </>
          ) : service.slug === 'sewer-line-cleaning' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Sewer line problems</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">When wastewater cannot get out of the house</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">The sewer line carries wastewater from the home's drain system to the city sewer or septic connection. When that line is blocked or restricted, the problem can affect several fixtures at once. Water may come back through a basement floor drain, toilet, shower, or bathtub instead of leaving the house.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Older sewer line materials and pipe sizes</h2>
              <p class="mt-4 leading-8 text-slate-700">Many residential building sewer lines are 4 inches in diameter. Older properties may have 6-inch clay tile sewer lines or 4-inch Orangeburg pipe. Orangeburg is made from bitumen-impregnated fiber and can deform or collapse as it ages; it is a different material from clay tile. Actual size and material vary by property, and a pipe's diameter does not show whether the problem is grease, roots, a foreign object, or pipe damage.</p>
              <p class="mt-5 text-lg leading-8 text-slate-700">A-1 Drain Cleaning clears blocked sewer lines in Mason City and North Iowa. The location of the backup, which fixtures are affected, and when the problem happens help distinguish a sewer-line restriction from a clog at one sink or toilet.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Signs the sewer line may be blocked</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul>
              <p class="mt-5 leading-8 text-slate-700">One fixture draining slowly often points to a local clog. When several fixtures back up together, or the lowest drain fills when water is used elsewhere, the restriction may be in a shared line or the sewer line leaving the house.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">What can block a sewer line?</h2>
              <p class="mt-5 leading-8 text-slate-700">Grease, waste, and other material can build up inside a pipe and catch more debris. Tree roots can enter through joints or damaged sections and narrow the opening. A shifted, cracked, or collapsed section can also restrict flow. These problems may cause similar symptoms, but they do not all have the same solution.</p>
              <p class="mt-4 leading-8 text-slate-700">If the line has been cleared before and backs up again, tell us how soon the problem returned. A repeat blockage can mean material is building up again, roots are entering the pipe, or the pipe needs closer inspection.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">How A-1 Drain Cleaning handles a sewer-line blockage</h2>
              <p class="mt-5 leading-8 text-slate-700">We use drain-cleaning equipment to reach and clear the restriction. The approach depends on where the blockage is, the type and condition of the pipe, and access to the line. Clearing the line restores a path for wastewater, but it does not repair a broken or collapsed pipe.</p>
              <p class="mt-4 leading-8 text-slate-700">A sewer camera inspection can help when a blockage keeps returning or the pipe's condition needs to be checked. It is not automatically required for every cleaning.</p>
            </>
          ) : service.slug === 'tree-roots-in-sewer-line' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Tree roots in sewer lines</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Roots can turn a small opening in a sewer pipe into a recurring blockage</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">Tree roots usually get into a sewer line through an existing opening, such as a pipe joint, crack, or damaged section. They can catch toilet paper and other waste, narrow the passage, and slow wastewater leaving the house.</p>
              <p class="mt-5 text-lg leading-8 text-slate-700">A-1 Drain Cleaning removes root blockages in sewer lines in Mason City and North Iowa. Cutting roots out can reopen the pipe, but it does not seal the entry point or repair damaged pipe.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Signs tree roots may be blocking the sewer line</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul>
              <p class="mt-5 leading-8 text-slate-700">Symptoms can also be caused by grease, accumulated waste, or a damaged pipe. Symptoms alone cannot prove that roots are the cause.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">How roots get into sewer pipes</h2>
              <p class="mt-5 leading-8 text-slate-700">Roots grow toward moisture in the soil. If a sewer pipe has an open joint or crack, moisture escaping there can attract root growth into the opening. Once roots enter the pipe, they can catch paper and waste and restrict flow.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">How A-1 Drain Cleaning clears roots</h2>
              <p class="mt-5 leading-8 text-slate-700">A-1 uses drain-cleaning equipment to cut through roots that are blocking the line and restore a path for wastewater. Opening the pipe helps wastewater flow, but root removal is not the same as repairing a crack, separated joint, or collapsed section.</p>
              <p class="mt-4 leading-8 text-slate-700">If the line has plugged repeatedly or the pipe condition is uncertain, a sewer camera inspection can help show whether roots are present and whether the pipe has visible damage.</p>
            </>
          ) : service.slug === 'hydro-jetting' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Hydro jetting for drains and sewer lines</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Cleaning buildup from inside the pipe</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">Hydro jetting uses high-pressure water to remove suitable buildup from the inside of a drain or sewer line. It can help when grease, sludge, or accumulated debris is narrowing the passage and ordinary cable cleaning has not fully addressed the problem. It is not the right method for every clog or every pipe.</p>
              <p class="mt-5 text-lg leading-8 text-slate-700">A-1 Drain Cleaning serves Mason City and North Iowa. The decision to use water jetting depends on the type of blockage, access to the line, and the pipe's condition.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">When hydro jetting may help</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul>
              <p class="mt-5 leading-8 text-slate-700">A single slow sink may have a local blockage that does not need jetting. If several fixtures back up together or wastewater comes up through a floor drain, the restriction may be farther down a shared drain or the main sewer line.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Hydro jetting compared with cable drain cleaning</h2>
              <p class="mt-5 leading-8 text-slate-700">A drain cable is used to reach and break through or cut certain blockages. Hydro jetting uses pressurized water to clean material from the pipe's interior. The methods do different jobs, and the right choice depends on what is blocking the line and what condition the pipe is in.</p>
            </>
          ) : service.slug === 'basement-floor-drains' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Floor drain backup help</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">When sewage or water comes up through the basement floor drain</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">A floor drain is often the first place a main drain blockage shows up because it sits low in the house. If wastewater rises through the floor drain when a toilet is flushed, a sink is used, or the washing machine empties, the blockage may be farther down a shared drain line. The floor drain is where you see the backup; it is not automatically where the blockage is.</p>
              <p class="mt-4 leading-8 text-slate-700">Floor-drain connections and branch-pipe sizes vary by installation. The visible drain grate does not tell you the size or condition of the pipe farther downstream.</p>
              <p class="mt-5 text-lg leading-8 text-slate-700">A-1 Drain Cleaning clears floor-drain and main-drain blockages in Mason City and North Iowa. The important clues are when the water rises, which fixtures are being used, and whether other drains are affected too.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">What the floor drain is telling you</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul>
              <h3 class="mt-8 text-2xl font-black tracking-tight text-slate-950">The floor drain rises when the washing machine drains</h3>
              <p class="mt-3 leading-8 text-slate-700">A washing machine sends a large amount of water into the drain in a short time. If water comes up through the floor drain during the drain cycle, the washer may simply be exposing a restriction farther down the line.</p>
              <h3 class="mt-8 text-2xl font-black tracking-tight text-slate-950">The floor drain backs up when a toilet is flushed or a sink is used</h3>
              <p class="mt-3 leading-8 text-slate-700">When one fixture sends water into a restricted shared line, the water can rise at a lower opening.</p>
              <section class="mt-10 border-l-4 border-[#b4232b] bg-slate-50 p-6" aria-labelledby="floor-drain-backup-steps">
                <h2 id="floor-drain-backup-steps" class="text-2xl font-black tracking-tight text-slate-950">What to do during an active floor drain backup</h2>
                <ul class="mt-4 list-disc space-y-2 pl-6 leading-7 text-slate-700">
                  <li>Stop using water where possible.</li>
                  <li>Keep children and pets away from wastewater.</li>
                  <li>Do not enter standing water if electrical equipment may be affected.</li>
                  <li>Tell us where the water is coming up and what fixtures were being used.</li>
                </ul>
                <p class="mt-4 leading-7 text-slate-700">Call <a href="tel:+16415302728" class="font-bold text-[#b4232b] underline underline-offset-4">641-530-2728</a> for A-1 Drain Cleaning.</p>
              </section>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Floor drain backups in Mason City and North Iowa</h2>
              <p class="mt-4 leading-8 text-slate-700">A-1 Drain Cleaning serves Mason City and North Iowa. When you call, tell us whether the floor drain backs up during laundry, when another fixture is used, or even when no water is running.</p>
            </>
          ) : (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">About this drain problem</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What can cause this problem?</h2>
              <div class="mt-6 space-y-5">{service.details.map((paragraph) => (<p class="text-lg leading-8 text-slate-700">{paragraph}</p>))}</div>
              {service.slug === 'kitchen-bathroom-drains' && (
                <section class="mt-8 border-l-4 border-[#b4232b] bg-slate-50 p-6" aria-labelledby="fixture-drain-sizes">
                  <h2 id="fixture-drain-sizes" class="text-2xl font-black tracking-tight text-slate-950">Common sink, tub, and shower drain sizes</h2>
                  <p class="mt-3 leading-7 text-slate-700">Kitchen sinks commonly connect to 1½- or 2-inch drain piping. Bathroom sinks often use 1¼- or 1½-inch piping, while tubs and showers commonly use 1½- or 2-inch drains. Actual sizes vary by fixture, age of the plumbing, and local installation.</p>
                </section>
              )}
              {service.slug === 'toilet-clogs' && (
                <section class="mt-8 border-l-4 border-[#b4232b] bg-slate-50 p-6" aria-labelledby="toilet-drain-size">
                  <h2 id="toilet-drain-size" class="text-2xl font-black tracking-tight text-slate-950">Typical toilet drain pipe size</h2>
                  <p class="mt-3 leading-7 text-slate-700">Toilets commonly connect to a 3-inch drain, and some installations use 4-inch piping. A toilet that will not flush may have a clog in the toilet trap, the branch drain, or farther down the main drain.</p>
                </section>
              )}
              {floorDrainClusterSlugs.includes(service.slug) && (
                <div class="mt-8 border-l-4 border-[#b4232b] bg-slate-50 p-6">
                  <h2 class="text-2xl font-black tracking-tight text-slate-950">Floor drain backup can be part of a larger blockage</h2>
                  <p class="mt-3 leading-7 text-slate-700">If wastewater is coming up through a floor drain, especially when the washing machine drains or another fixture is used, the restriction may be farther down the shared drain or main sewer line.</p>
                  <a href="/services/basement-floor-drains/" class="mt-4 inline-block font-black text-[#b4232b] underline underline-offset-4">See floor drain backup causes and symptoms →</a>
                </div>
              )}
              <h2 class="mt-12 text-3xl font-black tracking-tight text-slate-950">Signs the drain may be involved</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul>
            </>
          )}
        </article>
        <aside class="border border-slate-200 bg-[#1A1A68] p-7 text-white shadow-xl sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-red-300">What A-1 Drain Cleaning looks for</p>
          <h2 class="mt-2 text-3xl font-black !text-white">Tell us what the water is doing.</h2>
          <p class="mt-4 leading-7 !text-white">Tell A-1 Drain Cleaning which fixture is affected, whether it is slow or stopped, and whether other drains back up when water is used.</p>
          <a href="tel:+16415302728" class="call-button mt-6 block rounded-md bg-[#c52b34] px-5 py-4 text-center font-black !text-white">CALL 641-530-2728</a>
          <a href="/services/" class="mt-5 block font-black text-white underline underline-offset-4">See all drain services</a>
          <a href="/service-area/" class="mt-3 block font-black text-white underline underline-offset-4">See the North Iowa service area</a>
        </aside>
      </div>
    </section>

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Related problems</p>
        <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What else can be connected?</h2>
        <div class="mt-8 flex flex-wrap gap-2">{service.problems.map((problem) => (<span class="border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700">{problem}</span>))}</div>
        {service.slug === 'basement-floor-drains' && (
          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <a href="/services/main-drain-cleaning/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Main drain cleaning →</a>
            <a href="/services/sewer-line-cleaning/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Sewer line cleaning →</a>
            <a href="/services/laundry-drains/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Laundry drain problems →</a>
            <a href="/services/sewer-backup-emergency/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Sewer backup emergency service →</a>
          </div>
        )}
        {relatedServices.length > 0 && (<div class="mt-12 grid gap-4 sm:grid-cols-3">{relatedServices.map((related) => (<a href={`/services/${related.slug}/`} class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">{related.title} →</a>))}</div>)}
      </div>
    </section>

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Service towns</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Drain cleaning in Mason City and nearby Iowa communities</h2>
        <p class="mt-4 max-w-3xl leading-8 text-slate-700">A-1 Drain Cleaning serves Mason City and communities across North Iowa. Choose a town below to read its local drain-cleaning and sewer-service information.</p>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
          {featuredServiceCities.map((city) => (
            <a href={`/service-area/${city.slug}/`} class="border border-slate-200 bg-white px-4 py-4 font-bold text-[#1A1A68] underline underline-offset-4 hover:border-[#b4232b] hover:text-[#b4232b]">{city.name}, Iowa</a>
          ))}
        </div>
        <a href="/service-area/" class="mt-6 inline-block font-black text-[#b4232b] underline underline-offset-4">View all North Iowa service towns →</a>
      </div>
    </section>
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>