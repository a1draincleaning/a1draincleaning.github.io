---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services } from '../../data/services';
import { uniqueServiceAreaCities } from '../../data/serviceAreaCities';
import {
  servicePageTitles,
  servicePageDescriptions,
  relatedServiceSlugs,
  floorDrainClusterSlugs,
  featuredServiceCitySlugs,
} from '../../data/servicePageConfig';

export function getStaticPaths() {
  const retiredServiceSlugs = new Set([
    'drain-repair',
    'washing-machine-basement-flooding',
    'kitchen-bathroom-drains',
  ]);
  const staticServiceSlugs = new Set([
    'drain-cleaning',
    'kitchen-drains',
    'bathroom-shower-drains',
  ]);

  return services
    .filter((service) => !retiredServiceSlugs.has(service.slug) && !staticServiceSlugs.has(service.slug))
    .map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const title =
  servicePageTitles[service.slug] ??
  `${service.title} | A-1 Drain Cleaning`;
const description =
  servicePageDescriptions[service.slug] ??
  `${service.description} A-1 Drain Cleaning serves Mason City and North Iowa. Call 641-530-2728.`;
const canonicalServiceLinks = new Map([
  ['kitchen-drains', { slug: 'kitchen-drains', title: 'Kitchen Drains' }],
  ['bathroom-shower-drains', { slug: 'bathroom-shower-drains', title: 'Bathroom & Shower Drains' }],
  ['pipe-repair', { slug: 'pipe-repair', title: 'Drain & Sewer Pipe Repair' }],
]);
const relatedServices = (relatedServiceSlugs[service.slug] || [])
  .map((slug) => services.find((item) => item.slug === slug) ?? canonicalServiceLinks.get(slug))
  .filter((item): item is { slug: string; title: string } => Boolean(item));
const featuredServiceCities = uniqueServiceAreaCities.filter((city) => featuredServiceCitySlugs.includes(city.slug));
const pageFaqs: Record<string, { question: string; answer: string }[]> = {
  'main-drain-cleaning': [
    { question: 'Why does water come up through the basement floor drain?', answer: 'The floor drain is often one of the lowest openings in a basement. If a shared drain or main line cannot carry wastewater away, it may rise through that opening. The blockage is not necessarily under the floor drain.' },
    { question: 'How can I tell whether it is a fixture clog or a main drain problem?', answer: 'A single slow sink or one toilet that will not flush may have a local fixture or branch-drain clog. When several fixtures back up together, or one fixture causes wastewater to rise somewhere else, the restriction may be farther down a shared drain or main line.' },
    { question: 'Can a washing machine cause a main drain backup?', answer: 'The washer may expose a restriction rather than cause it. A washing machine discharges a large amount of water in a short time. If the downstream line cannot carry that water away, the standpipe or another connected low drain may overflow.' },
    { question: 'Can a main drain blockage affect a home without a basement?', answer: 'Yes. In a slab home or a house without a basement floor drain, wastewater may back up through a bathtub or shower. The fixture where the backup appears does not by itself prove where the restriction is located.' },
    { question: 'Does a toilet have to bubble or gurgle when the main drain is blocked?', answer: 'No. A toilet may bubble or gurgle when air and wastewater are moving through a restricted drain system, but bubbling is not required and does not identify the exact blockage location.' },
    { question: 'Will main drain cleaning repair a cracked or collapsed pipe?', answer: 'No. Cleaning removes a blockage and restores a path for wastewater, but it does not repair a cracked, separated, deformed, or collapsed pipe. A damaged section may need a separate repair.' },
    { question: 'When is a sewer camera inspection useful?', answer: 'A camera inspection may help when the same line keeps backing up, roots or pipe damage are suspected, or the pipe condition will affect the next step. It is not automatically necessary for every clogged drain.' },
    { question: 'What should I do while wastewater is backing up?', answer: 'Stop using water where possible, do not keep flushing or running the washer to test the drain, and keep people and pets away from sewage. Do not enter standing water if electrical equipment or outlets may be affected.' },
  ],
  'sewer-line-cleaning': [
    { question: 'How can I tell if the sewer line is blocked?', answer: 'Several fixtures backing up together, or wastewater rising at a low drain when water is used elsewhere, can point to a shared line or sewer-line restriction.' },
    { question: 'Will cleaning repair a damaged sewer pipe?', answer: 'No. Cleaning can remove material blocking the pipe, but a cracked, separated, or collapsed section may need repair.' },
    { question: 'Do I need a camera inspection every time?', answer: 'No. A camera can be useful when the blockage returns or the pipe’s condition is uncertain. It is not automatically needed for every cleaning.' },
    { question: 'What should I do while sewage is backing up?', answer: 'Stop using water where possible, avoid contact with sewage, and keep people and pets away from the affected area until the backup is addressed.' },
  ],
  'tree-roots-in-sewer-line': [
    { question: 'Can tree roots get into a sewer pipe that is still draining?', answer: 'Yes. Roots can narrow the opening and catch waste before the pipe becomes completely blocked. Early symptoms may include a recurring slow drain or repeated backups.' },
    { question: 'Will tree roots return after removal?', answer: 'Removing tree roots can reopen the line, but it does not close the joint or repair the crack where roots entered. A damaged entry point can allow another root blockage to develop.' },
    { question: 'How can I tell whether roots are the cause?', answer: 'Recurring blockages can raise suspicion, but symptoms alone do not confirm roots. A sewer camera inspection may help identify roots and show the visible condition of the pipe.' },
    { question: 'Does a sewer line always need to be replaced if roots get in?', answer: 'No. The next step depends on the amount of blockage and the condition of the pipe. Cleaning may restore flow; repair decisions depend on whether the pipe is damaged and how severe that damage is.' },
  ],
  'hydro-jetting': [
    { question: 'Does every clogged drain need hydro jetting?', answer: 'No. Many clogs can be cleaned with other equipment. Jetting is considered when the blockage and pipe conditions make it a suitable option.' },
    { question: 'Can hydro jetting remove tree roots?', answer: 'Roots may need to be removed with suitable tree root removal equipment. The best method depends on the root blockage and pipe condition; jetting is not a universal substitute for tree root removal.' },
    { question: 'Will hydro jetting repair a cracked or collapsed sewer pipe?', answer: 'No. Jetting is a cleaning method. A cracked, separated, or collapsed pipe may require repair rather than more cleaning.' },
    { question: 'When might a camera inspection help?', answer: 'It may help when the blockage repeatedly returns or the condition of the line is uncertain and that information would affect the cleaning approach.' },
  ],
  'basement-floor-drains': [
    { question: 'Why does sewage come up through the floor drain first?', answer: 'The floor drain is low in the house. If a shared drain or main sewer line is blocked, wastewater can rise through that low opening rather than continue out of the house.' },
    { question: 'Does a backed-up floor drain mean the floor drain itself is clogged?', answer: 'Not necessarily. The restriction can be in the floor-drain branch, a shared drain line, or the main sewer line. The timing and other affected fixtures help narrow down the likely location.' },
    { question: 'Why does the backup happen when the washer drains?', answer: 'The washer releases a large volume of water quickly. A restricted line may handle smaller amounts but back up when the washer empties.' },
    { question: 'What if the floor drain backs up again after cleaning?', answer: 'A recurring backup may need further investigation to check for repeated buildup, roots, or pipe damage. Cleaning restores flow through a blockage but does not repair damaged pipe.' },
  ],
};
---

<MainLayout title={title} description={description} path={`/services/${service.slug}/`} service={service} faqs={pageFaqs[service.slug]}>
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] text-white">
      <div class="container py-14 sm:py-18 lg:py-24">
        <nav aria-label="Breadcrumb" class="text-sm font-bold text-slate-300"><a href="/" class="hover:text-white">Home</a><span class="mx-2" aria-hidden="true">/</span><a href="/services/" class="hover:text-white">Services</a><span class="mx-2" aria-hidden="true">/</span><span class="text-white">{service.title}</span></nav>
        <p class="mt-5 text-sm font-black uppercase tracking-[0.2em] text-red-300">Mason City • North Iowa</p>
        <h1 class="mt-3 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">{service.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">{service.description}</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL 641-530-2728</a>
      </div>
    </section>

    {service.slug === 'main-drain-cleaning' && (
      <figure class="bg-white py-8 sm:py-10">
        <div class="container">
          <div class="mx-auto w-full max-w-[260px] sm:max-w-xs overflow-hidden rounded-lg shadow-lg">
            <img src="/images/sewer-drain-mason-city-iowa.jpg" alt="A sewer drain cleaning machine in use" width="663" height="1142" loading="eager" decoding="async" class="block w-full object-cover" />
          </div>
          <figcaption class="mx-auto mt-3 max-w-[260px] sm:max-w-xs text-sm leading-6 text-slate-600">A main sewer drain cleaning job in Mason City, Iowa.</figcaption>
        </div>
      </figure>
    )}

    <section class="bg-white py-16 sm:py-20">
      <div class="container grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start">
        <article>
          {service.slug === 'emergency-drain-cleaning' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Emergency drain cleaning</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">When a drain stops working or starts overflowing</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">A stopped toilet, sink, bathtub, shower, laundry drain, or floor drain can disrupt the whole house. A-1 Drain Cleaning offers 24/7 service for urgent drain problems in Mason City and North Iowa. Call 641-530-2728 and explain which fixture is affected and whether water is standing, rising, or overflowing.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">What to tell us when you call</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}
              </ul>
              <p class="mt-5 leading-8 text-slate-700">Tell us whether the problem is limited to one fixture or whether other drains are affected. Mention any water on the floor, sewage coming up through a low drain, or a toilet that is close to overflowing. Stop using the affected fixture while water is rising.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">A clogged fixture or a sewer backup?</h2>
              <p class="mt-4 leading-8 text-slate-700">A single stopped sink, toilet, tub, or shower may be a fixture or branch-drain problem. Several fixtures backing up together, or wastewater coming up through a basement floor drain, can indicate a main drain or sewer-line problem. Those situations need to be described as a possible sewer backup when you call.</p>
              <p class="mt-4 leading-8 text-slate-700">For wastewater backing up through several fixtures or a low drain, see <a href="/services/sewer-backup-emergency/" class="font-bold text-[#b4232b] underline underline-offset-4">emergency sewer backup service</a>, <a href="/services/basement-floor-drains/" class="font-bold text-[#b4232b] underline underline-offset-4">basement floor drain backups</a>, and <a href="/services/main-drain-cleaning/" class="font-bold text-[#b4232b] underline underline-offset-4">main drain cleaning</a>.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Emergency drain cleaning in Mason City and North Iowa</h2>
              <p class="mt-4 leading-8 text-slate-700">A-1 Drain Cleaning is based in Mason City, Iowa and serves nearby North Iowa communities. Call 641-530-2728 for current service availability. Explain the fixture, the symptoms, and whether the problem is getting worse.</p>
            </>
          ) : service.slug === 'sewer-camera-inspection' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Drain and sewer camera inspections</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Look inside the line when a recurring problem needs more answers</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">A sewer camera inspection lets a technician view the inside of an accessible drain or sewer line. It can help investigate a blockage that keeps returning, a suspected damaged section, or a problem that cleaning alone has not explained.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">When a camera inspection may help</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}
              </ul>
              <p class="mt-5 leading-8 text-slate-700">The camera may show roots, buildup, standing water, a visible break, or another condition inside the portion of pipe it can reach. The inspection is useful when the result can help determine the next step—not something every routine clogged drain automatically needs.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">What a camera inspection does not do</h2>
              <p class="mt-4 leading-8 text-slate-700">A camera inspection is a visual check. It does not clean a blocked line or repair a damaged pipe. Debris, standing water, access limitations, and the condition of the pipe can limit what is visible. Findings describe the portion of line that can be inspected; they are not a guarantee about every buried section.</p>
              <p class="mt-4 leading-8 text-slate-700">If the line needs to be traced from above ground, ask about <a href="/services/sewer-line-locating/" class="font-bold text-[#b4232b] underline underline-offset-4">sewer line locating</a>. If the camera shows a recurring blockage or visible damage, the next step depends on what is actually found.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Camera inspections in Mason City and North Iowa</h2>
              <p class="mt-4 leading-8 text-slate-700">A-1 Drain Cleaning provides drain and sewer camera inspections in Mason City and North Iowa. Call 641-530-2728 and describe the repeated blockage or pipe concern so we can discuss whether an inspection makes sense.</p>
            </>
          ) : service.slug === 'sewer-line-locating' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Sewer line locating</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Find the route of an underground drain or sewer line</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">Sewer line locating helps identify the approximate route or location of an accessible underground drain or sewer line. It can be useful when the pipe needs to be found for further inspection or repair, or when the route is not known.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">When line locating may be useful</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}
              </ul>
              <p class="mt-5 leading-8 text-slate-700">The locating process depends on access to the line, the pipe material, the signal or method available, and surrounding conditions. The result is an approximate route or point of interest—not a promise of exact depth or a substitute for utility locating and required underground utility marking before digging.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Locating and camera inspection work together</h2>
              <p class="mt-4 leading-8 text-slate-700">A camera inspection can show visible conditions inside an accessible line. Locating can help identify where the line or a point of interest runs below ground. They answer different questions and may be used together when the job calls for both.</p>
              <p class="mt-4 leading-8 text-slate-700">See <a href="/services/sewer-camera-inspection/" class="font-bold text-[#b4232b] underline underline-offset-4">drain and sewer camera inspections</a> or <a href="/pipe-repair/" class="font-bold text-[#b4232b] underline underline-offset-4">drain and sewer pipe repair</a> for related work.</p>
              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Sewer line locating in Mason City and North Iowa</h2>
              <p class="mt-4 leading-8 text-slate-700">A-1 Drain Cleaning provides sewer line locating in Mason City and North Iowa. Call 641-530-2728 and explain why the line needs to be found and whether there is an accessible cleanout or inspection point.</p>
            </>
          ) : service.slug === 'main-drain-cleaning' ? (
            <>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Main drain problems</p>
              <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">When the main drain is blocked, the whole house can be affected</h2>
              <p class="mt-6 text-lg leading-8 text-slate-700">The main drain carries wastewater away from the home's smaller drain lines. Toilets, sinks, tubs, showers, and laundry drains connect through branch piping. When a shared drain or the main drain is restricted, wastewater may stop moving out of the house and back up through one or more fixtures.</p>
              <p class="mt-5 text-lg leading-8 text-slate-700">A-1 Drain Cleaning cleans main drain blockages in Mason City and North Iowa. The first clues are which fixtures are affected, where water appears, and what was happening when the backup started.</p>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">How wastewater moves through a house</h2>
              <p class="mt-4 leading-8 text-slate-700">Most homes have several smaller drain branches that join a larger building drain. That building drain carries wastewater toward the private building sewer, which continues from the house toward a public sewer connection or a septic system. The exact layout, cleanout locations, and pipe sizes vary by property.</p>
              <ol class="mt-5 list-decimal space-y-3 pl-6 leading-8 text-slate-700">
                <li><strong class="text-slate-950">Fixture drain:</strong> The pipe serving one sink, tub, shower, toilet, or appliance.</li>
                <li><strong class="text-slate-950">Branch drain:</strong> A smaller drain that collects wastewater from one or more fixtures and joins a larger drain.</li>
                <li><strong class="text-slate-950">Building drain / main drain:</strong> The larger drain inside the building that collects branch drainage and carries it toward the building sewer.</li>
                <li><strong class="text-slate-950">Building sewer:</strong> The private pipe that carries wastewater from the building drain toward the public sewer or septic system.</li>
              </ol>
              <p class="mt-4 leading-8 text-slate-700">People sometimes use “main drain,” “main sewer,” and “sewer line” to mean different sections of the same route. The important distinction is where the restriction is located and which part of the piping is affected. A blockage at one fixture is not the same job as a restriction in the building drain or the private sewer outside the house.</p>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Signs the main drain may be restricted</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}
              </ul>
              <p class="mt-5 leading-8 text-slate-700">One slow sink or one stopped toilet may have a clog close to that fixture. Several fixtures acting up together, or wastewater coming up somewhere other than the fixture being used, can point to a restriction farther down a shared drain. These symptoms help narrow the possibilities, but they do not prove the exact blockage location.</p>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Why several fixtures can back up at once</h2>
              <p class="mt-4 leading-8 text-slate-700">Fixtures share parts of the drain system. If a restriction develops after two or more branch drains join, wastewater from those fixtures may have trouble getting out. A toilet may flush poorly while a tub drains slowly, or using a sink may cause water to rise at a lower drain. The combination of affected fixtures can help identify which shared section needs attention.</p>
              <p class="mt-4 leading-8 text-slate-700">A toilet that bubbles or gurgles can be reacting to air movement in a restricted drain. It is a useful symptom to report, but bubbling alone does not prove that the main drain is blocked. A main-line restriction can also be present without any gurgling.</p>
              <p class="mt-4 leading-8 text-slate-700">If only one toilet is affected, the blockage may be in the toilet trap or its branch drain. If flushing causes another fixture to back up, or several fixtures are affected, the restriction may be farther down the shared system. See <a href="/services/toilet-clogs/" class="font-bold text-[#b4232b] underline underline-offset-4">toilet clogs and toilet drain problems</a> for symptoms limited to the toilet.</p>

              <section class="mt-10 border-l-4 border-[#b4232b] bg-slate-50 p-6" aria-labelledby="main-floor-drain">
                <h2 id="main-floor-drain" class="text-2xl font-black tracking-tight text-slate-950">Why sewage may come up through the basement floor drain</h2>
                <p class="mt-3 leading-7 text-slate-700">A basement floor drain is often one of the lowest openings in the home's drain system. If wastewater cannot move past a downstream restriction, it may rise through that low opening when another fixture sends water into the line. The floor drain is where the backup becomes visible; it is not automatically where the blockage is.</p>
                <p class="mt-3 leading-7 text-slate-700">If the floor drain rises when a toilet is flushed, a sink is used, or the washing machine empties, stop adding water to the system. Explain which fixture triggered the backup and whether more than one drain is affected.</p>
                <p class="mt-4 leading-7 text-slate-700">Read more about <a href="/services/basement-floor-drains/" class="font-bold text-[#b4232b] underline underline-offset-4">basement floor drain backups</a> and <a href="/services/sewer-backup-emergency/" class="font-bold text-[#b4232b] underline underline-offset-4">sewer backup emergency service</a>.</p>
              </section>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">What if the house does not have a basement?</h2>
              <p class="mt-4 leading-8 text-slate-700">A slab house or a home without a basement floor drain can have the same type of downstream drain or sewer restriction. Instead of seeing sewage come up through a basement floor drain, a homeowner may see wastewater rise in a bathtub or shower. That is a possible backup point, not proof that the tub or shower itself is clogged.</p>
              <p class="mt-4 leading-8 text-slate-700">If the toilet, tub, or shower is affected at the same time, stop using water and report the order in which the fixtures backed up. See <a href="/services/sewer-backup-into-tub-shower/" class="font-bold text-[#b4232b] underline underline-offset-4">sewer backup into a bathtub or shower</a> for more about those symptoms.</p>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">How a washing machine can expose a restriction</h2>
              <p class="mt-4 leading-8 text-slate-700">A washing machine sends a large amount of water into its drain over a short period. A partially restricted line may handle the slower flow from a sink but back up when the washer empties. Water may rise in the laundry standpipe or appear at another connected fixture, depending on the home's drain layout.</p>
              <p class="mt-4 leading-8 text-slate-700">If water comes out of the washer standpipe, the problem may be at the laundry connection, in the laundry branch, or farther downstream. If a separate basement floor drain backs up during the drain cycle, the washer may be exposing a restriction in a shared or main drain. Do not keep running wash cycles to test it. Read about <a href="/services/laundry-drains/" class="font-bold text-[#b4232b] underline underline-offset-4">laundry and washing machine drain problems</a>.</p>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Common causes of a main drain blockage</h2>
              <ul class="mt-5 list-disc space-y-3 pl-6 leading-8 text-slate-700">
                <li><strong class="text-slate-950">Grease and accumulated waste:</strong> Material can collect along the inside of a pipe and catch paper or other debris.</li>
                <li><strong class="text-slate-950">Tree roots:</strong> Roots can enter through an open joint, crack, or damaged section and narrow the path through the pipe.</li>
                <li><strong class="text-slate-950">Pipe movement or damage:</strong> A separated joint, shifted section, deformation, crack, or collapse can interfere with drainage.</li>
                <li><strong class="text-slate-950">Other material in the line:</strong> The cause depends on the property, the piping, and what is actually found when the line is accessed.</li>
              </ul>
              <p class="mt-4 leading-8 text-slate-700">Different problems can produce similar symptoms. A recurring blockage may mean material is collecting again, roots are entering through an opening, or the pipe itself needs closer inspection. Age alone does not establish the material or condition of a particular drain or sewer line.</p>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">How A-1 Drain Cleaning approaches a main drain blockage</h2>
              <p class="mt-4 leading-8 text-slate-700">We start with the symptoms and the affected fixtures: what backed up first, whether water came up through a floor drain or tub, whether the washer or toilet triggered it, and whether the problem has happened before. Those details help narrow down whether the restriction may be in a fixture branch, a shared drain, the building drain, or the private sewer leaving the house.</p>
              <p class="mt-4 leading-8 text-slate-700">The line is accessed where a suitable cleanout or other access point is available. The cleaning method depends on the blockage, the pipe material and condition, and the access. The goal is to remove the restriction and restore a path for wastewater—not to assume every main drain needs the same equipment or method.</p>
              <p class="mt-4 leading-8 text-slate-700">If the same line keeps plugging up, roots or pipe damage are suspected, or the condition of the line will affect the next step, a <a href="/services/sewer-camera-inspection/" class="font-bold text-[#b4232b] underline underline-offset-4">sewer camera inspection</a> may help show visible conditions inside the accessible pipe. A camera inspection is not automatically needed for every cleaning.</p>

              <h2 class="mt-10 text-3xl font-black tracking-tight text-slate-950">Cleaning a blockage is not the same as repairing a pipe</h2>
              <p class="mt-4 leading-8 text-slate-700">Drain cleaning can remove grease, waste, roots, or other material that is blocking the pipe. It cannot reconnect a separated joint, reshape a deformed pipe, or repair a crack or collapsed section. If the line opens but the backup returns, further inspection may be needed to find out whether the pipe has a condition that cleaning cannot correct.</p>
