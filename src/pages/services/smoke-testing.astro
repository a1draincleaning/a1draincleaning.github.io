---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const service = {
  slug: 'smoke-testing',
  title: 'Smoke Testing',
  description: 'Smoke testing can help locate openings, breaks, disconnected piping, or other places where smoke is escaping from a drain or sewer system.',
  problems: ['sewer gas odors', 'hidden drain openings', 'suspected broken or disconnected piping', 'unknown source of sewer odor'],
  signs: ['A sewer or drain odor keeps coming back', 'The source of an odor is difficult to locate', 'Smoke appears where a drain or sewer opening may be hidden', 'A drain system needs to be checked for openings or disconnected piping'],
  details: [
    'Smoke testing puts smoke into the appropriate part of a drain or sewer system so escaping smoke can help show where an opening or connection problem may be.',
    'It can be useful when there is a recurring sewer odor but no obvious source. Smoke may show up through a floor drain, cracked or disconnected piping, an abandoned drain, or another opening connected to the system.',
    'Finding smoke does not automatically mean the pipe needs to be replaced. The result helps identify where the problem is so the next repair or inspection can be based on what is actually found.',
    'A-1 Drain Cleaning can use smoke testing when the symptoms make it useful as part of finding a drain or sewer problem.'
  ]
};

const title = `${service.title} | A-1 Drain Cleaning`;
const description = `${service.description} A-1 Drain Cleaning serves Mason City and North Iowa. Call 641-530-2728.`;
---

<MainLayout title={title} description={description} path="/services/smoke-testing/" service={service}>
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] text-white">
      <div class="container py-14 sm:py-18 lg:py-24">
        <nav aria-label="Breadcrumb" class="text-sm font-bold text-slate-300"><a href="/" class="hover:text-white">Home</a><span class="mx-2" aria-hidden="true">/</span><a href="/services/" class="hover:text-white">Services</a><span class="mx-2" aria-hidden="true">/</span><span class="text-white">{service.title}</span></nav>
        <p class="mt-5 text-sm font-black uppercase tracking-[0.2em] text-red-300">Mason City • North Iowa</p>
        <h1 class="mt-3 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">{service.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">{service.description}</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL 641-530-2728</a>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="container grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start">
        <article>
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Finding the source</p>
          <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What can smoke testing find?</h2>
          <div class="mt-6 space-y-5">{service.details.map((paragraph) => (<p class="text-lg leading-8 text-slate-700">{paragraph}</p>))}</div>
          <h2 class="mt-12 text-3xl font-black tracking-tight text-slate-950">When smoke testing may help</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">{service.signs.map((sign) => (<li class="border border-slate-200 bg-slate-50 p-4 font-semibold leading-7 text-slate-700">{sign}</li>))}</ul>
        </article>

        <aside class="border border-slate-200 bg-[#1A1A68] p-7 text-white shadow-xl sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-red-300">A-1 Drain Cleaning</p>
          <h2 class="mt-2 text-3xl font-black">Have an odor or hidden drain problem?</h2>
          <p class="mt-4 leading-7 text-slate-300">Tell A-1 what you are seeing or smelling, where it happens, and whether the problem changes when drains or fixtures are used.</p>
          <a href="tel:+16415302728" class="call-button mt-6 block rounded-md bg-[#c52b34] px-5 py-4 text-center font-black text-white">CALL 641-530-2728</a>
          <a href="/services/" class="mt-5 block font-black text-white underline underline-offset-4">See all drain services</a>
        </aside>
      </div>
    </section>

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Related drain and sewer problems</p>
        <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Smoke testing can be part of a larger diagnosis.</h2>
        <div class="mt-8 flex flex-wrap gap-2">{service.problems.map((problem) => (<span class="border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700">{problem}</span>))}</div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <a href="/services/drain-repair/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Drain repair →</a>
          <a href="/services/sewer-line-cleaning/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Sewer line cleaning →</a>
          <a href="/services/main-drain-cleaning/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Main drain cleaning →</a>
          <a href="/services/roof-vent-drains/" class="border border-slate-200 bg-white p-5 font-black text-slate-950 hover:border-[#b4232b]">Drain and vent problems →</a>
        </div>
      </div>
    </section>

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container grid gap-8 lg:grid-cols-2">
        <article class="border border-slate-200 bg-white p-7 sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">What the test tells us</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">A test helps locate the problem.</h2>
          <p class="mt-4 leading-8 text-slate-700">Smoke testing is a diagnostic method. It can show where smoke is escaping, but the appropriate repair depends on what is found at the property.</p>
        </article>
        <article class="border border-slate-200 bg-white p-7 sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">North Iowa</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Mason City and surrounding communities</h2>
          <p class="mt-4 leading-8 text-slate-700">A-1 Drain Cleaning serves Mason City and North Iowa for drain and sewer problems. Availability depends on the job and schedule.</p>
          <a href="/service-area/" class="mt-5 inline-block font-black text-[#b4232b]">View service area →</a>
        </article>
      </div>
    </section>

    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
