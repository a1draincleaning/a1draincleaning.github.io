---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { services } from "../../data/services";
---
<MainLayout
  title="Drain Cleaning in Mason City, Iowa | A-1 Drain Cleaning"
  description="A-1 Drain Cleaning provides drain cleaning and sewer services for homeowners and businesses in Mason City and North Iowa. Over 25 years of experience."
  path="/"
>
  <Header />

  <main id="main">

    <section class="bg-white">
      <div class="container grid gap-10 py-16 md:grid-cols-[1.15fr_0.85fr] md:items-center md:py-24">

        <div>
          <p class="font-bold uppercase tracking-[0.18em] text-[#D9383A]">
            A-1 Drain Cleaning
          </p>

          <h1 class="brand mt-3 max-w-3xl text-5xl leading-[1.05] text-[#1A1A68] md:text-6xl lg:text-7xl">
            Drain &amp; Sewer Problems?
            <span class="block">We Clear Them.</span>
          </h1>

          <p class="mt-6 max-w-2xl text-xl leading-8 text-gray-700 md:text-2xl">
            Serving Mason City and North Iowa with direct, local drain and sewer service.
          </p>

          <p class="mt-4 max-w-2xl text-lg leading-7 text-gray-600">
            Over 25 years of experience helping homeowners and businesses with clogged
            drains, sewer backups, main drains, floor drains and more.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="tel:+16415302728"
              class="phone-pulse inline-flex items-center justify-center rounded-md bg-[#D9383A] px-7 py-4 text-lg font-bold text-white"
            >
              Call 641-530-2728
            </a>

            <a
              href="#services"
              class="inline-flex items-center justify-center rounded-md border-2 border-[#1A1A68] px-7 py-4 text-lg font-bold text-[#1A1A68]"
            >
              View Drain &amp; Sewer Services
            </a>
          </div>

          <p class="mt-5 text-sm font-semibold text-gray-600">
            Mason City • North Iowa • Residential &amp; Commercial
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 shadow-sm md:p-8">
          <p class="font-bold uppercase tracking-wide text-[#D9383A]">
            Why A-1
          </p>

          <h2 class="brand mt-2 text-3xl text-[#1A1A68]">
            Local. Experienced. Direct.
          </h2>

          <div class="mt-6 divide-y divide-gray-200">

            <div class="py-4">
              <p class="font-bold text-[#1A1A68]">
                Over 25 years of experience
              </p>
              <p class="mt-1 text-gray-600">
                Decades of hands-on drain and sewer experience.
              </p>
            </div>

            <div class="py-4">
              <p class="font-bold text-[#1A1A68]">
                Local owner-operator
              </p>
              <p class="mt-1 text-gray-600">
                Direct local service from A-1 Drain Cleaning.
              </p>
            </div>

            <div class="py-4">
              <p class="font-bold text-[#1A1A68]">
                Mason City &amp; North Iowa
              </p>
              <p class="mt-1 text-gray-600">
                Serving homes and businesses throughout the area.
              </p>
            </div>

            <div class="py-4">
              <p class="font-bold text-[#1A1A68]">
                Drain &amp; sewer focused
              </p>
              <p class="mt-1 text-gray-600">
                We focus on getting drains and sewer lines flowing again.
              </p>
            </div>

          </div>
        </div>

      </div>
    </section>

    <section class="bg-gray-50 py-16 md:py-20">
      <div class="container">

        <div class="max-w-3xl">
          <p class="font-bold uppercase tracking-[0.15em] text-[#D9383A]">
            Common Drain Problems
          </p>

          <h2 class="brand mt-2 text-4xl text-[#1A1A68] md:text-5xl">
            When your plumbing starts backing up, the problem can get serious fast.
          </h2>

          <p class="mt-5 text-lg leading-8 text-gray-700">
            A-1 Drain Cleaning helps identify and clear the drain and sewer problems
            that cause these common warning signs.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

          {[
            "Slow drains",
            "Multiple drains backing up",
            "Basement floor drain backup",
            "Washing machine overflowing",
            "Toilet bubbling or gurgling",
            "Sewer backups",
            "Tree roots in sewer lines",
            "Bad drain odors",
          ].map((problem) => (
            <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
              <p class="font-bold text-[#1A1A68]">{problem}</p>
            </div>
          ))}

        </div>
      </div>
    </section>

    <section id="services" class="bg-white py-16 md:py-20">
      <div class="container">

        <div class="max-w-3xl">
          <p class="font-bold uppercase tracking-[0.15em] text-[#D9383A]">
            Drain &amp; Sewer Services
          </p>

          <h2 class="brand mt-2 text-4xl text-[#1A1A68] md:text-5xl">
            The drain and sewer services you need.
          </h2>

          <p class="mt-5 text-lg leading-8 text-gray-700">
            From a clogged kitchen drain to a backed-up main sewer line, A-1 provides
            focused drain cleaning and sewer services for residential and commercial
            customers.
          </p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">

          {services.map((service) => (
            <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">

              <h3 class="brand text-2xl text-[#1A1A68]">
                <a href={`/services/${service.slug}/`}>
                  {service.title}
                </a>
              </h3>

              <p class="mt-3 leading-7 text-gray-700">
                {service.description}
              </p>

              <a
                class="mt-5 inline-block font-bold text-[#D9383A]"
                href={`/services/${service.slug}/`}
              >
                View service →
              </a>

            </article>
          ))}

        </div>
      </div>
    </section>

    <section class="bg-[#1A1A68] py-16 text-white md:py-20">
      <div class="container grid gap-8 md:grid-cols-[1fr_auto] md:items-center">

        <div>
          <p class="font-bold uppercase tracking-[0.15em] text-red-200">
            Local Drain Cleaning
          </p>

          <h2 class="brand mt-2 text-4xl md:text-5xl">
            Drain Cleaning in Mason City &amp; North Iowa
          </h2>

          <p class="mt-5 max-w-3xl text-lg leading-8 text-white/85">
            A-1 Drain Cleaning is based in Mason City and serves surrounding North
            Iowa communities for drain cleaning and sewer work.
          </p>
        </div>

        <a
          href="/service-area/"
          class="inline-flex items-center justify-center rounded-md bg-white px-7 py-4 font-bold text-[#1A1A68]"
        >
          View Service Area
        </a>

      </div>
    </section>

    <section class="bg-gray-50 py-16 md:py-20">
      <div class="container">

        <div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm md:p-12">

          <div class="max-w-3xl">
            <p class="font-bold uppercase tracking-[0.15em] text-[#D9383A]">
              Drain or Sewer Problem?
            </p>

            <h2 class="brand mt-2 text-4xl text-[#1A1A68] md:text-5xl">
              Water backing up where it shouldn't?
            </h2>

            <p class="mt-5 text-lg leading-8 text-gray-700">
              Tell A-1 what is happening and we can help identify where the problem
              may be and what type of drain or sewer service may be needed.
            </p>
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">

            <a
              href="tel:+16415302728"
              class="phone-pulse inline-flex items-center justify-center rounded-md bg-[#D9383A] px-7 py-4 text-lg font-bold text-white"
            >
              Call 641-530-2728
            </a>

            <a
              href="/services/"
              class="inline-flex items-center justify-center rounded-md border-2 border-[#1A1A68] px-7 py-4 font-bold text-[#1A1A68]"
            >
              See All Services
            </a>

          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</MainLayout>