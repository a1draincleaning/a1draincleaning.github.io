---
import MainLayout from '../../layouts/MainLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import {services} from '../../data/services';
---
<MainLayout title="Drain Cleaning & Sewer Services | A-1 Drain Cleaning" description="A-1 Drain Cleaning handles clogged drains, main drains, sewer lines, basement floor drains, laundry drains, toilets, roots, hydro jetting, drain repairs and more in Mason City and North Iowa." path="/services/"><Header/><main id="main"><section class="bg-white py-12 md:py-16"><div class="container"><p class="font-bold uppercase tracking-wide text-[#D9383A]">A-1 Drain Cleaning</p><h1 class="brand mt-2 text-5xl text-[#1A1A68]">Drain Cleaning & Sewer Services</h1><p class="mt-5 max-w-3xl text-xl">If a drain is slow, stopped, backing up, or causing water to come where it should not, A-1 handles the drain and sewer side of the problem for homeowners and businesses.</p><a href="tel:+16415302728" class="phone-pulse mt-7 inline-block rounded-md bg-[#D9383A] px-6 py-4 text-lg font-bold text-white">Call 641-530-2728</a></div></section><section class="py-14"><div class="container grid gap-5 md:grid-cols-2">{services.map(s=><article class="rounded-lg border border-gray-200 bg-white p-6"><h2 class="brand text-2xl text-[#1A1A68]"><a href={`/services/${s.slug}/`}>{s.title}</a></h2><p class="mt-3 text-gray-700">{s.description}</p><p class="mt-4 text-sm text-gray-600"><strong>Common reasons people call:</strong> {s.problems.join(', ')}.</p><a class="mt-4 inline-block font-bold text-[#D9383A]" href={`/services/${s.slug}/`}>Read more →</a></article>)}</div></section></main><Footer/></MainLayout>
