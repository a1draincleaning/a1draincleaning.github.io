---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services } from '../../data/services';

const featured = services.filter(({ slug }) => ['main-drain-cleaning','sewer-line-cleaning','tree-roots-in-sewer-line','basement-floor-drains','kitchen-bathroom-drains','toilet-clogs','laundry-drains','sewer-backup-emergency','hydro-jetting'].includes(slug));
const additional = services.filter(({ slug }) => !featured.some((service) => service.slug === slug));
---

<MainLayout title="Drain Cleaning & Sewer Services | A-1 Drain Cleaning" description="A-1 Drain Cleaning clears clogged drains, main drains, sewer lines, basement floor drains, laundry drains, toilets, roots and other drain problems in Mason City and North Iowa." path="/services/">
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] py-14 text-white sm:py-20"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">A-1 Drain Cleaning • Mason City, Iowa</p><h1 class="mt-4 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">Drain Cleaning & Sewer Services</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">Slow drain, stopped drain, basement floor drain backing up, or several fixtures backing up together? A-1 Drain Cleaning clears residential and commercial drain and sewer lines in Mason City and North Iowa.</p><a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL</a><p class="mt-5 text-sm font-semibold text-slate-300">Drain cleaning • Sewer line clearing • Root cutting • Cameras • Hydro-jetting • Smoke testing</p></div></section>
    <section class="bg-slate-100 py-16 sm:py-20"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Drain & sewer work</p><h2 class="mt-2 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What A-1 Drain Cleaning clears</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">Most drain problems start with a restriction. The location of the backup and the number of fixtures affected help determine where to work and which equipment fits the problem.</p><div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{featured.map((service, index) => (<article class="group relative flex h-full flex-col border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"><span class="text-xs font-black uppercase tracking-[0.18em] text-slate-400">0{index + 1}</span><h3 class="mt-3 text-2xl font-black tracking-tight text-slate-950"><a href={`/services/${service.slug}/`} class="after:absolute after:inset-0">{service.title}</a></h3><p class="mt-3 flex-1 leading-7 text-slate-600">{service.description}</p><span class="relative mt-5 font-black text-[#b4232b]">Read service details →</span></article>))}</div></div></section>
    <section class="bg-white py-16 sm:py-20"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">More drain work</p><h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Other services</h2><div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><a href="/services/smoke-testing/" class="border border-slate-200 bg-slate-50 p-5 font-black text-slate-950 hover:border-[#b4232b] hover:bg-white">Smoke Testing</a><a href="/services/sewer-backup-into-tub-shower/" class="border border-slate-200 bg-slate-50 p-5 font-black text-slate-950 hover:border-[#b4232b] hover:bg-white">Sewer Backup into Bathtub or Shower</a>{additional.map((service) => (<a href={`/services/${service.slug}/`} class="border border-slate-200 bg-slate-50 p-5 font-black text-slate-950 hover:border-[#b4232b] hover:bg-white">{service.title}</a>))}</div></div></section>
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
