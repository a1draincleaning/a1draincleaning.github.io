---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services } from '../../data/services';
import { featuredServiceSlugs } from '../../data/serviceGroups';

const featured = services.filter(({ slug }) => featuredServiceSlugs.includes(slug as typeof featuredServiceSlugs[number]));
const additional = services.filter(({ slug }) => !featured.some((service) => service.slug === slug));
const symptomGuides = [
  { title: 'Sewage or water coming up through a basement floor drain', explanation: 'The floor drain may be where a blockage farther down the shared drain or main sewer line becomes visible. Stop using water while it is backing up.', service: 'basement-floor-drains', link: 'Floor drain backup help' },
  { title: 'Bathtub or shower backing up in a home without a basement', explanation: 'A blocked main drain or sewer line can force wastewater into a low fixture such as a tub or shower. Avoid flushing or running water until the backup is addressed.', service: 'sewer-backup-into-tub-shower', link: 'Bathtub and shower sewer backups' },
  { title: 'Several fixtures are slow or backing up together', explanation: 'When sinks, toilets, tubs, or floor drains are affected at the same time, the restriction may be in a shared branch or the main drain rather than one fixture.', service: 'main-drain-cleaning', link: 'Main drain cleaning' },
  { title: 'Washing machine drains and water spills onto the floor', explanation: 'The washer releases water quickly, which can expose a restriction in the laundry drain or a shared line farther downstream.', service: 'washing-machine-basement-flooding', link: 'Washing machine drain backups' },
  { title: 'One sink, tub, or shower drains slowly', explanation: 'A single slow fixture often points to buildup close to that drain. If several fixtures are affected, the problem may be farther down the system.', service: 'kitchen-bathroom-drains', link: 'Kitchen and bathroom drains' },
  { title: 'The same sewer line keeps plugging up', explanation: 'Repeated blockages can be caused by roots, buildup, or a damaged pipe. Clearing the line opens the path, but recurring problems may need further investigation.', service: 'tree-roots-in-sewer-line', link: 'Tree roots in sewer lines' }
];
---

<MainLayout title="Drain Cleaning & Sewer Services | A-1 Drain Cleaning" description="A-1 Drain Cleaning clears clogged drains, main drains, sewer lines, basement floor drains, laundry drains, toilets, roots and other drain problems in Mason City and North Iowa." path="/services/">
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] py-14 text-white sm:py-20"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">A-1 Drain Cleaning • Mason City, Iowa</p><h1 class="mt-4 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">Drain Cleaning & Sewer Services</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">Slow drain, stopped drain, basement floor drain backing up, or several fixtures backing up together? A-1 Drain Cleaning clears residential and commercial drain and sewer lines in Mason City and North Iowa.</p><a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL</a><p class="mt-5 text-sm font-semibold text-slate-300">Drain cleaning • Sewer line clearing • Root cutting • Cameras • Hydro-jetting • Smoke testing</p></div></section>
    <section class="bg-white py-14 sm:py-16"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Find the right service</p><h2 class="mt-2 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">What is your drain doing?</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">The symptoms can help narrow down where a blockage may be. These are clues, not a diagnosis—the same symptom can have different causes.</p><div class="mt-8 grid gap-4 md:grid-cols-2">{symptomGuides.map((item) => (<article class="border border-slate-200 bg-slate-50 p-6"><h3 class="text-xl font-black leading-snug text-slate-950">{item.title}</h3><p class="mt-3 leading-7 text-slate-700">{item.explanation}</p><a href={`/services/${item.service}/`} class="mt-4 inline-block font-black text-[#b4232b] underline decoration-2 underline-offset-4 hover:text-[#8f1b22]">{item.link} →</a></article>))}</div></div></section>
    <section class="bg-slate-100 py-16 sm:py-20"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Drain & sewer work</p><h2 class="mt-2 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Drain cleaning and sewer services</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">Choose a service below for the full details on symptoms, likely causes, and the work involved. The service pages carry the detailed explanations so this page can stay focused on helping you choose where to start.</p><div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{featured.map((service, index) => (<article class="group relative flex h-full flex-col border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"><span class="text-xs font-black uppercase tracking-[0.18em] text-slate-400">{String(index + 1).padStart(2, '0')}</span><h3 class="mt-3 flex-1 text-2xl font-black tracking-tight text-slate-950"><a href={`/services/${service.slug}/`} class="hover:text-[#b4232b] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b4232b]">{service.title}</a></h3><a href={`/services/${service.slug}/`} class="relative z-10 mt-5 inline-block font-black text-[#b4232b] underline decoration-2 underline-offset-4 hover:text-[#8f1b22] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b4232b]">Read service details →</a></article>))}</div></div></section>
    <section class="bg-white py-16 sm:py-20"><div class="container"><p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">More drain work</p><h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Additional services</h2><div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{additional.map((service) => (<a href={`/services/${service.slug}/`} class="border border-slate-200 bg-slate-50 p-5 font-black text-slate-950 hover:border-[#b4232b] hover:bg-white">{service.title}</a>))}<a href="/services/smoke-testing/" class="border border-slate-200 bg-slate-50 p-5 font-black text-slate-950 hover:border-[#b4232b] hover:bg-white">Smoke Testing</a></div></div></section>
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
