        { name: "Ventura", coords: [43.1219, -93.4694] },
        { name: "Charles City", coords: [43.0664, -92.6724] },
        { name: "Colwell", coords: [43.16, -92.59] },
        { name: "Floyd", coords: [43.1264, -92.736] },
        { name: "Marble Rock", coords: [42.97, -92.87] },
        { name: "Nashua", coords: [42.95, -92.54] },
        { name: "Rockford", coords: [43.052, -92.948] },
        { name: "Rudd", coords: [43.1344, -92.9074] },
        { name: "Alexander", coords: [42.8105, -93.5502] },
        { name: "Coulter", coords: [42.737, -93.37] },
        { name: "Dows", coords: [42.6564, -93.5027] },
