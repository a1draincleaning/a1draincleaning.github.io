        { name: "New Hampton", coords: [43.0563379, -92.3152536] },
        { name: "North Washington", coords: [43.1171314, -92.41511] },
      ];

      const mapElement = document.getElementById('a1-service-area-map');
      if (mapElement) {
        const map = L.map(mapElement, { scrollWheelZoom: false, dragging: !L.Browser.touch }).setView([43.16, -93.48], 8);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const markers = [];
        serviceTowns.forEach((town) => {
          const marker = L.marker(town.coords).addTo(map);
          marker.bindPopup('<strong>' + town.name + '</strong><br>A-1 Drain Cleaning service town');
          marker.bindTooltip(town.name, { direction: 'top', offset: [0, -24] });
          markers.push(marker);
        });
        if (markers.length) {
          const group = L.featureGroup(markers);
          map.fitBounds(group.getBounds().pad(0.12), { maxZoom: 8 });
        }
      }
    </script>

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container grid gap-8 lg:grid-cols-2">
        <article class="bg-white p-7 sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Common calls</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">What A-1 Drain Cleaning comes out for</h2>
          <p class="mt-4 leading-8 text-slate-700">Clogged sinks, showers, tubs and toilets. Basement floor drains. Washing machine drains. Main drain and sewer line blockages. Sewer backups. Tree roots. Drain repairs. Storm sewers. Smoke testing sewers.</p>
        </article>
        <article class="bg-[#1A1A68] p-7 text-white sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Not sure what you need?</p>
          <h2 class="mt-2 text-3xl font-black">Tell us what the water is doing.</h2>
          <p class="mt-4 leading-8 text-slate-300">You do not need to know the name of the problem before calling. Tell A-1 Drain Cleaning which fixture is affected and whether other drains back up.</p>
          <a href="tel:+16415302728" class="call-button mt-6 inline-block rounded-md bg-[#c52b34] px-6 py-4 font-black text-white">CALL</a>
        </article>
      </div>
    </section>

    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
