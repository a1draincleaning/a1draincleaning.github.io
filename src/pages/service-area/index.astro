---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { uniqueServiceAreaCities } from '../../data/serviceAreaCities';
import { builtServiceAreaCitySlugs } from '../../data/serviceAreaCityPages';
---

<MainLayout
  title="Drain Cleaning Service Area | A-1 Drain Cleaning"
  description="Find the North Iowa communities served by A-1 Drain Cleaning for drain cleaning, main drain blockages, floor drain backups and sewer-line problems."
  path="/service-area/"
>
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] py-14 text-white sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Areas We Serve</p>
        <h1 class="mt-4 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">Drain Cleaning in Mason City and North Iowa</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">A-1 Drain Cleaning is based at 206 29th St SW in Mason City and travels for drain cleaning and sewer work in surrounding North Iowa communities.</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-flex min-h-12 items-center rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL 641-530-2728</a>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20" aria-labelledby="communities-heading">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Local coverage</p>
        <h2 id="communities-heading" class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Communities A-1 Drain Cleaning serves</h2>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">Mason City is the home base. The directory below shows the current North Iowa service-area plan. Only communities with researched local content are linked to dedicated city pages.</p>

        <div class="mt-7 grid gap-4 sm:grid-cols-3" aria-label="Primary service-area communities">
          {['Mason City', 'Clear Lake', 'Forest City', 'Charles City', 'Nora Springs', 'Garner'].map((name) => {
            const city = uniqueServiceAreaCities.find((item) => item.name === name);
            return city ? (
              <a href={`/service-area/${city.slug}/`} class="flex min-h-12 items-center justify-between border border-[#1A1A68] bg-[#1A1A68] px-5 py-4 font-black text-white hover:bg-[#141452]">
                <span>{city.name}, Iowa</span><span aria-hidden="true">→</span>
              </a>
            ) : null;
          })}
        </div>

        <div class="mt-10 space-y-8">
          {Array.from(new Set(uniqueServiceAreaCities.flatMap((city) => city.counties)))
            .sort((a, b) => a.localeCompare(b))
            .map((county) => {
              const countyCities = uniqueServiceAreaCities
                .filter((city) => city.counties.includes(county))
                .sort((a, b) => a.name.localeCompare(b.name));
              return (
                <section aria-labelledby={`county-${county.toLowerCase().replaceAll(' ', '-')}`}>
                  <h3 id={`county-${county.toLowerCase().replaceAll(' ', '-')}`} class="border-b-2 border-[#1A1A68] pb-2 text-2xl font-black text-slate-950">{county} County</h3>
                  <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
                    {countyCities.map((city) => (
                      <li>
                        {builtServiceAreaCitySlugs.has(city.slug) ? (
                          <a href={`/service-area/${city.slug}/`} class="flex min-h-12 items-center border border-[#1A1A68] bg-[#1A1A68] px-3 py-3 text-sm font-bold text-white hover:bg-[#141452]">{city.name}</a>
                        ) : (
                          <span class="flex min-h-12 items-center border border-slate-200 bg-slate-100 px-3 py-3 text-sm font-bold text-slate-600">{city.name}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}
        </div>
      </div>
    </section>

    <section class="bg-slate-100 py-14 sm:py-18" aria-labelledby="service-area-details-heading">
      <div class="container grid gap-8 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">How the coverage works</p>
          <h2 id="service-area-details-heading" class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Mason City is the home base</h2>
          <p class="mt-4 text-lg leading-8 text-slate-700">A-1 Drain Cleaning is based in Mason City and serves nearby North Iowa communities. Service availability can depend on the job, timing, and exact address, so call before assuming a town or property is covered.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <article class="border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-black text-slate-950">Drain backups</h3>
            <p class="mt-2 leading-7 text-slate-700">Tell us whether one fixture is slow or several fixtures are backing up together. That distinction helps narrow down where the restriction may be.</p>
          </article>
          <article class="border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-black text-slate-950">Sewer problems</h3>
            <p class="mt-2 leading-7 text-slate-700">If wastewater is coming up through a floor drain, tub, shower, or toilet, stop adding water and explain exactly where the backup appears.</p>
          </article>
          <article class="border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-black text-slate-950">24/7 service</h3>
            <p class="mt-2 leading-7 text-slate-700">A-1 Drain Cleaning provides 24/7 drain and sewer service. Call 641-530-2728 for current availability.</p>
          </article>
          <article class="border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-black text-slate-950">Not sure about your town?</h3>
            <p class="mt-2 leading-7 text-slate-700">The list is a service-area directory, not a guarantee for every address. Call and give us the address before making assumptions.</p>
          </article>
        </div>
      </div>
    </section>

    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
