        { name: "Nora Springs", coords: [43.1427, -93.0063] },
        { name: "Plymouth", coords: [43.2425, -93.1005] },
        { name: "Rock Falls", coords: [43.2019, -93.1121] },
        { name: "Rockwell", coords: [42.9919, -93.188] },
        { name: "Swaledale", coords: [42.9086, -93.3019] },
