---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { uniqueServiceAreaCities } from '../../data/serviceAreaCities';
import { builtServiceAreaCitySlugs } from '../../data/serviceAreaCityPages';
---

<MainLayout
  title="Drain Cleaning in Mason City and North Iowa | A-1 Drain Cleaning"
  description="Find the North Iowa communities served by A-1 Drain Cleaning for drain cleaning, main drain blockages, floor drain backups and sewer-line problems."
  path="/service-area/"
>
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] py-14 text-white sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Areas We Serve</p>
        <h1 class="mt-4 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">Drain Cleaning in Mason City and North Iowa</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">A-1 Drain Cleaning is based in Mason City and travels for drain cleaning and sewer work in surrounding North Iowa communities.</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL</a>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Areas We Serve</p>
        <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Communities A-1 Drain Cleaning serves</h2>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">Towns with a dedicated city page are clickable. Other towns are still listed as service areas, but we do not present them as dedicated local landing pages until their page is built.</p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-slate-700" aria-label="Service area link key">
          <span><span class="mr-2 inline-block h-3 w-3 rounded-sm bg-[#1A1A68]" aria-hidden="true"></span>Dedicated city page</span>
          <span><span class="mr-2 inline-block h-3 w-3 rounded-sm bg-slate-300" aria-hidden="true"></span>Service area only</span>
        </div>
        {[
          'Cerro Gordo',
          'Floyd',
          'Chickasaw',
          'Franklin',
          'Hancock',
          'Mitchell',
          'Winnebago',
          'Worth',
          'Wright',
          'Butler'
        ].map((county) => {
          const countyCities = uniqueServiceAreaCities
            .filter((city) => city.counties.includes(county))
            .sort((a, b) => a.name.localeCompare(b.name));
          return (
            <section class="mt-8 first:mt-8" aria-labelledby={`county-${county.toLowerCase().replaceAll(' ', '-')}`}>
              <h3 id={`county-${county.toLowerCase().replaceAll(' ', '-')}`} class="border-b-2 border-[#1A1A68] pb-2 text-2xl font-black text-slate-950">{county} County</h3>
              <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
                {countyCities.map((city) => (
                  builtServiceAreaCitySlugs.has(city.slug) ? (
                    <a href={`/service-area/${city.slug}/`} class="border border-[#1A1A68] bg-[#1A1A68] px-3 py-3 text-sm font-bold text-white hover:bg-[#141452]" style="color: #ffffff !important;">{city.name}</a>
                  ) : (
                    <span class="border border-slate-200 bg-slate-100 px-3 py-3 text-sm font-bold text-slate-600" aria-label={`${city.name} service area; dedicated city page not built yet`}>{city.name}</span>
                  )
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </section>

    <section class="bg-slate-100 py-12 sm:py-16" aria-labelledby="service-area-map-heading">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">A-1 Drain Cleaning service towns</p>
        <h2 id="service-area-map-heading" class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Map of A-1 Drain Cleaning's service area</h2>
        <p class="mt-4 max-w-3xl leading-7 text-slate-700">The pins mark towns listed in A-1 Drain Cleaning's current service-area list. Tap a pin to see the town name. This is a town map, not a list of other businesses or a guaranteed boundary for every job.</p>
        <div class="mt-7 overflow-hidden rounded-lg border border-slate-300 bg-white shadow-sm">
          <div id="a1-service-area-map" class="h-[420px] w-full sm:h-[520px]" role="application" aria-label="Interactive map with pins for A-1 Drain Cleaning service towns"></div>
        </div>
        <p class="mt-3 text-sm text-slate-600">Map tiles © OpenStreetMap contributors. Call A-1 Drain Cleaning to confirm service for your address.</p>
      </div>
    </section>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    <script is:inline type="module">
      import L from 'https://esm.sh/leaflet@1.9.4';

      const serviceTowns = [
