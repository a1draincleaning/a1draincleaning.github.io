---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { serviceAreas } from '../../data/serviceAreas';
---

<MainLayout
  title="Drain Cleaning Service Area | Mason City & North Iowa | A-1 Drain Cleaning"
  description="A-1 Drain Cleaning is based in Mason City, Iowa and serves Mason City and surrounding North Iowa communities for drain cleaning and sewer work."
  path="/service-area/"
>
  <Header />
  <main id="main">
    <section class="bg-[#1A1A68] py-14 text-white sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Where A-1 works</p>
        <h1 class="mt-4 max-w-4xl text-5xl font-black leading-[.98] tracking-tight sm:text-6xl lg:text-7xl">Drain Cleaning in Mason City and North Iowa</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">A-1 Drain Cleaning is based in Mason City and travels for drain cleaning and sewer work in surrounding North Iowa communities.</p>
        <a href="tel:+16415302728" class="call-button mt-8 inline-block rounded-md bg-[#c52b34] px-7 py-4 text-center text-lg font-black text-white shadow-lg hover:bg-[#a82129]">CALL 641-530-2728</a>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="container">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">North Iowa service area</p>
        <h2 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Communities A-1 serves</h2>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">The communities below are in the current service area. Availability can depend on the job and schedule.</p>
        <div class="mt-8 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
          {serviceAreas.map((city) => (
            <a href="/service-area/" class="border border-slate-200 bg-slate-50 px-3 py-3 text-sm font-bold text-slate-950 hover:border-[#b4232b] hover:bg-white">{city}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-100 py-16 sm:py-20">
      <div class="container grid gap-8 lg:grid-cols-2">
        <article class="bg-white p-7 sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#b4232b]">Common calls</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">What A-1 comes out for</h2>
          <p class="mt-4 leading-8 text-slate-700">Clogged sinks, showers, tubs and toilets. Basement floor drains. Washing machine drains. Main drain and sewer line blockages. Sewer backups. Tree roots. Drain repairs and hydro-jetting when appropriate.</p>
        </article>
        <article class="bg-[#1A1A68] p-7 text-white sm:p-8">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-red-300">Not sure what you need?</p>
          <h2 class="mt-2 text-3xl font-black">Tell us what the water is doing.</h2>
          <p class="mt-4 leading-8 text-slate-300">You do not need to know the name of the problem before calling. Tell A-1 which fixture is affected and whether other drains back up.</p>
          <a href="tel:+16415302728" class="call-button mt-6 inline-block rounded-md bg-[#c52b34] px-6 py-4 font-black text-white">CALL 641-530-2728</a>
        </article>
      </div>
    </section>

    <ContactCTA />
  </main>
  <Footer />
</MainLayout>
